# Environment Variables untuk HERO MARKET Backend

# Server Configuration
PORT=3000
NODE_ENV=production

# Session Secret (WAJIB di-set! Gunakan string random panjang yang aman)
# Generate: node -e "require('crypto').randomBytes(64).toString('hex')|cat"
SESSION_SECRET=GANTI_DENGAN_STRING_RANDOM_PANJANG_YANG_AMAN

# PakKasir API (Isi setelah mendaftar di pakasir.com)
PAKASIR_API_KEY=your_pakasir_api_key_here
PAKASIR_PROJECT=your_project_name_here
PAKASIR_MODE=production

# GensPay QRIS (genspay.my.id)
GENSPAY_BASE_URL=https://genspay.my.id/api/v1
GENSPAY_API_KEY=your_genspay_api_key_here
# Fallback dipakai untuk membangun callback_url GensPay HANYA kalau server
# tidak punya `req` (mis. dipanggil dari luar konteks route) -- normalnya
# callback_url dibangun otomatis dari domain request yang sedang aktif
# (lihat getAppBaseUrl() di server.js), jadi variabel ini biasanya TIDAK
# perlu diisi. Tanpa callback_url yang benar sampai ke GensPay,
# /webhook/genspay tidak akan pernah dipanggil dan transaksi QRIS yang
# sudah dibayar tidak akan otomatis selesai (perlu admin verifikasi manual).
APP_URL=

# Dipakai oleh GET /debug/genspay-resettle -- endpoint self-test yang
# mensimulasikan webhook GensPay beneran (payload valid + signature
# valid) untuk order_id yang macet Pending, memanggil /webhook/genspay
# yang asli. Isi string rahasia bebas untuk mengaktifkan; tanpa ini
# endpoint selalu 503 (aman by default). Hapus/rotate lagi setelah
# selesai debug.
GENSPAY_DEBUG_SECRET=

# Dipakai oleh GET /cron/reconcile-genspay (dijadwalkan via vercel.json)
# -- sweep berkala yang cek ulang transaksi 'pending' langsung ke GensPay,
# sebagai jaring pengaman kalau webhook belum/salah terdaftar di dashboard
# GensPay ATAU pembeli menutup tab sebelum polling browser sempat
# mendeteksi pembayaran selesai. Isi string rahasia bebas -- Vercel Cron
# otomatis mengirim header `Authorization: Bearer <CRON_SECRET>` ini di
# setiap pemanggilan terjadwal, jadi TIDAK perlu ditaruh di URL cron itu
# sendiri. Wajib diisi atau endpoint ini selalu menolak (503).
# ⚠️ Vercel Cron Jobs setiap 5 menit butuh plan Pro ke atas -- di Hobby
# plan, jadwal cron dibatasi maksimal 1x/hari (ubah schedule di
# vercel.json ke misal "0 */6 * * *" atau sejenisnya kalau masih Hobby).
CRON_SECRET=

# PayPal (Pembayaran luar negeri / mata uang asing)
# CARA UTAMA: atur lewat Panel Admin -> Settings -> PayPal (lebih mudah, tidak perlu redeploy)
# Variabel di bawah ini hanya FALLBACK jika belum diisi di panel admin
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
# 'sandbox' untuk testing (uang palsu), 'live' untuk produksi (uang asli)
PAYPAL_MODE=sandbox
# Kurs manual IDR -> USD untuk konversi harga (opsional, kalau tidak diisi pakai default di kode)
PAYPAL_USD_RATE=16000

# Binance Pay (Crypto, pembayaran luar negeri) — daftar & buat API Key/Secret
# Key di Binance Merchant Admin Portal (merchant.binance.com)
# CARA UTAMA: atur lewat Panel Admin -> Settings -> Binance Pay (lebih mudah, tidak perlu redeploy)
# Variabel di bawah ini hanya FALLBACK jika belum diisi di panel admin
BINANCEPAY_API_KEY=your_binancepay_api_key_here
BINANCEPAY_SECRET_KEY=your_binancepay_secret_key_here
# Mata uang order -- default IDR, tapi cek dulu currency yang di-approve di
# akun merchant kamu (kalau IDR ditolak Binance, ganti ke USDT)
BINANCEPAY_CURRENCY=IDR

# Coinbase Commerce (Crypto, pembayaran luar negeri) — daftar & buat API Key
# di commerce.coinbase.com, lalu ambil Webhook Shared Secret di
# Settings > Notifications setelah daftar Webhook URL /webhook/coinbase
# CARA UTAMA: atur lewat Panel Admin -> Settings -> Coinbase Commerce (lebih mudah, tidak perlu redeploy)
# Variabel di bawah ini hanya FALLBACK jika belum diisi di panel admin
COINBASE_COMMERCE_API_KEY=your_coinbase_commerce_api_key_here
COINBASE_COMMERCE_WEBHOOK_SECRET=your_coinbase_commerce_webhook_shared_secret_here

# Admin Credentials (Default, akan di-hash otomatis)
ADMIN_USERNAME=heromarket
ADMIN_PASSWORD=sumberjo1903

# Reseller API / Auto Restock (vipibmstore.com) — dipakai untuk produk
# dengan Mode Stok = Auto (generate key otomatis per transaksi, tidak perlu
# stok manual). CARA UTAMA: atur lewat Panel Admin -> Reseller API (lebih
# mudah, tidak perlu redeploy). Variabel di bawah ini FALLBACK kalau belum
# diisi di panel admin -- TAPI kalau field di panel admin PERNAH terisi
# (walau salah/lama), nilai di database akan MENIMPA env var ini. Kalau
# Auto Restock tidak jalan padahal env var sudah diisi, cek
# GET /admin/reseller-api/debug untuk lihat sumber kredensial mana yang
# aktif, atau kosongkan field API Key & Secret di panel admin lalu Simpan.
RESELLER_API_KEY=your_reseller_api_key_here
RESELLER_API_SECRET=your_reseller_api_secret_here
RESELLER_API_BASE_URL=https://vipibmstore.com/api/reseller

# Contact Information
WHATSAPP_NUMBER=6281235690535
TELEGRAM_USERNAME=HEROO3STORE
SUPPORT_EMAIL=support@heromarket.com

# Site Configuration
SITE_NAME=HERO MARKET
MARQUEE_TEXT=LAYANAN GAME MOD MENU PREMIUM - PROSES CEPAT & AMAN

# ─── DATABASE: SUPABASE (Gantikan JSONBin) ───────────────────
# 1. Daftar gratis di https://supabase.com
# 2. Buat project baru (pilih region Singapore)
# 3. Buka Settings → API → copy URL dan anon key
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here
# Optional — untuk auto-create tabel jika belum ada
# Password database waktu bikin project di supabase.com
SUPABASE_DB_PASSWORD=your_database_password_here
