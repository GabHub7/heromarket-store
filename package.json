{
  "name": "hero-market-backend",
  "version": "1.0.0",
  "description": "Backend Node.js untuk HERO MARKET - Layanan Game Mod Menu Premium",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build:css": "tailwindcss -i ./src/input.css -o ./public/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./public/css/tailwind.css --watch",
    "build": "npm run build:css",
    "vercel-build": "npm run build:css"
  },
  "keywords": [
    "game",
    "mod",
    "menu",
    "store",
    "ecommerce"
  ],
  "author": "HERO MARKET",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "bcryptjs": "^2.4.3",
    "cookie-session": "^2.1.1",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-ejs-layouts": "^2.5.1",
    "express-session": "^1.17.3",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.21.0",
    "tailwindcss": "^3.4.19",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
