<%
const pageTitle = 'Keranjang';
%>

<div class="min-h-screen px-4 py-24 max-w-lg mx-auto">

    <div class="flex items-center gap-3 mb-6">
        <div class="w-10 h-10 rounded-xl flex items-center justify-center" style="background:rgba(99,102,241,.15);border:1px solid rgba(99,102,241,.3);">
            <iconify-icon icon="mdi:cart-variant" class="text-indigo-400 text-xl"></iconify-icon>
        </div>
        <div>
            <h1 class="text-lg font-bold text-white">Keranjang Belanja</h1>
            <p class="text-xs text-zinc-500">Item yang ingin kamu beli</p>
        </div>
    </div>

    <!-- Cart items will be rendered here -->
    <div id="cart-page-items" class="space-y-3 mb-6"></div>

    <!-- Empty state -->
    <div id="cart-page-empty" class="hidden text-center py-16">
        <iconify-icon icon="mdi:cart-off" class="text-6xl text-zinc-700 mb-4 block"></iconify-icon>
        <p class="text-zinc-500 text-sm font-medium">Keranjangmu masih kosong</p>
        <p class="text-zinc-600 text-xs mt-1 mb-6">Tambahkan produk dari halaman utama</p>
        <a href="/" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-bold text-white transition-all hover:scale-105"
           style="background:linear-gradient(135deg,#7c3aed,#6366f1);box-shadow:0 4px 14px rgba(99,102,241,.4);">
            <iconify-icon icon="mdi:shopping" class="text-base"></iconify-icon> Lihat Produk
        </a>
    </div>

    <!-- Summary & checkout -->
    <div id="cart-page-summary" class="hidden">
        <div class="rounded-xl p-4 mb-4" style="background:rgba(99,102,241,.07);border:1px solid rgba(99,102,241,.2);">
            <div class="flex items-center justify-between text-sm mb-2">
                <span class="text-zinc-400">Subtotal</span>
                <span class="font-bold text-white" id="cart-page-subtotal">Rp 0</span>
            </div>
            <div class="flex items-center justify-between text-xs text-zinc-600 mb-3">
                <span>Item</span>
                <span id="cart-page-count">0 item</span>
            </div>
            <div class="h-px bg-white/5 mb-3"></div>
            <div class="flex items-center justify-between">
                <span class="text-sm font-bold text-white">Total</span>
                <span class="text-lg font-black text-indigo-400" id="cart-page-total">Rp 0</span>
            </div>
        </div>
        <a id="cart-checkout-btn" href="/" class="w-full py-3 rounded-xl text-sm font-bold text-white flex items-center justify-center gap-2 transition-all hover:scale-[1.02] active:scale-[.98]"
           style="background:linear-gradient(135deg,#7c3aed,#6366f1);box-shadow:0 4px 18px rgba(99,102,241,.45);">
            <iconify-icon icon="mdi:lightning-bolt" class="text-base"></iconify-icon> Lanjut Beli
        </a>
        <button onclick="clearAllCart()" class="w-full mt-2 py-2.5 rounded-xl text-xs font-semibold text-zinc-500 hover:text-red-400 transition-colors flex items-center justify-center gap-1.5">
            <iconify-icon icon="mdi:trash-can-outline" class="text-sm"></iconify-icon> Kosongkan Keranjang
        </button>
    </div>
</div>

<script>
(function() {
    const cart = JSON.parse(localStorage.getItem('hm_cart') || '[]');
    const itemsEl  = document.getElementById('cart-page-items');
    const emptyEl  = document.getElementById('cart-page-empty');
    const sumEl    = document.getElementById('cart-page-summary');

    function fmt(n) { return 'Rp ' + Number(n).toLocaleString('id-ID'); }

    function removeItem(i) {
        const cart = JSON.parse(localStorage.getItem('hm_cart') || '[]');
        cart.splice(i, 1);
        localStorage.setItem('hm_cart', JSON.stringify(cart));
        // update badge di navbar
        const b = document.getElementById('cart-badge');
        if (b) { if (cart.length > 0) { b.textContent = cart.length; b.classList.remove('hidden'); } else b.classList.add('hidden'); }
        renderCart(cart);
    }

    function clearAllCart() {
        localStorage.setItem('hm_cart', '[]');
        const b = document.getElementById('cart-badge');
        if (b) b.classList.add('hidden');
        renderCart([]);
    }
    window.clearAllCart = clearAllCart;

    function renderCart(cart) {
        if (!cart.length) {
            itemsEl.innerHTML = '';
            emptyEl.classList.remove('hidden');
            sumEl.classList.add('hidden');
            return;
        }
        emptyEl.classList.add('hidden');
        sumEl.classList.remove('hidden');

        itemsEl.innerHTML = cart.map((item, i) => `
            <div class="flex items-center gap-3 p-3 rounded-xl" style="background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.07);">
                <div class="w-12 h-12 rounded-xl overflow-hidden flex-shrink-0 flex items-center justify-center" style="background:rgba(99,102,241,.1);border:1px solid rgba(99,102,241,.15);">
                    ${item.image ? `<img src="${item.image}" class="w-full h-full object-cover">` : `<iconify-icon icon="mdi:gamepad-variant" class="text-xl text-indigo-400"></iconify-icon>`}
                </div>
                <div class="flex-1 min-w-0">
                    <div class="text-xs font-bold text-white truncate">${item.name}</div>
                    <div class="text-[11px] text-zinc-500 mt-0.5">${item.duration || ''}</div>
                    <div class="text-xs font-black text-indigo-400 mt-0.5">${fmt(item.price)}</div>
                </div>
                <button onclick="removeItem(${i})"
                    class="w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0 transition-colors hover:bg-red-500/20"
                    style="border:1px solid rgba(239,68,68,.2);color:#f87171;">
                    <iconify-icon icon="mdi:trash-can-outline" class="text-sm"></iconify-icon>
                </button>
            </div>
        `).join('');

        // Re-attach remove handlers
        document.querySelectorAll('#cart-page-items button').forEach((btn, i) => {
            btn.onclick = () => removeItem(i);
        });

        const total = cart.reduce((s, it) => s + Number(it.price), 0);
        document.getElementById('cart-page-subtotal').textContent = fmt(total);
        document.getElementById('cart-page-total').textContent = fmt(total);
        document.getElementById('cart-page-count').textContent = cart.length + ' item';

        // Checkout button — arahkan ke produk pertama
        const btn = document.getElementById('cart-checkout-btn');
        if (cart[0]?.productId) btn.href = '/buy/' + cart[0].productId;
    }

    renderCart(cart);
})();
</script>
