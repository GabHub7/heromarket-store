<%
const pageTitle = order ? ('Pesanan ' + order.code) : 'Pesanan Tidak Ditemukan';
%>

<nav id="navbar" class="fixed top-0 left-0 right-0 z-50 bg-[#08081a]/95 backdrop-blur-md border-b border-indigo-500/10">
    <div class="max-w-3xl mx-auto px-4">
        <div class="flex items-center justify-between h-14">
            <a href="/" class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center">
                    <iconify-icon icon="mdi:receipt-text-check" class="text-white text-sm"></iconify-icon>
                </div>
                <span class="font-orbitron text-sm font-bold shimmer-text"><%= settings?.siteName || 'HERO MARKET' %></span>
            </a>
        </div>
    </div>
</nav>

<div class="min-h-screen pt-16 pb-20 px-4">
<div class="max-w-md mx-auto mt-8">

<% if (rateLimited) { %>
    <div class="rounded-2xl p-6 text-center" style="background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.08);">
        <iconify-icon icon="mdi:timer-sand" class="text-3xl text-amber-400 mb-2"></iconify-icon>
        <p class="text-sm text-zinc-300">Terlalu banyak percobaan. Coba lagi sebentar lagi.</p>
    </div>
<% } else if (!order) { %>
    <div class="rounded-2xl p-6 text-center" style="background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.08);">
        <iconify-icon icon="mdi:receipt-text-remove-outline" class="text-3xl text-zinc-500 mb-2"></iconify-icon>
        <p class="text-sm text-zinc-300 font-semibold mb-1">Pesanan tidak ditemukan</p>
        <p class="text-xs text-zinc-500">Pastikan kode pesanan yang kamu buka sudah benar.</p>
    </div>
<% } else { %>
    <%
    const statusMap = {
        done:    { label: 'Selesai',   color: '#22c55e', bg: 'rgba(34,197,94,.12)',  icon: 'mdi:check-circle' },
        pending: { label: 'Pending',   color: '#f59e0b', bg: 'rgba(245,158,11,.12)', icon: 'mdi:clock-outline' },
        failed:  { label: 'Gagal',     color: '#ef4444', bg: 'rgba(239,68,68,.12)',  icon: 'mdi:close-circle' },
        expired: { label: 'Kadaluarsa',color: '#71717a', bg: 'rgba(113,113,122,.12)',icon: 'mdi:clock-alert-outline' },
    };
    const st = statusMap[order.status] || statusMap.pending;
    %>
    <div class="rounded-2xl p-5" style="background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.08);">
        <div class="flex items-center justify-between mb-4">
            <span class="text-[11px] text-zinc-500 font-mono"><%= order.code %></span>
            <span class="flex items-center gap-1.5 text-[11px] font-bold px-2.5 py-1 rounded-full" style="color:<%= st.color %>;background:<%= st.bg %>;">
                <iconify-icon icon="<%= st.icon %>"></iconify-icon> <%= st.label %>
            </span>
        </div>

        <h1 class="text-base font-bold text-white mb-1"><%= order.productName %></h1>
        <p class="text-xs text-zinc-500 mb-4"><%= order.duration %></p>

        <div class="flex items-center justify-between py-3 border-t border-white/5">
            <span class="text-xs text-zinc-400">Total</span>
            <span class="text-sm font-bold text-white">Rp<%= (order.price || 0).toLocaleString('id-ID') %></span>
        </div>

        <% if (order.status === 'done' && order.key) { %>
            <div class="mt-2 rounded-xl p-3.5" style="background:rgba(99,102,241,.08);border:1px solid rgba(99,102,241,.25);">
                <p class="text-[11px] text-indigo-300 font-semibold mb-1.5 flex items-center gap-1.5">
                    <iconify-icon icon="mdi:key-variant"></iconify-icon> Key Produk
                </p>
                <p id="orderKey" class="text-sm font-mono text-white break-all select-all"><%= order.key %></p>
                <button onclick="navigator.clipboard.writeText(document.getElementById('orderKey').textContent).then(()=>{const b=event.target.closest('button');b.textContent='Tersalin!';setTimeout(()=>b.textContent='Salin Key',1500);})"
                    class="mt-2.5 w-full text-[11px] font-bold py-2 rounded-lg bg-indigo-500/20 text-indigo-300 hover:bg-indigo-500/30 transition-all">
                    Salin Key
                </button>
                <% if (order.downloadLink) { %>
                <a href="<%= order.downloadLink %>" target="_blank" rel="noopener"
                    class="mt-2 w-full flex items-center justify-center gap-1.5 text-[11px] font-bold py-2 rounded-lg bg-emerald-500/20 text-emerald-300 hover:bg-emerald-500/30 transition-all">
                    <iconify-icon icon="mdi:download"></iconify-icon> Buka Link Download
                </a>
                <% } %>
            </div>
        <% } else if (order.status === 'pending') { %>
            <div class="mt-2 rounded-xl p-3.5 text-center" style="background:rgba(245,158,11,.06);border:1px solid rgba(245,158,11,.2);">
                <p class="text-xs text-amber-300">Pesanan masih menunggu konfirmasi pembayaran.</p>
            </div>
        <% } else if (order.status === 'failed' || order.status === 'expired') { %>
            <div class="mt-2 rounded-xl p-3.5 text-center" style="background:rgba(239,68,68,.06);border:1px solid rgba(239,68,68,.2);">
                <p class="text-xs text-red-300">Pesanan ini tidak berhasil diselesaikan. Hubungi admin jika kamu sudah membayar.</p>
            </div>
        <% } %>
    </div>

    <p class="text-center text-[11px] text-zinc-600 mt-4">Simpan tangkapan layar halaman ini sebagai bukti pesanan.</p>
<% } %>

</div>
</div>
