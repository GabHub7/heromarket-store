<!-- PRODUCTS -->
<section id="games" class="relative py-10 sm:py-16 border-t border-white/[0.03]">
    <div class="relative max-w-7xl mx-auto px-3 sm:px-6">
        <div class="mb-5 sm:mb-8">
            <h2 class="font-display text-base sm:text-xl font-bold mb-1 text-left flex items-center gap-2">
                <iconify-icon icon="solar:widget-bold" class="text-violet-400 text-lg sm:text-xl"></iconify-icon>Semua Produk
            </h2>
            <p class="text-white/25 text-[10px] sm:text-xs">Filter berdasarkan game</p>
        </div>

        <% if (categories && categories.length > 0) { %>
        <div class="filter-scroll flex gap-2 mb-6 sm:mb-8 overflow-x-auto pb-1" style="-ms-overflow-style:none;scrollbar-width:none;">
            <div class="filter-sticky-left">
                <button onclick="filterProducts('all')" class="prod-filter px-4 sm:px-5 py-2 sm:py-2.5 rounded-xl text-[11px] sm:text-xs font-semibold transition-all whitespace-nowrap bg-violet-600 text-white" data-pf="all">Semua</button>
            </div>
            <% categories.forEach(cat => { %>
                <button onclick="filterProducts('<%= cat %>')" class="prod-filter flex-shrink-0 px-4 sm:px-5 py-2 sm:py-2.5 rounded-xl text-[11px] sm:text-xs font-semibold transition-all whitespace-nowrap bg-white/5 text-white/40 hover:text-white hover:bg-white/8" data-pf="<%= cat %>">
                    <%= categoryLabels[cat] || cat.toUpperCase() %>
                </button>
            <% }) %>
        </div>
        <% } %>

        <div id="product-grid" class="grid grid-cols-3 sm:grid-cols-3 lg:grid-cols-4 gap-2 sm:gap-5">
            <% products.forEach((product, pIdx) => {
                const stock = product.stock || 0;
                const isOut = stock === 0;
                const isLow = stock > 0 && stock <= 5 && stock !== Infinity;
                const hasAndroid = product.platforms && product.platforms.includes('android');
                const hasIos = product.platforms && product.platforms.includes('ios');
                // BUG FIX: stock bisa Infinity untuk produk stockSource
                // 'auto' -- jangan tampilkan literal "Infinity" ke user.
                const displayStock = stock === Infinity ? 'Tersedia' : stock;
                const displaySold  = product.dummySold || 0;
                const soldLabel    = displaySold >= 1000 ? (displaySold/1000).toFixed(1).replace('.0','') + 'K' : String(displaySold);
            %>
                <div class="product-card glass rounded-2xl overflow-hidden border border-white/[0.06]" data-category="<%= product.category %>">
                    <div class="relative overflow-hidden h-28 sm:h-40">
                        <% if (product.image) { %>
                            <img src="<%= product.image %>" alt="<%= product.name %>" class="w-full h-full object-cover" loading="lazy"
                                 onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
                            <div class="absolute inset-0 items-center justify-center hidden" style="background:rgba(99,102,241,.06);">
                                <iconify-icon icon="solar:gamepad-bold" class="text-2xl text-violet-400/40"></iconify-icon>
                            </div>
                        <% } else { %>
                            <div class="w-full h-full flex items-center justify-center" style="background:rgba(99,102,241,.06);">
                                <iconify-icon icon="solar:gamepad-bold" class="text-2xl text-violet-400/40"></iconify-icon>
                            </div>
                        <% } %>
                        <% if (product.safetyStatus) { %>
                        <div class="absolute top-0 left-0 z-10">
                            <% if (product.safetyStatus === 'safe') { %>
                                <span class="safety-label safe"><iconify-icon icon="mdi:shield-check" style="font-size:8px;"></iconify-icon> Safe to Use</span>
                            <% } else if (product.safetyStatus === 'risk') { %>
                                <span class="safety-label risk"><iconify-icon icon="mdi:alert" style="font-size:8px;"></iconify-icon> Use at Your Own Risk</span>
                            <% } else if (product.safetyStatus === 'maintenance') { %>
                                <span class="safety-label maintenance"><iconify-icon icon="mdi:wrench" style="font-size:8px;"></iconify-icon> Maintenance</span>
                            <% } %>
                        </div>
                        <% } %>
                        <div class="absolute top-1 right-1 z-10">
                            <% if (hasAndroid) { %>
                                <span class="platform-label">ANDROID</span>
                            <% } else if (hasIos) { %>
                                <span class="platform-label">iOS</span>
                            <% } %>
                        </div>
                    </div>
                    <div class="p-2.5 sm:p-3.5">
                        <h3 class="font-display font-bold text-[11px] sm:text-sm truncate mb-1.5 text-white"><%= product.name %></h3>
                        <div class="flex justify-center items-center text-[8px] sm:text-[10px] mb-2.5 pb-2.5 border-b border-white/[0.05]">
                            <span class="text-white/30">Terjual <span class="text-white/55 font-bold"><%= soldLabel %></span></span>
                        </div>
                        <% if (!isOut) { %>
                            <a href="/buy/<%= product.id %>"
                               class="btn-primary w-full py-2 sm:py-2.5 rounded-lg sm:rounded-xl text-[10px] sm:text-xs font-bold text-white flex items-center justify-center gap-1.5">
                                <iconify-icon icon="solar:cart-large-2-bold" class="text-[10px] sm:text-sm"></iconify-icon>Beli
                            </a>
                        <% } else { %>
                            <button disabled class="w-full py-2 sm:py-2.5 rounded-lg sm:rounded-xl text-[10px] sm:text-xs font-bold cursor-not-allowed flex items-center justify-center gap-1.5"
                                style="background:rgba(255,255,255,0.04);color:rgba(255,255,255,0.2);border:1px solid rgba(255,255,255,0.06);">
                                <iconify-icon icon="solar:close-circle-bold" class="text-[10px] sm:text-sm"></iconify-icon>Habis
                            </button>
                        <% } %>
                    </div>
                </div>
            <% }) %>
        </div>

        <% if (products.length === 0) { %>
        <div class="col-span-2 sm:col-span-3 lg:col-span-4 text-center py-16">
            <iconify-icon icon="solar:box-minimalistic-bold" class="text-3xl text-white/10 mb-3 block mx-auto"></iconify-icon>
            <p class="text-white/15 text-xs">Belum ada produk tersedia</p>
        </div>
        <% } %>
    </div>
</section>

<!-- LEADERBOARD -->
<section id="leaderboard-home" class="relative py-12 sm:py-20 border-y border-white/[0.03]">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[400px] h-[400px] bg-yellow-500/[0.02] rounded-full blur-[120px] pointer-events-none"></div>
    <div class="relative max-w-3xl mx-auto px-3 sm:px-6">
        <div class="text-center mb-8 sm:mb-14">
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full glass mb-4">
                <iconify-icon icon="solar:cup-star-bold" class="text-yellow-400 text-xs"></iconify-icon>
                <span class="text-[10px] font-semibold text-white/50 tracking-wide uppercase">TOP LEADERBOARD</span>
            </div>
            <h2 class="font-display text-2xl sm:text-4xl font-bold mb-3">Top <span class="bg-gradient-to-r from-violet-400 to-yellow-400 bg-clip-text text-transparent">Pembeli</span></h2>
            <p class="text-white/25 text-[10px] sm:text-xs">Pengguna paling aktif bulan ini</p>
        </div>

        <%
        const lbEntries = typeof leaderboardEntries !== 'undefined' ? leaderboardEntries : [];
        const avatarGrads2 = ['from-violet-400 to-purple-500','from-gray-300 to-gray-400','from-orange-400 to-orange-600','from-violet-400 to-purple-500','from-blue-400 to-cyan-500','from-green-400 to-emerald-500','from-red-400 to-rose-500','from-pink-400 to-fuchsia-500'];
        const lbTop3 = lbEntries.slice(0,3);
        const lbRest = lbEntries.slice(3);
        %>
        <div id="leaderboard-top3" class="flex items-end justify-center gap-4 sm:gap-8 mb-8">
            <% if (lbTop3.length >= 3) {
                // order: 2nd, 1st, 3rd
                const ordered = [lbTop3[1], lbTop3[0], lbTop3[2]];
                const heights2 = ['h-20 w-20 sm:h-24 sm:w-24','h-24 w-24 sm:h-28 sm:w-28','h-16 w-16 sm:h-20 sm:w-20'];
                const rankBgs2 = ['bg-gray-400/20 text-gray-300 border-gray-400/30','bg-yellow-500/20 text-yellow-300 border-yellow-500/30','bg-orange-500/20 text-orange-300 border-orange-500/30'];
                ordered.forEach(function(u, i) {
                    const origIdx = [1,0,2][i];
                    const mg2 = origIdx===0 ? '-mt-4 sm:-mt-6' : '';
                    const initials2 = (u.username||'U').substring(0,2).toUpperCase();
            %>
            <div class="flex flex-col items-center <%= mg2 %> relative z-10">
                <div class="relative flex flex-col items-center mb-2">
                    <% if (origIdx===0) { %><div class="absolute -top-5 sm:-top-6 text-2xl sm:text-3xl" style="filter:drop-shadow(0 0 8px #fbbf24)"><iconify-icon icon="solar:crown-bold" style="color:gold"></iconify-icon></div><% } %>
                    <% if (u.photo) { %>
                    <div class="<%= heights2[i] %> <%= origIdx===0?'glow-first':'' %> rounded-full overflow-hidden shadow-lg relative z-10" style="border:2px solid rgba(255,255,255,.18)">
                        <img src="<%= u.photo %>" class="w-full h-full object-cover" alt="<%= u.username %>">
                    </div>
                    <% } else { %>
                    <div class="<%= heights2[i] %> <%= origIdx===0?'glow-first':'' %> rounded-full bg-gradient-to-br <%= avatarGrads2[origIdx] %> flex items-center justify-center font-bold text-white shadow-lg relative z-10 text-sm sm:text-base"><%= initials2 %></div>
                    <% } %>
                </div>
                <span class="text-white font-bold text-[10px] sm:text-sm mt-1 text-center max-w-[80px] truncate"><%= u.username %></span>
                <span class="text-white/40 text-[9px] sm:text-xs font-medium">Rp <%= Number(u.totalSpent).toLocaleString('id-ID') %></span>
                <span class="mt-1.5 text-[9px] font-bold px-2.5 py-0.5 rounded-md <%= rankBgs2[origIdx] %> border">#<%= origIdx+1 %></span>
            </div>
            <% }); } %>
        </div>
        <div id="leaderboard-home-list" class="glass rounded-xl sm:rounded-2xl p-3 sm:p-4 space-y-2">
            <% if (lbRest.length > 0) {
                lbRest.forEach(function(u, i) {
                    const initials2 = (u.username||'U').substring(0,2).toUpperCase();
                    const rankNum = i+4;
            %>
            <div class="flex items-center gap-3 p-2 sm:p-2.5 rounded-lg hover:bg-white/[0.02] transition-colors">
                <span class="text-white/30 font-bold w-6 text-center text-xs"><%= rankNum %></span>
                <% if (u.photo) { %>
                <div class="w-8 h-8 rounded-full overflow-hidden flex-shrink-0" style="border:2px solid rgba(255,255,255,.12)">
                    <img src="<%= u.photo %>" class="w-full h-full object-cover" alt="<%= u.username %>">
                </div>
                <% } else { %>
                <div class="w-8 h-8 rounded-full bg-gradient-to-br <%= avatarGrads2[(i+3)%avatarGrads2.length] %> flex items-center justify-center text-[9px] font-bold text-white"><%= initials2 %></div>
                <% } %>
                <div class="flex-1 min-w-0"><span class="text-white text-xs sm:text-sm font-medium block truncate"><%= u.username %></span></div>
                <div class="text-right">
                    <div class="text-white/40 text-[9px] sm:text-xs font-medium whitespace-nowrap"><%= u.totalTransactions %>x beli</div>
                    <div class="text-white/25 text-[8px]">Rp <%= Number(u.totalSpent).toLocaleString('id-ID') %></div>
                </div>
            </div>
            <% }); } else { %>
            <div class="text-center py-6 text-xs text-white/20">Belum ada data leaderboard</div>
            <% } %>
        </div>
        <a href="/leaderboard" class="mt-4 w-full py-3 rounded-xl flex items-center justify-center gap-2 text-xs font-semibold text-white/40 hover:text-white transition-all btn-ghost">
            <iconify-icon icon="solar:medal-ribbon-bold" class="text-sm"></iconify-icon> Lihat Papan Skor Lengkap
        </a>
    </div>
</section>


