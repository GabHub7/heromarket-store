    btn.innerHTML = '<iconify-icon icon="mdi:plus-circle"></iconify-icon> Tambah Banner';
    if (d.success) {
        toast('Banner berhasil ditambahkan!', 'success');
        window._allBanners = d.banners;
        renderBanners(d.banners);
        e.target.reset();
        document.getElementById('bannerFilePreview').classList.add('hidden');
        document.getElementById('bannerUrlPreview').classList.add('hidden');
    } else toast(d.message || 'Gagal tambah banner', 'error');
}

async function toggleBanner(id) {
    const d = await api(`/admin/banners/toggle/${id}`, {});
    if (d.success) {
        window._allBanners = window._allBanners.map(b => b.id===id ? {...b, active:d.active} : b);
        renderBanners(window._allBanners);
        toast(`Banner ${d.active?'diaktifkan':'dinonaktifkan'}`, 'success');
    }
}

async function deleteBanner(id) {
    if (!confirm('Hapus banner ini?')) return;
    const d = await api(`/admin/banners/delete/${id}`, {});
    if (d.success) {
        window._allBanners = window._allBanners.filter(b => b.id!==id);
        renderBanners(window._allBanners);
        toast('Banner dihapus', 'success');
    }
}

// Override api() untuk DELETE yang butuh method POST tanpa body conflict
window.api = window.api || async function(url, data) {
    const res = await fetch(url, { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(data) });
    return res.json();
};

// Load banners saat tab settings dibuka
const _origSwitchTab = window.switchTab;
window.switchTab = function(name) {
    _origSwitchTab && _origSwitchTab(name);
    if (name === 'settings' && !window._bannersLoaded) {
        window._bannersLoaded = true;
        fetch('/api/banners').then(r=>r.json()).then(banners=>{
            // Fetch all banners including inactive via a trick:
            // We use the already-rendered EJS data
            window._allBanners = <%- JSON.stringify(settings.banners || []) %>;
            renderBanners(window._allBanners);
        });
    }
};

// Init jika sudah di tab settings
if (document.querySelector('#pane-settings.active')) {
    window._allBanners = <%- JSON.stringify(settings.banners || []) %>;
    renderBanners(window._allBanners);
}

document.getElementById('categoryForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    const fd = new FormData(this);
    const raw = fd.get('categories') || '';
    const lines = raw.trim().split('\n').filter(l=>l.trim());
    const cats = [], labels = {};
    lines.forEach(line => {
        const [id, ...rest] = line.split(':');
        if (id && id.trim()) { cats.push(id.trim()); labels[id.trim()] = rest.join(':').trim()||id.trim(); }
    });
    const d = await api('/admin/settings/update', { categories: JSON.stringify(cats), categoryLabels: JSON.stringify(labels) });
    if (d.success) { toast('Kategori disimpan!', 'success'); setTimeout(()=>window.location.href='/admin#settings',800); }
    else toast(d.message, 'error');
});

// ═══ SALES CHART ═══
