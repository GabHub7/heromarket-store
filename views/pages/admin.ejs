    if (!ctx || typeof Chart === 'undefined') return;
    const raw = <%- JSON.stringify(chartData) %>;
    const labels = raw.map(d => d.date);
    const counts = raw.map(d => d.count);
    const revenues = raw.map(d => d.revenue);
    new Chart(ctx, {
        type: 'bar',
        data: {
