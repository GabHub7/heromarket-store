async function toggleReseller(id, username) {
    const action = document.getElementById(`reseller-btn-${id}`)?.textContent?.trim().includes('Cabut') ? 'cabut' : 'jadikan';
    if (!confirm(`${action === 'cabut' ? 'Cabut' : 'Jadikan'} "${username}" sebagai reseller?`)) return;
    const d = await api(`/admin/user/toggle-reseller/${id}`, {});
    if (d.success) {
        toast(d.is_reseller ? `${username} sekarang Reseller VIP!` : `Status reseller ${username} dicabut`, d.is_reseller ? 'success' : 'warn');
        setTimeout(() => location.reload(), 800);
    } else toast(d.message, 'error');
}

// ── ADJUST SALDO RESELLER (tambah/kurangi manual oleh admin) ──
async function adjustBalance(id, username, sign) {
    const input = document.getElementById(`adj-input-${id}`);
    const nominal = parseInt(input?.value);
    if (!nominal || nominal <= 0) { toast('Masukkan nominal dulu', 'error'); return; }
    const amount = nominal * sign;
    if (!confirm(`${sign > 0 ? 'Tambah' : 'Kurangi'} saldo ${username} sebesar Rp${nominal.toLocaleString('id-ID')}?`)) return;
    const d = await api(`/admin/user/adjust-balance/${id}`, { amount });
    if (d.success) {
        document.getElementById(`bal-${id}`).textContent = 'Rp ' + d.balance.toLocaleString('id-ID');
        input.value = '';
        toast(`Saldo ${username} berhasil di-${sign > 0 ? 'tambah' : 'kurangi'}`, 'success');
    } else toast(d.message, 'error');
}

// ── SIMPAN HARGA RESELLER PER PRODUK ──
async function saveResellerPrice(productId, productName) {
    const card = document.querySelector(`[data-rprice-product="${productId}"]`);
    if (!card) return;
    const entries = [];
    card.querySelectorAll('[data-days]').forEach(row => {
        const days = parseInt(row.dataset.days);
        const val = row.querySelector('.rprice-input').value;
        entries.push({ days, resellerPrice: val === '' ? null : parseInt(val) });
    });
    const d = await api(`/admin/product/reseller-price/${productId}`, { entries });
    if (d.success) toast(`Harga reseller ${productName} disimpan!`, 'success');
    else toast(d.message, 'error');
}

