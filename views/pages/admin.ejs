<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>Admin — <%= settings.siteName %></title>
<script src="https://cdn.tailwindcss.com"></script>
<script src="https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js" defer></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Orbitron:wght@700;900&display=swap" rel="stylesheet">
<script>tailwind.config={theme:{extend:{fontFamily:{inter:['Inter','sans-serif'],orbitron:['Orbitron','sans-serif']}}}}</script>
<style>
:root{--bg:#0b0b1a;--card:#0f0f25;--card2:#12122a;--border:rgba(255,255,255,.07);--accent:#6366f1;}
*{margin:0;padding:0;box-sizing:border-box;}
html,body{font-family:'Inter',sans-serif;background:var(--bg);color:#e0e0e0;overflow-x:hidden;}
body{padding-bottom:80px;}
::-webkit-scrollbar{width:4px;height:4px;}
::-webkit-scrollbar-track{background:var(--bg);}
::-webkit-scrollbar-thumb{background:#2a2a4a;border-radius:3px;}

body::before{content:'';position:fixed;inset:0;background-image:linear-gradient(rgba(99,102,241,.02) 1px,transparent 1px),linear-gradient(90deg,rgba(99,102,241,.02) 1px,transparent 1px);background-size:40px 40px;pointer-events:none;z-index:0;}
body>*{position:relative;z-index:1;}

@keyframes fadeInUp{from{opacity:0;transform:translateY(12px);}to{opacity:1;transform:translateY(0);}}
@keyframes slideUp{from{transform:translateY(100%);opacity:0;}to{transform:translateY(0);opacity:1;}}
@keyframes spin{to{transform:rotate(360deg);}}
@keyframes blink{0%,100%{opacity:1;}50%{opacity:.4;}}

.fade-in{animation:fadeInUp .3s ease-out both;}
.animate-spin{animation:spin 1s linear infinite;}
.shimmer-text{background:linear-gradient(135deg,#818cf8,#a78bfa);-webkit-background-clip:text;-webkit-text-fill-color:transparent;}

.neon-card{background:var(--card);border:1px solid var(--border);border-radius:14px;transition:border-color .2s;}
.neon-card:hover{border-color:rgba(99,102,241,.25);}

.stat-card{background:linear-gradient(135deg,rgba(99,102,241,.1),rgba(139,92,246,.05));border:1px solid rgba(99,102,241,.2);border-radius:14px;padding:16px;transition:all .2s;}
.stat-card:hover{border-color:rgba(99,102,241,.4);transform:translateY(-2px);}

.hm-input,.form-input{width:100%;padding:10px 14px;border-radius:10px;background:rgba(255,255,255,.05);border:1.5px solid rgba(255,255,255,.1);color:#fff;font-size:13px;transition:all .2s;font-family:'Inter',sans-serif;}
.hm-input:focus,.form-input:focus{outline:none;border-color:rgba(99,102,241,.6);background:rgba(99,102,241,.06);box-shadow:0 0 0 3px rgba(99,102,241,.1);}
.hm-input::placeholder,.form-input::placeholder{color:#52525b;}
select.hm-input{appearance:none;cursor:pointer;}
textarea.hm-input{resize:vertical;min-height:80px;}

.btn-primary{background:linear-gradient(135deg,#6366f1,#8b5cf6);color:#fff;padding:10px 18px;border-radius:10px;font-weight:700;font-size:12px;border:none;cursor:pointer;transition:all .2s;display:inline-flex;align-items:center;gap:6px;}
.btn-primary:hover{filter:brightness(1.15);transform:translateY(-1px);}
.btn-danger{background:linear-gradient(135deg,#ef4444,#dc2626);color:#fff;padding:7px 14px;border-radius:8px;font-weight:600;font-size:11px;border:none;cursor:pointer;transition:filter .2s;display:inline-flex;align-items:center;gap:4px;}
.btn-danger:hover{filter:brightness(1.15);}
.btn-success{background:linear-gradient(135deg,#10b981,#059669);color:#fff;padding:7px 14px;border-radius:8px;font-weight:600;font-size:11px;border:none;cursor:pointer;transition:filter .2s;display:inline-flex;align-items:center;gap:4px;}
.btn-success:hover{filter:brightness(1.15);}
.btn-warning{background:linear-gradient(135deg,#f59e0b,#d97706);color:#fff;padding:7px 14px;border-radius:8px;font-weight:600;font-size:11px;border:none;cursor:pointer;transition:filter .2s;display:inline-flex;align-items:center;gap:4px;}

.data-table{width:100%;border-collapse:collapse;}
.data-table th{background:rgba(99,102,241,.1);padding:10px 12px;text-align:left;font-size:10px;font-weight:800;color:#818cf8;text-transform:uppercase;letter-spacing:.6px;white-space:nowrap;}
.data-table td{padding:10px 12px;border-bottom:1px solid rgba(255,255,255,.05);font-size:12px;vertical-align:middle;}
.data-table tr:hover td{background:rgba(99,102,241,.04);}

.badge{display:inline-flex;align-items:center;gap:3px;padding:3px 8px;border-radius:6px;font-size:10px;font-weight:700;text-transform:uppercase;white-space:nowrap;}
.badge-done{background:rgba(16,185,129,.15);color:#34d399;border:1px solid rgba(16,185,129,.25);}
.badge-pending{background:rgba(234,179,8,.15);color:#facc15;border:1px solid rgba(234,179,8,.25);}
.badge-inactive{background:rgba(239,68,68,.15);color:#f87171;border:1px solid rgba(239,68,68,.25);}
.badge-featured{background:rgba(139,92,246,.15);color:#a78bfa;border:1px solid rgba(139,92,246,.25);}
.badge-failed{background:rgba(239,68,68,.18);color:#fca5a5;border:1px solid rgba(239,68,68,.35);}

.tab-pane{display:none;}
.tab-pane.active{display:block;animation:fadeInUp .3s ease-out both;}

.modal-wrap{display:none;position:fixed;inset:0;z-index:80;}
.modal-wrap.open{display:flex;align-items:flex-end;justify-content:center;}
@media(min-width:640px){.modal-wrap.open{align-items:center;}}
.modal-bg{position:absolute;inset:0;background:rgba(0,0,0,.75);}
.modal-box{position:relative;background:var(--card);border:1px solid rgba(99,102,241,.2);width:100%;max-height:90vh;overflow-y:auto;border-radius:20px 20px 0 0;animation:slideUp .25s ease-out both;}
@media(min-width:640px){.modal-box{border-radius:16px;max-width:580px;}}
.modal-box::-webkit-scrollbar{width:3px;}
.modal-box::-webkit-scrollbar-thumb{background:#2a2a4a;border-radius:2px;}
.modal-handle{width:40px;height:4px;background:rgba(255,255,255,.12);border-radius:2px;margin:12px auto 0;}

#toast-container{position:fixed;top:12px;right:12px;z-index:9999;display:flex;flex-direction:column;gap:8px;}
.toast{display:flex;align-items:center;gap:8px;padding:10px 14px;border-radius:12px;background:var(--card);box-shadow:0 8px 32px rgba(0,0,0,.5);font-size:12px;max-width:280px;border:1px solid;animation:fadeInUp .3s ease-out both;}

#admin-nav{position:fixed;bottom:0;left:0;right:0;z-index:70;background:rgba(8,8,22,.98);border-top:1px solid rgba(99,102,241,.15);height:68px;display:flex;align-items:center;justify-content:space-around;padding:0 4px 6px;box-shadow:0 -4px 20px rgba(0,0,0,.5);}
.nav-btn{display:flex;flex-direction:column;align-items:center;gap:3px;padding:6px 8px;border-radius:12px;cursor:pointer;transition:all .2s;flex:1;max-width:64px;border:1.5px solid transparent;-webkit-tap-highlight-color:transparent;position:relative;}
.nav-btn .n-icon{font-size:20px;color:#52525b;transition:color .2s;line-height:1;}
.nav-btn .n-label{font-size:9px;font-weight:700;color:#52525b;transition:color .2s;white-space:nowrap;}
.nav-btn.active .n-icon{color:#818cf8;}
.nav-btn.active .n-label{color:#818cf8;}
.nav-btn.active{background:rgba(99,102,241,.12);border-color:rgba(99,102,241,.25);}
.nav-btn:active{transform:scale(.88);}
.nav-dot{position:absolute;top:4px;right:6px;width:7px;height:7px;background:#ef4444;border-radius:50%;border:1.5px solid var(--bg);animation:blink 2s infinite;}

.page-top{padding:12px 16px;background:rgba(8,8,22,.95);border-bottom:1px solid var(--border);position:sticky;top:0;z-index:30;}
.prod-card{background:var(--card2);border:1px solid var(--border);border-radius:12px;padding:14px;transition:border-color .2s;display:flex;align-items:center;gap:12px;}
.prod-card:hover{border-color:rgba(99,102,241,.3);}
.section-label{font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.8px;color:#52525b;margin-bottom:10px;display:flex;align-items:center;gap:6px;}
.section-label::before{content:'';width:16px;height:2px;background:var(--accent);border-radius:2px;display:block;}
.setting-row-label{font-size:11px;font-weight:700;color:#a1a1aa;margin-bottom:8px;}
</style>
</head>
<body class="font-inter">

<div id="toast-container"></div>

<!-- HEADER -->
<div id="binid-alert" class="hidden px-4 py-2 text-[11px] font-bold text-center" style="background:rgba(234,179,8,.15);border-bottom:1px solid rgba(234,179,8,.3);color:#fbbf24;">
    <iconify-icon icon="mdi:alert" class="align-middle mr-1"></iconify-icon>
    <span id="binid-msg"></span>
</div>

<div class="page-top flex items-center justify-between">
    <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center flex-shrink-0">
            <iconify-icon icon="mdi:shield-crown" class="text-white text-base"></iconify-icon>
        </div>
        <div>
            <div class="font-orbitron text-sm font-black shimmer-text">ADMIN PANEL</div>
            <div class="text-[9px] text-zinc-600"><%= settings.siteName %></div>
        </div>
    </div>
    <div class="flex items-center gap-2">
        <span class="text-[10px] text-zinc-500 hidden sm:block">
            <span class="text-emerald-400 font-bold"><%= stats.doneTransactions %></span> done ·
            <span class="text-yellow-400 font-bold"><%= stats.pendingTransactions %></span> pending
        </span>
        <a href="/" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-white/10 text-zinc-400 hover:text-white hover:bg-white/5 transition-all text-xs">
            <iconify-icon icon="mdi:home" class="text-sm"></iconify-icon>
            <span class="hidden sm:inline">Beranda</span>
        </a>
        <a href="/logout" onclick="clearAndLogout(event)" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-red-500/20 text-red-400 hover:bg-red-500/10 transition-all text-xs">
            <iconify-icon icon="mdi:logout" class="text-sm"></iconify-icon>
        </a>
    </div>
</div>

<!-- MAIN -->
<div class="max-w-4xl mx-auto px-4 py-5">

<!-- ── DASHBOARD ── -->
<div id="pane-dashboard" class="tab-pane active">
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mb-3">
        <div class="stat-card fade-in" style="background:linear-gradient(135deg,rgba(99,102,241,.12),rgba(139,92,246,.06));border-color:rgba(99,102,241,.25);">
            <div class="flex items-center justify-between mb-2">
                <span class="text-[10px] text-zinc-500 font-semibold uppercase tracking-wide">Produk</span>
                <iconify-icon icon="mdi:package-variant" class="text-indigo-400 text-lg"></iconify-icon>
            </div>
            <div class="text-2xl font-black text-white font-orbitron"><%= stats.totalProducts %></div>
            <div class="text-[10px] text-zinc-600 mt-1"><%= stats.activeProducts %> aktif</div>
        </div>
        <div class="stat-card fade-in" style="background:linear-gradient(135deg,rgba(16,185,129,.1),rgba(5,150,105,.05));border-color:rgba(16,185,129,.25);">
            <div class="flex items-center justify-between mb-2">
                <span class="text-[10px] text-zinc-500 font-semibold uppercase tracking-wide">Selesai</span>
                <iconify-icon icon="mdi:check-circle" class="text-emerald-400 text-lg"></iconify-icon>
            </div>
            <div class="text-2xl font-black text-white font-orbitron"><%= stats.doneTransactions %></div>
            <div class="text-[10px] text-emerald-600 mt-1">transaksi done</div>
        </div>
        <div class="stat-card fade-in" style="background:linear-gradient(135deg,rgba(234,179,8,.1),rgba(245,158,11,.05));border-color:rgba(234,179,8,.25);">
            <div class="flex items-center justify-between mb-2">
                <span class="text-[10px] text-zinc-500 font-semibold uppercase tracking-wide">Pending</span>
                <iconify-icon icon="mdi:clock-outline" class="text-yellow-400 text-lg"></iconify-icon>
            </div>
            <div class="text-2xl font-black text-white font-orbitron"><%= stats.pendingTransactions %></div>
            <div class="text-[10px] text-yellow-600 mt-1">menunggu</div>
        </div>
        <div class="stat-card fade-in" style="background:linear-gradient(135deg,rgba(22,163,74,.1),rgba(21,128,61,.05));border-color:rgba(22,163,74,.25);">
            <div class="flex items-center justify-between mb-2">
                <span class="text-[10px] text-zinc-500 font-semibold uppercase tracking-wide">Revenue</span>
                <iconify-icon icon="mdi:cash-multiple" class="text-green-400 text-lg"></iconify-icon>
            </div>
            <div class="text-lg font-black text-white font-orbitron">Rp <%= (stats.totalRevenue/1000).toFixed(0) %>K</div>
            <div class="text-[10px] text-green-600 mt-1">total pendapatan</div>
        </div>
        <div class="stat-card fade-in" style="background:linear-gradient(135deg,rgba(59,130,246,.1),rgba(37,99,235,.05));border-color:rgba(59,130,246,.25);">
            <div class="flex items-center justify-between mb-2">
                <span class="text-[10px] text-zinc-500 font-semibold uppercase tracking-wide">Users</span>
                <iconify-icon icon="mdi:account-group" class="text-blue-400 text-lg"></iconify-icon>
            </div>
            <div class="text-2xl font-black text-white font-orbitron"><%= stats.totalUsers %></div>
            <div class="text-[10px] text-blue-600 mt-1">member terdaftar</div>
        </div>
        <div class="stat-card fade-in" style="background:linear-gradient(135deg,rgba(234,88,12,.1),rgba(194,65,12,.05));border-color:rgba(234,88,12,.25);">
            <div class="flex items-center justify-between mb-2">
                <span class="text-[10px] text-zinc-500 font-semibold uppercase tracking-wide">Reseller</span>
                <iconify-icon icon="mdi:crown" class="text-orange-400 text-lg"></iconify-icon>
            </div>
            <div class="text-2xl font-black text-white font-orbitron"><%= stats.totalResellers || 0 %></div>
            <div class="text-[10px] text-orange-600 mt-1">reseller VIP aktif</div>
        </div>
    </div>

    <!-- GRAFIK PENJUALAN 7 HARI -->
    <div class="neon-card p-4 mb-5">
        <div class="section-label mb-3">Grafik Penjualan 7 Hari Terakhir</div>
        <div style="position:relative;height:180px;">
            <canvas id="salesChart"></canvas>
        </div>
    </div>

    <div class="section-label">Quick Actions</div>
    <div class="grid grid-cols-3 sm:grid-cols-6 gap-2 mb-5">
        <button onclick="switchTab('products')" class="flex flex-col items-center gap-1.5 p-3 rounded-xl bg-indigo-500/10 border border-indigo-500/20 hover:bg-indigo-500/20 transition-all">
            <iconify-icon icon="mdi:package-variant" class="text-xl text-indigo-400"></iconify-icon>
            <span class="text-[10px] font-semibold text-indigo-300">Produk</span>
        </button>
        <button onclick="switchTab('transactions')" class="flex flex-col items-center gap-1.5 p-3 rounded-xl bg-emerald-500/10 border border-emerald-500/20 hover:bg-emerald-500/20 transition-all">
            <iconify-icon icon="mdi:receipt-text" class="text-xl text-emerald-400"></iconify-icon>
            <span class="text-[10px] font-semibold text-emerald-300">Transaksi</span>
        </button>
        <button onclick="switchTab('users')" class="flex flex-col items-center gap-1.5 p-3 rounded-xl bg-blue-500/10 border border-blue-500/20 hover:bg-blue-500/20 transition-all">
            <iconify-icon icon="mdi:account-group" class="text-xl text-blue-400"></iconify-icon>
            <span class="text-[10px] font-semibold text-blue-300">Users</span>
        </button>
        <button onclick="switchTab('testimonials')" class="flex flex-col items-center gap-1.5 p-3 rounded-xl bg-purple-500/10 border border-purple-500/20 hover:bg-purple-500/20 transition-all">
            <iconify-icon icon="mdi:comment-quote" class="text-xl text-purple-400"></iconify-icon>
            <span class="text-[10px] font-semibold text-purple-300">Testimoni</span>
        </button>
        <button onclick="switchTab('settings')" class="flex flex-col items-center gap-1.5 p-3 rounded-xl bg-amber-500/10 border border-amber-500/20 hover:bg-amber-500/20 transition-all">
            <iconify-icon icon="mdi:cog" class="text-xl text-amber-400"></iconify-icon>
            <span class="text-[10px] font-semibold text-amber-300">Setting</span>
        </button>
        <button onclick="openAddProductModal()" class="flex flex-col items-center gap-1.5 p-3 rounded-xl bg-pink-500/10 border border-pink-500/20 hover:bg-pink-500/20 transition-all">
            <iconify-icon icon="mdi:plus-circle" class="text-xl text-pink-400"></iconify-icon>
            <span class="text-[10px] font-semibold text-pink-300">+Produk</span>
        </button>
    </div>

    <div class="section-label">Transaksi Terbaru</div>
    <div class="neon-card overflow-hidden">
        <div class="overflow-x-auto">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Kode</th>
                        <th>Produk</th>
                        <th>Harga</th>
                        <th>Status</th>
                        <th>Waktu</th>
                    </tr>
                </thead>
                <tbody>
                    <% transactions.slice(0,8).forEach(t => { %>
                    <tr>
                        <td class="font-mono text-indigo-400 text-[11px]"><%= t.code %></td>
                        <td class="text-white max-w-[120px] truncate text-xs"><%= t.productName %></td>
                        <td class="text-emerald-400 font-bold whitespace-nowrap text-xs">Rp <%= (t.price/1000).toFixed(0) %>K</td>
                        <td>
                            <% if(t.status==='done'){ %><span class="badge badge-done">Done</span>
                            <% }else if(t.status==='failed'){ %><span class="badge badge-failed" title="<%= t.failReason || 'Gagal alokasi key' %>">❌ Gagal (Stok Habis)</span>
                            <% }else{ %><span class="badge badge-pending">Pending</span><% } %>
                        </td>
                        <td class="text-zinc-500 text-[11px] whitespace-nowrap"><%= t.time %></td>
                    </tr>
                    <% }) %>
                    <% if(!transactions.length){ %>
                    <tr><td colspan="5" class="text-center py-6 text-zinc-600 text-xs">Belum ada transaksi</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ── PRODUK ── -->
<div id="pane-products" class="tab-pane">
    <div class="flex items-center justify-between mb-2 gap-2">
        <div class="section-label mb-0" id="products-counter">Manajemen Produk (<%= products.length %>)</div>
        <div class="flex items-center gap-2">
            <button onclick="bulkSetAutoStock()" id="bulkSetAutoBtn" class="text-xs px-2.5 py-1.5 rounded-lg font-bold flex items-center gap-1"
                style="background:rgba(56,189,248,.12);border:1px solid rgba(56,189,248,.3);color:#7dd3fc"
                title="Ubah semua produk & varian ke sumber stok Auto (Reseller API) sekaligus, tanpa perlu buka Edit Produk satu-satu.">
                <iconify-icon icon="mdi:robot"></iconify-icon> Set Auto Semua
            </button>
            <button onclick="checkUnmappedAuto()" id="checkUnmappedBtn" class="text-xs px-2.5 py-1.5 rounded-lg font-bold flex items-center gap-1"
                style="background:rgba(251,191,36,.12);border:1px solid rgba(251,191,36,.3);color:#fbbf24"
                title="Cek varian mode Auto yang belum di-mapping manual ke produk provider (akan gagal checkout sampai di-mapping).">
                <iconify-icon icon="mdi:alert-circle"></iconify-icon> Cek Belum Mapping
            </button>
            <button onclick="openAddProductModal()" class="btn-primary text-xs">
                <iconify-icon icon="mdi:plus"></iconify-icon> Tambah
            </button>
        </div>
    </div>
    <p class="text-[10px] text-amber-500/80 mb-3">⚠ "Set Auto Semua" mengubah semua produk & varian jadi sumber stok Auto (Reseller API). <strong>Auto-cocokkan by nama sudah DIMATIKAN</strong> — tiap varian WAJIB di-mapping manual satu-satu ke produk provider di halaman Edit Produk, kalau tidak checkout-nya akan gagal (bukan salah kirim key). Mapping manual yang sudah ada tidak akan ditimpa.</p>
    <div class="space-y-2.5" id="products-list">
        <% products.forEach(p => {
            const pricing = p.pricingOptions || p.items?.map(i=>({days:parseInt((i.l.match(/(\d+)/)||[])[1]||0),price:i.p})) || [];
            const minPrice = pricing.length ? Math.min(...pricing.map(o=>o.price)) : 0;
            const pricingJson = JSON.stringify(pricing).replace(/"/g,'&quot;');
        %>
        <div class="prod-card fade-in" data-product-id="<%= p.id %>">
            <div class="w-12 h-12 rounded-xl overflow-hidden flex-shrink-0 border border-white/10 bg-indigo-500/10" id="prod-img-<%= p.id %>">
                <% if(p.image){ %>
                    <img src="<%= p.image %>" alt="<%= p.name %>" class="w-full h-full object-cover" loading="lazy"
                         onerror="this.style.display='none';this.parentNode.innerHTML='<div style=display:flex;align-items:center;justify-content:center;width:100%;height:100%><iconify-icon icon=\'mdi:gamepad-variant\' style=font-size:20px;color:#818cf8></iconify-icon></div>'">
                <% }else{ %>
                    <div class="w-full h-full flex items-center justify-center">
                        <iconify-icon icon="mdi:gamepad-variant" class="text-xl text-indigo-400"></iconify-icon>
                    </div>
                <% } %>
            </div>
            <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-0.5 flex-wrap">
                    <span class="text-sm font-semibold text-white truncate"><%= p.name %></span>
                    <span class="badge <%= p.status==='active'?'badge-done':'badge-inactive' %>"><%= p.status==='active'?'Aktif':'Off' %></span>
                </div>
                <div class="flex items-center gap-2 text-[10px] text-zinc-500 flex-wrap">
                    <span class="px-1.5 py-0.5 rounded bg-indigo-500/15 text-indigo-400 font-bold uppercase"><%= p.category %></span>
                    <span class="prod-key-count <%= (p.keys?.length||0)>0?'text-emerald-400':'text-red-400' %>">
                        <iconify-icon icon="mdi:key" class="align-middle"></iconify-icon> <%= p.keys?.length||0 %> key
                    </span>
                    <span><%= p.sold||0 %> terjual</span>
                    <span class="text-zinc-500 flex items-center gap-1 flex-wrap">
                        <% pricing.forEach(po => { %>
                        <span class="px-1.5 py-0.5 rounded text-[9px] font-bold <%= (p.keys||[]).filter(k => k.endsWith(':'+po.days)).length > 0 ? 'text-emerald-400 bg-emerald-500/10' : 'text-zinc-600 bg-zinc-800/50' %>">
                            <%= po.days %>d: <%= (p.keys||[]).filter(k => k.endsWith(':'+po.days)).length %>
                        </span>
                        <% }) %>
                        <% const genericCnt = (p.keys||[]).filter(k => !k.includes(':')).length; if (genericCnt > 0) { %>
                        <span class="px-1.5 py-0.5 rounded text-[9px] font-bold text-yellow-400 bg-yellow-500/10">G: <%= genericCnt %></span>
                        <% } %>
                    </span>
                </div>
                <% if(minPrice>0){ %>
                    <div class="text-[10px] text-indigo-400 font-bold mt-0.5">Mulai Rp <%= minPrice.toLocaleString('id-ID') %></div>
                <% } %>
            </div>
            <div class="flex flex-col gap-1.5 flex-shrink-0">
                <a href="/admin/product-edit?id=<%= p.id %>" class="btn-warning py-1 px-2 text-[10px] text-center">
                    <iconify-icon icon="mdi:pencil"></iconify-icon> Edit
                </a>
                <button
                    data-pid="<%= p.id %>"
                    data-name="<%= (p.name||'').replace(/\"/g,'&quot;') %>"
                    data-count="<%= p.keys?.length||0 %>"
                    onclick="openAddKeysModal(this.dataset.pid, this.dataset.name, parseInt(this.dataset.count))"
                    class="btn-success py-1 px-2 text-[10px]">
                    <iconify-icon icon="mdi:key-plus"></iconify-icon> Key
                </button>
                <button onclick="deleteProduct('<%= p.id %>')" class="btn-danger py-1 px-2 text-[10px]">
                    <iconify-icon icon="mdi:trash-can"></iconify-icon>
                </button>
            </div>
        </div>
        <% }) %>
        <% if(!products.length){ %>
        <div class="text-center py-10 text-zinc-600 text-xs">Belum ada produk. <button onclick="openAddProductModal()" class="text-indigo-400 underline">Tambah sekarang</button></div>
        <% } %>
    </div>
</div>

<!-- ── TRANSAKSI ── -->
<div id="pane-transactions" class="tab-pane">
    <div class="flex items-center justify-between mb-3">
        <div class="section-label mb-0">Semua Transaksi (<%= transactions.length %>)</div>
        <div class="flex gap-2">
            <button onclick="filterTrx('all')" id="trxf-all" class="trx-filter px-2.5 py-1 rounded-lg text-[10px] font-bold bg-indigo-500/20 border border-indigo-500/40 text-indigo-300">Semua</button>
            <button onclick="filterTrx('pending')" id="trxf-pending" class="trx-filter px-2.5 py-1 rounded-lg text-[10px] font-bold bg-white/3 border border-white/10 text-zinc-500">Pending</button>
            <button onclick="filterTrx('failed')" id="trxf-failed" class="trx-filter px-2.5 py-1 rounded-lg text-[10px] font-bold bg-white/3 border border-white/10 text-zinc-500">❌ Gagal</button>
            <button onclick="filterTrx('done')" id="trxf-done" class="trx-filter px-2.5 py-1 rounded-lg text-[10px] font-bold bg-white/3 border border-white/10 text-zinc-500">Done</button>
        </div>
    </div>
    <div class="space-y-2" id="trx-list">
        <% transactions.forEach(t => { %>
        <div class="neon-card p-3.5 fade-in trx-item" data-trx-id="<%= t.id %>" data-status="<%= t.status %>">
            <div class="flex items-start justify-between gap-2 mb-2">
                <div>
                    <div class="flex items-center gap-2">
                        <div class="text-[11px] font-mono font-bold text-indigo-400"><%= t.code %></div>
                        <% if(t.type==='reseller'){ %><span class="badge" style="background:rgba(234,179,8,.15);color:#fbbf24;border:1px solid rgba(234,179,8,.3)"><iconify-icon icon="mdi:crown" class="text-[9px]"></iconify-icon> Reseller</span><% } %>
                    </div>
                    <div class="text-sm font-semibold text-white mt-0.5"><%= t.productName %></div>
                </div>
                <% if(t.status==='done'){ %><span class="badge badge-done">Done</span>
                <% }else if(t.status==='failed'){ %><span class="badge badge-failed" id="trx-status-badge-<%= t.id %>">❌ Gagal (Stok Habis)</span>
                <% }else{ %><span class="badge badge-pending" id="trx-status-badge-<%= t.id %>">Pending</span><% } %>
            </div>
            <div class="grid grid-cols-2 gap-x-4 gap-y-1 mb-3">
                <div class="text-[10px] text-zinc-500">Customer: <span class="text-zinc-300"><%= t.customerName %></span></div>
                <div class="text-[10px] text-zinc-500">WA: <span class="text-zinc-300"><%= t.wa %></span></div>
                <div class="text-[10px] text-zinc-500">Harga: <span class="text-emerald-400 font-bold">Rp <%= t.price.toLocaleString('id-ID') %></span></div>
                <div class="text-[10px] text-zinc-500">Waktu: <span class="text-zinc-300"><%= t.time %></span></div>
                <% if(t.key){ %>
                <div class="text-[10px] text-zinc-500 col-span-2">Key: <span class="text-emerald-400 font-mono font-bold"><%= t.key %></span></div>
                <% } %>
                <% if(t.downloadLink){ %>
                <div class="text-[10px] text-zinc-500 col-span-2">Link: <a href="<%= t.downloadLink %>" target="_blank" rel="noopener" class="text-indigo-400 underline break-all"><%= t.downloadLink %></a></div>
                <% } %>
                <% if(t.status==='failed' && t.failReason){ %>
                <div class="text-[10px] text-red-400 col-span-2">Sebab: <%= t.failReason %></div>
                <% } %>
            </div>
            <div class="flex gap-2">
                <% if(t.status !== 'done'){ %>
                <button onclick="confirmTransaction('<%= t.id %>')" class="btn-success py-1 px-3 text-[10px]" id="trx-confirm-<%= t.id %>">
                    <iconify-icon icon="mdi:check-circle"></iconify-icon> Konfirmasi Bayar
                </button>
                <% } %>
                <button onclick="deleteTransaction('<%= t.id %>')" class="btn-danger py-1 px-3 text-[10px]">
                    <iconify-icon icon="mdi:trash-can"></iconify-icon>
                </button>
            </div>
        </div>
        <% }) %>
        <% if(!transactions.length){ %>
        <div class="text-center py-10 text-zinc-600 text-xs">Belum ada transaksi</div>
        <% } %>
    </div>
</div>

<!-- ── USERS ── -->
<div id="pane-users" class="tab-pane">
    <div class="flex items-center justify-between mb-3">
        <div class="section-label mb-0">Manajemen Users (<%= users.length %>)</div>
        <div class="text-[10px] text-zinc-600"><%= users.filter(u=>u.is_reseller).length %> reseller aktif</div>
    </div>
    <div class="space-y-2">
        <% users.forEach(u => { %>
        <div class="neon-card p-3.5 flex items-center gap-3 fade-in" data-user-id="<%= u.id %>">
            <div class="relative flex-shrink-0">
                <% if(u.photo){ %>
                    <img src="<%= u.photo %>" class="w-10 h-10 rounded-full object-cover border border-white/10">
                <% } else { %>
                    <div class="w-10 h-10 rounded-full flex items-center justify-center text-white font-black text-sm"
                         style="background:linear-gradient(135deg,#6366f1,#8b5cf6)">
                        <%= u.username.charAt(0).toUpperCase() %>
                    </div>
                <% } %>
                <% if(u.is_reseller){ %>
                    <div class="absolute -top-1 -right-1 w-4 h-4 rounded-full flex items-center justify-center" style="background:#fbbf24">
                        <iconify-icon icon="mdi:crown" class="text-[8px] text-black"></iconify-icon>
                    </div>
                <% } %>
            </div>
            <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2">
                    <div class="text-sm font-semibold text-white truncate"><%= u.username %></div>
                    <% if(u.is_reseller){ %>
                        <span class="badge" style="background:rgba(234,179,8,.15);color:#fbbf24;border:1px solid rgba(234,179,8,.3);font-size:9px">VIP</span>
                    <% } %>
                </div>
                <div class="text-[10px] text-zinc-500">WA: <%= u.wa %></div>
                <% if(u.is_reseller && u.reseller_code){ %>
                    <div class="text-[10px] font-mono text-yellow-500"><%= u.reseller_code %></div>
                <% } else { %>
                    <div class="text-[10px] text-zinc-600">Bergabung: <%= new Date(u.createdAt).toLocaleDateString('id-ID') %></div>
                <% } %>
            </div>
            <div class="flex flex-col gap-1.5 flex-shrink-0">
                <button onclick="toggleReseller('<%= u.id %>','<%= u.username %>')"
                    class="py-1 px-2 text-[10px] rounded-lg border transition-all font-semibold <%= u.is_reseller ? 'bg-yellow-500/15 border-yellow-500/30 text-yellow-400 hover:bg-yellow-500/25' : 'bg-white/5 border-white/15 text-zinc-400 hover:bg-indigo-500/15 hover:text-indigo-400 hover:border-indigo-500/30' %>"
                    id="reseller-btn-<%= u.id %>">
                    <iconify-icon icon="<%= u.is_reseller ? 'mdi:crown-off' : 'mdi:crown' %>"></iconify-icon>
                    <%= u.is_reseller ? 'Cabut' : 'Jadikan' %>
                </button>
                <button onclick="deleteUser('<%= u.id %>','<%= u.username %>')" class="btn-danger py-1 px-2 text-[10px]">
                    <iconify-icon icon="mdi:trash-can"></iconify-icon>
                </button>
            </div>
        </div>
        <% }) %>
        <% if(!users.length){ %>
        <div class="text-center py-10 text-zinc-600 text-xs">Belum ada user</div>
        <% } %>
    </div>
</div>

<!-- ── RESELLER DASHBOARD ── -->
<div id="pane-reseller" class="tab-pane">
    <div class="grid grid-cols-2 gap-3 mb-4">
        <div class="stat-card fade-in" style="background:linear-gradient(135deg,rgba(234,88,12,.1),rgba(194,65,12,.05));border-color:rgba(234,88,12,.25);">
            <div class="flex items-center justify-between mb-2">
                <span class="text-[10px] text-zinc-500 font-semibold uppercase tracking-wide">Reseller VIP</span>
                <iconify-icon icon="mdi:crown" class="text-orange-400 text-lg"></iconify-icon>
            </div>
            <div class="text-2xl font-black text-white font-orbitron"><%= stats.totalResellers || 0 %></div>
            <div class="text-[10px] text-orange-600 mt-1"><%= stats.resellerOrders || 0 %> order dari reseller</div>
        </div>
        <div class="stat-card fade-in" style="background:linear-gradient(135deg,rgba(234,179,8,.1),rgba(245,158,11,.05));border-color:rgba(234,179,8,.25);">
            <div class="flex items-center justify-between mb-2">
                <span class="text-[10px] text-zinc-500 font-semibold uppercase tracking-wide">Revenue Reseller</span>
                <iconify-icon icon="mdi:cash-multiple" class="text-yellow-400 text-lg"></iconify-icon>
            </div>
            <div class="text-lg font-black text-white font-orbitron">Rp <%= ((stats.resellerRevenue||0)/1000).toFixed(0) %>K</div>
            <div class="text-[10px] text-yellow-600 mt-1">dari order reseller</div>
        </div>
    </div>

    <!-- PAKET TOPUP SALDO (BONUS) -->
    <div class="flex items-center justify-between mb-3">
        <div class="section-label mb-0">Paket Topup Saldo</div>
        <button onclick="addTopupPackageRow()" class="text-[10px] font-bold px-2.5 py-1.5 rounded-lg" style="background:rgba(234,179,8,.12);border:1px solid rgba(234,179,8,.3);color:#fbbf24">
            <iconify-icon icon="mdi:plus"></iconify-icon> Tambah Paket
        </button>
    </div>
    <p class="text-[10px] text-zinc-600 mb-3">Reseller topup pas sama nominal ini dapet bonus tambahan otomatis. Kosongkan semua kalau gak mau pakai skema bonus.</p>
    <div class="neon-card p-3.5 mb-5">
        <div id="topupPackagesWrap" class="space-y-2 mb-3">
            <% (settings.resellerTopupPackages || []).forEach(pk => { %>
            <div class="flex items-center gap-1.5 topup-pkg-row" data-id="<%= pk.id %>">
                <input type="number" placeholder="Nominal" value="<%= pk.nominal %>" class="hm-input flex-1 text-xs py-1.5 pkg-nominal" style="padding:6px 10px;">
                <input type="number" placeholder="Bonus" value="<%= pk.bonus %>" class="hm-input flex-1 text-xs py-1.5 pkg-bonus" style="padding:6px 10px;">
                <button onclick="this.closest('.topup-pkg-row').remove()" class="py-1.5 px-2 rounded-lg" style="background:rgba(239,68,68,.12);border:1px solid rgba(239,68,68,.3);color:#f87171">
                    <iconify-icon icon="mdi:trash-can-outline" class="text-xs"></iconify-icon>
                </button>
            </div>
            <% }) %>
        </div>
        <button onclick="saveTopupPackages()" class="btn-primary text-[11px] w-full py-2">
            <iconify-icon icon="mdi:content-save"></iconify-icon> Simpan Paket Topup
        </button>
    </div>

    <div class="flex items-center justify-between mb-3">
        <div class="section-label mb-0">Saldo Reseller</div>
        <div class="text-[10px] text-zinc-600">Total: Rp <%= users.filter(u=>u.is_reseller).reduce((s,u)=>s+(u.balance||0),0).toLocaleString('id-ID') %></div>
    </div>
    <div class="space-y-2 mb-5">
        <% const resellers = users.filter(u => u.is_reseller); %>
        <% resellers.forEach(u => { %>
        <div class="neon-card p-3.5 fade-in" data-reseller-id="<%= u.id %>">
            <div class="flex items-center gap-3 mb-2.5">
                <% if(u.photo){ %>
                    <img src="<%= u.photo %>" class="w-9 h-9 rounded-full object-cover border border-white/10 flex-shrink-0">
                <% } else { %>
                    <div class="w-9 h-9 rounded-full flex items-center justify-center text-white font-black text-xs flex-shrink-0"
                         style="background:linear-gradient(135deg,#d97706,#fbbf24)"><%= u.username.charAt(0).toUpperCase() %></div>
                <% } %>
                <div class="flex-1 min-w-0">
                    <div class="text-sm font-semibold text-white truncate"><%= u.username %></div>
                    <div class="text-[10px] font-mono text-yellow-500"><%= u.reseller_code || '-' %></div>
                </div>
                <div class="text-right flex-shrink-0">
                    <div class="text-[9px] text-zinc-500 uppercase">Saldo</div>
                    <div class="text-sm font-black text-yellow-400 font-orbitron" id="bal-<%= u.id %>">Rp <%= (u.balance||0).toLocaleString('id-ID') %></div>
                </div>
            </div>
            <div class="flex items-center gap-1.5">
                <input type="number" placeholder="Nominal" class="hm-input flex-1 text-xs py-1.5" id="adj-input-<%= u.id %>" style="padding:6px 10px;">
                <button onclick="adjustBalance('<%= u.id %>','<%= u.username %>',1)" class="py-1.5 px-2.5 text-[10px] rounded-lg font-bold" style="background:rgba(16,185,129,.15);border:1px solid rgba(16,185,129,.3);color:#34d399">
                    <iconify-icon icon="mdi:plus"></iconify-icon> Tambah
                </button>
                <button onclick="adjustBalance('<%= u.id %>','<%= u.username %>',-1)" class="py-1.5 px-2.5 text-[10px] rounded-lg font-bold" style="background:rgba(239,68,68,.12);border:1px solid rgba(239,68,68,.3);color:#f87171">
                    <iconify-icon icon="mdi:minus"></iconify-icon> Kurangi
                </button>
            </div>
        </div>
        <% }) %>
        <% if(!resellers.length){ %>
        <div class="text-center py-8 text-zinc-600 text-xs">Belum ada reseller. Jadikan user reseller di tab Users.</div>
        <% } %>
    </div>

    <!-- HARGA RESELLER PER PRODUK -->
    <div class="flex items-center justify-between mb-3">
        <div class="section-label mb-0">Harga Reseller per Produk</div>
    </div>
    <p class="text-[10px] text-zinc-600 mb-3">Kosongkan buat pakai diskon global (<%= settings.resellerDiscount || 20 %>%). Isi manual kalau produk margin tipis biar gak rugi.</p>
    <div class="space-y-2.5">
        <% products.forEach(p => { %>
        <% if (p.pricingOptions && p.pricingOptions.length) { %>
        <div class="neon-card p-3.5 fade-in" data-rprice-product="<%= p.id %>">
            <div class="text-sm font-semibold text-white mb-2.5 truncate"><%= p.name %></div>
            <div class="space-y-2 mb-2.5">
                <% p.pricingOptions.forEach(o => {
                    const globalCalc = Math.round(o.price * (1 - (settings.resellerDiscount || 20) / 100));
                %>
                <div class="flex items-center gap-2 text-xs" data-days="<%= o.days %>">
                    <span class="text-zinc-400 w-16 flex-shrink-0"><%= o.days %> Hari</span>
                    <span class="text-zinc-600 w-24 flex-shrink-0 line-through">Rp<%= o.price.toLocaleString('id-ID') %></span>
                    <input type="number" class="hm-input flex-1 text-xs py-1.5 rprice-input" style="padding:6px 10px;"
                           placeholder="Rp<%= globalCalc.toLocaleString('id-ID') %> (default)"
                           value="<%= o.resellerPrice !== undefined ? o.resellerPrice : '' %>" min="0" max="<%= o.price %>">
                </div>
                <% }) %>
            </div>
            <button onclick="saveResellerPrice('<%= p.id %>','<%= p.name.replace(/'/g,"\\'") %>')" class="btn-primary text-[11px] w-full py-2">
                <iconify-icon icon="mdi:content-save"></iconify-icon> Simpan Harga Reseller
            </button>
        </div>
        <% } }) %>
        <% if(!products.filter(p=>p.pricingOptions?.length).length){ %>
        <div class="text-center py-8 text-zinc-600 text-xs">Belum ada produk dengan paket harga</div>
        <% } %>
    </div>
</div>

<!-- ── TESTIMONI ── -->
<div id="pane-testimonials" class="tab-pane">
    <div class="flex items-center justify-between mb-4">
        <div class="section-label mb-0">Testimoni</div>
        <button onclick="openModal('modal-testi')" class="btn-primary text-xs">
            <iconify-icon icon="mdi:plus"></iconify-icon> Tambah
        </button>
    </div>
    <div id="testi-list" class="space-y-2">
        <div class="text-center py-8 text-zinc-600">
            <iconify-icon icon="mdi:loading" class="text-2xl animate-spin block mx-auto mb-2 text-indigo-400"></iconify-icon>
            <p class="text-xs">Memuat...</p>
        </div>
    </div>
</div>

<!-- ── KEY POOL ── -->
<div id="pane-keys" class="tab-pane">

    <div class="flex items-center justify-between mb-4">
        <div class="section-label mb-0">Manajemen Key Lisensi</div>
        <span class="text-[10px] text-zinc-600" id="keyStatsLabel">—</span>
    </div>

    <!-- Form tambah / generate key -->
    <div class="neon-card p-4 mb-4">
        <div class="text-xs font-bold text-indigo-400 mb-3 flex items-center gap-2">
            <iconify-icon icon="mdi:key-plus" class="text-base"></iconify-icon> Tambah Key Manual
        </div>
        <div class="grid grid-cols-2 gap-2 mb-2">
            <div>
                <div class="setting-row-label">Kode Key</div>
                <input type="text" id="newKeyCode" class="hm-input font-mono uppercase" placeholder="HERO-001" maxlength="20" oninput="this.value=this.value.toUpperCase()">
            </div>
            <div>
                <div class="setting-row-label">Durasi (Hari)</div>
                <input type="number" id="newKeyDuration" class="hm-input" placeholder="30" min="1" max="9999">
            </div>
        </div>
        <div class="mb-2">
            <div class="setting-row-label">Label (opsional)</div>
            <input type="text" id="newKeyLabel" class="hm-input" placeholder="30 Hari Akses Premium">
        </div>
        <div class="mb-3">
            <div class="setting-row-label">Catatan (opsional)</div>
            <input type="text" id="newKeyNote" class="hm-input" placeholder="Untuk pelanggan paket...">
        </div>
        <button onclick="addKey()" class="btn-primary w-full">
            <iconify-icon icon="mdi:plus-circle"></iconify-icon> Tambah Key
        </button>
    </div>

    <!-- Generate otomatis -->
    <div class="neon-card p-4 mb-4">
        <div class="text-xs font-bold text-purple-400 mb-3 flex items-center gap-2">
            <iconify-icon icon="mdi:auto-fix" class="text-base"></iconify-icon> Generate Key Otomatis
        </div>
        <div class="grid grid-cols-3 gap-2 mb-2">
            <div>
                <div class="setting-row-label">Jumlah</div>
                <input type="number" id="genCount" class="hm-input" placeholder="5" min="1" max="100" value="5">
            </div>
            <div>
                <div class="setting-row-label">Durasi (Hari)</div>
                <input type="number" id="genDuration" class="hm-input" placeholder="30" min="1" value="30">
            </div>
            <div>
                <div class="setting-row-label">Prefix</div>
                <input type="text" id="genPrefix" class="hm-input uppercase" placeholder="KEY" maxlength="8" value="KEY" oninput="this.value=this.value.toUpperCase()">
            </div>
        </div>
        <button onclick="generateKeys()" class="btn-primary w-full" style="background:linear-gradient(135deg,#7c3aed,#a855f7)">
            <iconify-icon icon="mdi:lightning-bolt"></iconify-icon> Generate Keys
        </button>
        <div id="genResult" class="mt-2 hidden"></div>
    </div>

    <!-- Daftar key -->
    <div class="section-label">Daftar Key (<span id="keyTotal">0</span>)</div>
    <div class="space-y-2" id="keysList">
        <div class="text-center py-6 text-zinc-600 text-xs">
            <iconify-icon icon="mdi:loading" class="text-xl text-indigo-400 animate-spin block mx-auto mb-2"></iconify-icon>
            Memuat...
        </div>
    </div>
</div>

<!-- ── VOUCHERS ── -->
<div id="pane-vouchers" class="tab-pane">
    <div class="flex items-center justify-between mb-4">
        <div class="section-label mb-0">Manajemen Voucher Diskon</div>
        <span class="text-[10px] text-zinc-600" id="voucherStatsLabel">—</span>
    </div>

    <!-- Form tambah voucher -->
    <div class="neon-card p-4 mb-4">
        <div class="text-xs font-bold text-green-400 mb-3 flex items-center gap-2">
            <iconify-icon icon="mdi:ticket-percent" class="text-base"></iconify-icon> Tambah Voucher
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 mb-2">
            <div>
                <div class="setting-row-label">Kode Voucher</div>
                <input type="text" id="newVoucherCode" class="hm-input font-mono uppercase" placeholder="DISC30" maxlength="20" oninput="this.value=this.value.toUpperCase()">
            </div>
            <div>
                <div class="setting-row-label">Tipe</div>
                <select id="newVoucherType" class="hm-input">
                    <option value="percent">Persen (%)</option>
                    <option value="nominal">Nominal (Rp)</option>
                </select>
            </div>
            <div>
                <div class="setting-row-label">Nilai</div>
                <input type="number" id="newVoucherValue" class="hm-input" placeholder="10 / 5000" min="1">
            </div>
            <div>
                <div class="setting-row-label">Min. Belanja</div>
                <input type="number" id="newVoucherMin" class="hm-input" placeholder="0 (tanpa min)" min="0" value="0">
            </div>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 mb-2">
            <div>
                <div class="setting-row-label">Maks. Pemakaian</div>
                <input type="number" id="newVoucherMax" class="hm-input" placeholder="0 = tak terbatas" min="0" value="0">
            </div>
            <div>
                <div class="setting-row-label">Per User</div>
                <input type="number" id="newVoucherPerUser" class="hm-input" placeholder="1" min="1" value="1">
            </div>
            <div>
                <div class="setting-row-label">Kadaluarsa</div>
                <input type="date" id="newVoucherExpiry" class="hm-input">
            </div>
        </div>
        <div class="mb-3">
            <div class="setting-row-label">Deskripsi (opsional)</div>
            <input type="text" id="newVoucherDesc" class="hm-input" placeholder="Diskon 30% untuk semua produk">
        </div>
        <button onclick="addVoucher()" class="btn-primary w-full" style="background:linear-gradient(135deg,#059669,#10b981)">
            <iconify-icon icon="mdi:plus-circle"></iconify-icon> Buat Voucher
        </button>
    </div>

    <!-- Daftar voucher -->
    <div class="space-y-2" id="vouchersList">
        <div class="text-center py-6 text-zinc-600 text-xs">
            <iconify-icon icon="mdi:loading" class="text-xl text-indigo-400 animate-spin block mx-auto mb-2"></iconify-icon>
            Memuat...
        </div>
    </div>
</div>

<!-- ── SETTINGS ── -->
<div id="pane-settings" class="tab-pane">
    <div class="section-label mb-3">Pengaturan Situs</div>

    <!-- Status Database Supabase -->
    <div id="dbStatusCard" class="neon-card p-4 mb-3">
        <div class="text-xs font-bold text-emerald-400 mb-3 flex items-center gap-2">
            <iconify-icon icon="mdi:database"></iconify-icon> Status Database (Supabase)
        </div>
        <div id="dbStatusContent" class="text-xs text-zinc-400">Memeriksa koneksi...</div>
    </div>

    <!-- Info Situs -->
    <div class="neon-card p-5 mb-3">
        <div class="text-xs font-bold text-indigo-400 mb-4 flex items-center gap-2">
            <iconify-icon icon="mdi:information-outline"></iconify-icon> Informasi Situs
        </div>
        <form id="settingsForm" class="space-y-3">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                    <div class="setting-row-label">Nama Situs</div>
                    <input type="text" name="siteName" value="<%= settings.siteName %>" class="hm-input">
                </div>
                <div>
                    <div class="setting-row-label">Nama Game Panel</div>
                    <input type="text" name="gamePanelName" value="<%= settings.gamePanelName %>" class="hm-input">
                </div>
            </div>
            <div>
                <div class="setting-row-label">Deskripsi / About</div>
                <textarea name="about" rows="3" class="hm-input"><%= settings.about %></textarea>
            </div>
            <div>
                <div class="setting-row-label">Marquee Text (teks berjalan)</div>
                <input type="text" name="marqueeText" value="<%= settings.marqueeText %>" class="hm-input">
            </div>
            <div class="pt-2 border-t border-white/5">
                <div class="text-xs font-bold text-indigo-400 mb-3 flex items-center gap-2">
                    <iconify-icon icon="mdi:phone"></iconify-icon> Kontak
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-3">
                    <div>
                        <div class="setting-row-label">WhatsApp Owner (nomor)</div>
                        <input type="text" name="whatsapp" value="<%= settings.contact?.whatsapp||'' %>" class="hm-input" placeholder="628xxxxxxxxx">
                    </div>
                    <div>
                        <div class="setting-row-label">Saluran WhatsApp (link channel.whatsapp.com/...)</div>
                        <input type="text" name="whatsappChannel" value="<%= settings.contact?.whatsappChannel||'' %>" class="hm-input" placeholder="https://whatsapp.com/channel/...">
                    </div>
                    <div>
                        <div class="setting-row-label">Telegram</div>
                        <input type="text" name="telegram" value="<%= settings.contact?.telegram||'' %>" class="hm-input" placeholder="username">
                    </div>
                    <div>
                        <div class="setting-row-label">Email</div>
                        <input type="email" name="email" value="<%= settings.contact?.email||'' %>" class="hm-input">
                    </div>
                </div>
            </div>

            <!-- Cloudflare Turnstile -->
            <div class="pt-2 border-t border-white/5">
                <div class="text-xs font-bold text-yellow-400 mb-1 flex items-center gap-2">
                    <iconify-icon icon="mdi:shield-lock"></iconify-icon> Cloudflare Turnstile (Anti-Bot Login)
                </div>
                <p class="text-[10px] text-white/35 mb-3">Dapatkan Site Key & Secret Key di <a href="https://dash.cloudflare.com/?to=/:account/turnstile" target="_blank" class="text-indigo-400 underline">dash.cloudflare.com → Turnstile</a>. Kosongkan untuk menonaktifkan.</p>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <div class="setting-row-label">Turnstile Site Key (public)</div>
                        <input type="text" name="turnstileSiteKey" value="<%= settings.turnstile?.siteKey||'' %>" class="hm-input" placeholder="0x4AAA...">
                    </div>
                    <div>
                        <div class="setting-row-label">Turnstile Secret Key (private)</div>
                        <input type="password" name="turnstileSecretKey" value="<%= settings.turnstile?.secretKey||'' %>" class="hm-input" placeholder="0x4AAA...">
                    </div>
                </div>
            </div>
            <button type="submit" class="btn-primary w-full justify-center py-3 text-sm">
                <iconify-icon icon="mdi:content-save"></iconify-icon> Simpan Pengaturan
            </button>
        </form>
    </div>

    <!-- Kategori -->
    <div class="neon-card p-5 mb-3">
        <div class="text-xs font-bold text-indigo-400 mb-4 flex items-center gap-2">
            <iconify-icon icon="mdi:tag-multiple"></iconify-icon> Kategori Produk
        </div>
        <form id="categoryForm" class="space-y-3">
            <div>
                <div class="setting-row-label">Daftar kategori (satu per baris, format: id:Label)</div>
                <textarea name="categories" rows="6" class="hm-input font-mono text-xs"><% (settings.categories||[]).forEach(cat => { %><%= cat %>:<%= (settings.categoryLabels||{})[cat]||cat %>
<% }) %></textarea>
                <p class="text-[10px] text-zinc-600 mt-1">Contoh: freefire:FREE FIRE</p>
            </div>
            <button type="submit" class="btn-primary w-full justify-center py-2.5 text-sm">
                <iconify-icon icon="mdi:content-save"></iconify-icon> Simpan Kategori
            </button>
        </form>
    </div>

    <!-- BANNER CAROUSEL -->
    <div class="neon-card p-5 mb-3">
        <div class="text-xs font-bold text-indigo-400 mb-4 flex items-center gap-2">
            <iconify-icon icon="mdi:image-multiple"></iconify-icon> Banner Carousel
        </div>

        <!-- Form tambah banner -->
        <form id="bannerAddForm" enctype="multipart/form-data" class="space-y-3 mb-5" onsubmit="addBanner(event)">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                    <div class="setting-row-label">Judul Banner (opsional)</div>
                    <input type="text" name="title" class="hm-input" placeholder="Contoh: PROMO SPESIAL">
                </div>
                <div>
                    <div class="setting-row-label">Subjudul (opsional)</div>
                    <input type="text" name="subtitle" class="hm-input" placeholder="Contoh: Diskon 20% hari ini">
                </div>
            </div>
            <div>
                <div class="setting-row-label">Link klik banner (opsional)</div>
                <input type="text" name="link" class="hm-input" placeholder="Contoh: /buy/xxx atau https://...">
            </div>
            <div>
                <div class="setting-row-label">Gambar Banner</div>
                <input type="file" name="bannerImg" accept="image/jpeg,image/png,image/webp" class="hm-input text-xs py-2" onchange="previewBannerFile(event)">
                <div id="bannerFilePreview" class="mt-2 hidden">
                    <img id="bannerFileImg" src="" class="w-full h-28 object-cover rounded-xl border border-indigo-500/25">
                </div>
            </div>
            <div>
                <div class="setting-row-label">Atau URL gambar</div>
                <input type="text" name="imageUrl" class="hm-input" placeholder="https://..." oninput="previewBannerUrl(this.value)" id="bannerUrlInput">
            </div>
            <div id="bannerUrlPreview" class="hidden">
                <img id="bannerUrlImg" src="" class="w-full h-28 object-cover rounded-xl border border-indigo-500/25">
            </div>
            <button type="submit" id="bannerAddBtn" class="btn-primary w-full justify-center py-2.5 text-sm">
                <iconify-icon icon="mdi:plus-circle"></iconify-icon> Tambah Banner
            </button>
        </form>

        <!-- Daftar banner -->
        <div class="setting-row-label mb-3">Banner Aktif</div>
        <div id="bannerList" class="space-y-2">
            <div class="text-xs text-zinc-600 text-center py-3">Memuat...</div>
        </div>
    </div>

    <!-- QRIS Payment -->
    <div class="neon-card p-5 mb-3">
        <div class="text-xs font-bold text-indigo-400 mb-4 flex items-center gap-2">
            <iconify-icon icon="mdi:qrcode-scan"></iconify-icon> Pengaturan QRIS
        </div>

        <!-- Mode Selector -->
        <div class="flex gap-2 mb-4">
            <button type="button" id="modeStaticBtn" onclick="setQrisMode('static')"
                class="flex-1 py-2.5 rounded-xl text-xs font-bold border transition-all flex items-center justify-center gap-1.5
                <%= (settings.qrisMode||'static')==='static' ? 'bg-indigo-500/20 border-indigo-500/50 text-indigo-300' : 'bg-white/3 border-white/10 text-zinc-500' %>">
                <iconify-icon icon="mdi:image"></iconify-icon> Statis (Gambar)
            </button>
            <button type="button" id="modeApiBtn" onclick="setQrisMode('api')"
                class="flex-1 py-2.5 rounded-xl text-xs font-bold border transition-all flex items-center justify-center gap-1.5
                <%= (settings.qrisMode||'static')==='api' ? 'bg-indigo-500/20 border-indigo-500/50 text-indigo-300' : 'bg-white/3 border-white/10 text-zinc-500' %>">
                <iconify-icon icon="mdi:api"></iconify-icon> API (GensPay)
            </button>
        </div>

        <!-- QRIS Statis -->
        <div id="sectionStatic" class="<%= (settings.qrisMode||'static')==='static' ? '' : 'hidden' %>">
            <p class="text-[11px] text-zinc-500 mb-3">Upload foto QRIS dari rekening kamu (GoPay, DANA, OVO, atau QRIS Merchant). Pembayaran dikonfirmasi manual oleh admin.</p>
            <% if (settings.qrisStaticImage) { %>
            <div class="mb-3 flex flex-col items-center gap-2">
                <img src="<%= settings.qrisStaticImage %>?t=<%= Date.now() %>" class="rounded-xl border border-emerald-500/30" style="max-width:180px" id="qrisPreviewImg">
                <span class="text-[10px] text-emerald-400 flex items-center gap-1"><iconify-icon icon="mdi:check-circle"></iconify-icon> QRIS aktif</span>
            </div>
            <% } else { %>
            <div class="mb-3 p-4 rounded-xl bg-yellow-500/8 border border-yellow-500/20 text-center">
                <iconify-icon icon="mdi:alert-circle-outline" class="text-yellow-400 text-2xl mb-1 block"></iconify-icon>
                <p class="text-[11px] text-yellow-400">Belum ada gambar QRIS. Upload sekarang.</p>
            </div>
            <% } %>
            <form id="qrisStaticForm" enctype="multipart/form-data" class="space-y-2">
                <input type="file" name="qrisImage" accept="image/jpeg,image/png,image/webp" class="hm-input text-xs py-2">
                <button type="submit" class="btn-primary w-full justify-center py-2.5 text-sm">
                    <iconify-icon icon="mdi:upload"></iconify-icon> Upload Gambar QRIS
                </button>
            </form>
        </div>

        <!-- GensPay API -->
        <div id="sectionApi" class="<%= (settings.qrisMode||'static')==='api' ? '' : 'hidden' %> space-y-3">
            <div class="p-3 rounded-xl bg-indigo-500/8 border border-indigo-500/20 text-[11px] text-indigo-300 mb-2">
                <iconify-icon icon="mdi:information-outline"></iconify-icon> Kredensial GensPay diatur lewat environment variable server (<code class="font-mono">GENSPAY_BASE_URL</code> &amp; <code class="font-mono">GENSPAY_API_KEY</code>), bukan dari panel ini — demi keamanan API key. Cukup pastikan sudah diisi di Vercel/hosting kamu, lalu test koneksi di bawah.
            </div>

            <!-- Webhook URL (auto-detect dari domain aktif) -->
            <div class="flex flex-col gap-1.5 p-3 rounded-xl bg-amber-500/8 border border-amber-500/20">
                <div class="text-[11px] text-amber-300 font-bold flex items-center gap-1">
                    <iconify-icon icon="mdi:webhook"></iconify-icon> Webhook URL untuk didaftarkan di GensPay
                </div>
                <div class="text-[10px] text-zinc-500 leading-relaxed">
                    Paste URL ini ke dashboard/Telegram bot GensPay kamu supaya pembayaran sukses otomatis menyelesaikan transaksi (tanpa ini, admin harus verifikasi manual satu-satu). URL ini otomatis mengikuti domain yang sedang aktif -- kalau domain pernah pindah, buka halaman ini lagi untuk lihat URL yang benar sekarang.
                </div>
                <div class="flex items-center gap-1.5 mt-1">
                    <input id="genspayWebhookUrlInput" type="text" readonly value="<%= genspayWebhookUrl %>"
                        class="flex-1 min-w-0 text-[11px] font-mono px-2.5 py-2 rounded-lg bg-black/30 border border-white/10 text-zinc-300 truncate">
                    <button type="button" onclick="copyGenspayWebhookUrl()"
                        class="flex-shrink-0 px-3 py-2 rounded-lg text-[11px] font-bold text-amber-300 border border-amber-500/30 bg-amber-500/10 hover:bg-amber-500/20 transition-all flex items-center gap-1">
                        <iconify-icon icon="mdi:content-copy"></iconify-icon> Copy
                    </button>
                </div>
            </div>

            <!-- Status Env Var -->
            <div class="flex flex-col gap-1.5 p-3 rounded-xl bg-white/3 border border-white/10">
                <div class="flex items-center justify-between text-[11px]">
                    <span class="text-zinc-400 font-mono">GENSPAY_BASE_URL</span>
                    <% if (genspayConfigured.baseUrl) { %>
                    <span class="text-emerald-400 font-bold flex items-center gap-1"><iconify-icon icon="mdi:check-circle"></iconify-icon> Terisi</span>
                    <% } else { %>
                    <span class="text-red-400 font-bold flex items-center gap-1"><iconify-icon icon="mdi:close-circle"></iconify-icon> Kosong</span>
                    <% } %>
                </div>
                <% if (genspayConfigured.baseUrl) { %>
                <div class="text-[10px] text-zinc-600 font-mono truncate"><%= genspayConfigured.baseUrlPreview %></div>
                <% } %>
                <div class="flex items-center justify-between text-[11px] mt-1">
                    <span class="text-zinc-400 font-mono">GENSPAY_API_KEY</span>
                    <% if (genspayConfigured.apiKey) { %>
                    <span class="text-emerald-400 font-bold flex items-center gap-1"><iconify-icon icon="mdi:check-circle"></iconify-icon> Terisi</span>
                    <% } else { %>
                    <span class="text-red-400 font-bold flex items-center gap-1"><iconify-icon icon="mdi:close-circle"></iconify-icon> Kosong</span>
                    <% } %>
                </div>
            </div>
            <% if (!genspayConfigured.baseUrl || !genspayConfigured.apiKey) { %>
            <div class="p-2.5 rounded-lg bg-red-500/10 border border-red-500/20 text-[11px] text-red-400 flex items-start gap-1.5">
                <iconify-icon icon="mdi:alert" class="mt-0.5 flex-shrink-0"></iconify-icon>
                <span>Belum lengkap. Tambahkan env var yang kosong di pengaturan hosting/Vercel kamu, lalu redeploy sebelum test koneksi.</span>
            </div>
            <% } %>

            <button type="button" onclick="testPakasir()" class="w-full py-2 rounded-xl text-xs font-bold text-zinc-400 border border-white/10 bg-white/3 hover:bg-white/8 transition-all flex items-center justify-center gap-1.5">
                <iconify-icon icon="mdi:wifi-check"></iconify-icon> Test Koneksi GensPay
            </button>
            <div id="testResult" class="hidden text-[11px] p-2.5 rounded-lg"></div>
        </div>

        <!-- Simpan Mode -->
        <input type="hidden" id="qrisModeVal" value="<%= settings.qrisMode||'static' %>">
    </div>

    <!-- Reseller API (Auto Stock) — porting dari GNE, metode identik:
         HMAC-SHA256 signing, auto-match by nama produk + hari, mapping
         per-varian di halaman Edit Produk. -->
    <div class="neon-card p-5 mb-3" style="border-color:rgba(56,189,248,.25)">
        <div class="text-xs font-bold mb-1 flex items-center gap-2" style="color:#38bdf8">
            <iconify-icon icon="mdi:cloud-sync"></iconify-icon> Reseller API (Auto Stock Produk)
        </div>
        <p class="text-[11px] text-zinc-500 mb-4">Buat produk dengan sumber stok <strong class="text-cyan-400">Auto</strong> yang key-nya di-generate otomatis lewat API provider saat ada pembelian — tidak perlu upload key manual. Atur kredensial di sini, lalu pilih sumber stok per-varian di halaman <strong>Edit Produk</strong>.</p>

        <div class="p-3 rounded-xl bg-red-500/8 border border-red-500/20 text-[11px] text-red-400 mb-4 flex items-start gap-1.5">
            <iconify-icon icon="mdi:alert" class="mt-0.5 flex-shrink-0"></iconify-icon>
            <span>API Key &amp; Secret ini bisa dipakai memotong saldo reseller kamu di provider. Jangan pernah bagikan lewat chat/screenshot. Kalau pernah bocor, regenerate dulu dari dashboard provider sebelum dipakai di sini.</span>
        </div>

        <form id="resellerApiForm" class="space-y-3">
            <div>
                <div class="setting-row-label">Base URL API</div>
                <input type="text" name="baseUrl" class="hm-input text-xs font-mono" placeholder="https://vipibmstore.com/api/reseller" value="<%= settings.resellerApi?.baseUrl || 'https://vipibmstore.com/api/reseller' %>">
            </div>
            <div>
                <div class="setting-row-label">API Key (rpk_live_...)</div>
                <input type="text" name="apiKey" class="hm-input text-xs font-mono" placeholder="rpk_live_..." value="<%= settings.resellerApi?.apiKey || '' %>">
            </div>
            <div>
                <div class="setting-row-label">API Secret (rsk_live_...)</div>
                <input type="password" name="apiSecret" class="hm-input text-xs font-mono" placeholder="rsk_live_..." value="<%= settings.resellerApi?.apiSecret || '' %>">
            </div>
            <button type="button" onclick="testResellerApi()" class="w-full py-2 rounded-xl text-xs font-bold text-zinc-400 border border-white/10 bg-white/3 hover:bg-white/8 transition-all flex items-center justify-center gap-1.5">
                <iconify-icon icon="mdi:wifi-check"></iconify-icon> Test Koneksi &amp; Cek Saldo
            </button>
            <div id="resellerApiTestResult" class="hidden text-[11px] p-2.5 rounded-lg"></div>
            <button type="submit" class="btn-primary w-full justify-center py-2.5 text-sm">
                <iconify-icon icon="mdi:content-save"></iconify-icon> Simpan Kredensial Reseller API
            </button>
        </form>
        <button type="button" onclick="debugResellerApi()" class="w-full mt-2 py-2 rounded-xl text-[11px] font-bold text-amber-400 border border-amber-500/20 bg-amber-500/5 hover:bg-amber-500/10 transition-all flex items-center justify-center gap-1.5">
            <iconify-icon icon="mdi:bug-check"></iconify-icon> Auto Restock tidak jalan? Cek sumber kredensial
        </button>
        <div id="resellerApiDebugResult" class="hidden text-[11px] p-2.5 rounded-lg mt-2 font-mono whitespace-pre-wrap"></div>
    </div>

    <!-- ═══ MULTI-PROVIDER RESELLER API (baru, terpisah dari kredensial di atas) ═══
         Arsitektur adapter/plugin: tambah provider baru tanpa ubah kode inti.
         Lihat providers/ dan provider-store.js. -->
    <div class="neon-card p-5 mb-3" style="border-color:rgba(168,85,247,.25)">
        <div class="text-xs font-bold mb-1 flex items-center gap-2" style="color:#a855f7">
            <iconify-icon icon="mdi:source-branch"></iconify-icon> Multi-Provider Reseller API
        </div>
        <p class="text-[11px] text-zinc-500 mb-4">Kelola lebih dari satu provider reseller sekaligus. Tiap provider punya API Key & endpoint sendiri, bisa di-sync manual/otomatis, dan aktivitasnya tercatat di Log API.</p>

        <div id="providersList" class="space-y-3 mb-3"></div>

        <button type="button" onclick="openAddProviderModal()" class="w-full py-2.5 rounded-xl text-xs font-bold text-purple-400 border border-purple-500/30 hover:bg-purple-500/10 transition-all flex items-center justify-center gap-1.5">
            <iconify-icon icon="mdi:plus-circle"></iconify-icon> Tambah Provider Baru
        </button>
        <button type="button" onclick="openProviderLogsModal(null)" class="w-full mt-2 py-2 rounded-xl text-[11px] font-bold text-zinc-400 border border-white/10 bg-white/3 hover:bg-white/8 transition-all flex items-center justify-center gap-1.5">
            <iconify-icon icon="mdi:text-box-search-outline"></iconify-icon> Log API (Semua Provider)
        </button>
    </div>

    <!-- Login with Google (OAuth) -->
    <div class="neon-card p-5 mb-3" style="border-color:rgba(234,67,53,.25)">
        <div class="text-xs font-bold mb-4 flex items-center gap-2" style="color:#ea4335">
            <iconify-icon icon="mdi:google"></iconify-icon> Login dengan Google
        </div>
        <p class="text-[11px] text-zinc-500 mb-4">Izinkan pengunjung masuk pakai akun Google, tanpa perlu daftar manual. Buat kredensial di <a href="https://console.cloud.google.com/apis/credentials" target="_blank" class="text-red-400 underline">Google Cloud Console</a>, lalu set Authorized redirect URI ke: <code class="text-[10px] bg-black/30 px-1 py-0.5 rounded" id="googleRedirectUriHint"></code></p>
        <form id="googleForm" class="space-y-3">
            <div>
                <div class="setting-row-label">Client ID</div>
                <input type="text" name="clientId" value="<%= settings.google?.clientId||'' %>" class="hm-input font-mono text-xs" placeholder="xxxxx.apps.googleusercontent.com">
            </div>
            <div>
                <div class="setting-row-label">Client Secret <span class="text-zinc-600 font-normal">(kosongkan jika tidak ingin mengubah)</span></div>
                <input type="password" name="clientSecret" value="" class="hm-input font-mono text-xs" placeholder="<%= settings.google?.clientSecret ? '••••••••••••••••' : 'masukkan Client Secret' %>">
            </div>
            <button type="submit" class="btn-primary w-full justify-center py-2.5 text-sm">
                <iconify-icon icon="mdi:content-save"></iconify-icon> Simpan Pengaturan Google
            </button>
        </form>
        <div id="googleSaveResult" class="hidden text-[11px] p-2.5 rounded-lg mt-2"></div>
    </div>

    <!-- NOWPayments (Crypto USDT — Pembayaran Luar Negeri) -->
    <div class="neon-card p-5 mb-3" style="border-color:rgba(16,185,129,.25)">
        <div class="text-xs font-bold mb-4 flex items-center gap-2" style="color:#34d399">
            <iconify-icon icon="mdi:currency-usd"></iconify-icon> NOWPayments — Crypto USDT (Pembayaran Luar Negeri)
        </div>
        <div class="p-3 rounded-xl bg-red-500/8 border border-red-500/20 text-[11px] text-red-400 mb-4">
            <iconify-icon icon="mdi:alert"></iconify-icon> API Key &amp; IPN Secret rahasia — jangan dibagikan ke siapapun. Test koneksi sebelum menyimpan.
        </div>
        <form id="nowpaymentsForm" class="space-y-3">
            <div>
                <div class="setting-row-label">API Key</div>
                <input type="text" name="apiKey" value="<%= settings.nowpayments?.apiKey||'' %>" class="hm-input font-mono text-xs" placeholder="API Key dari dashboard NOWPayments">
            </div>
            <div>
                <div class="setting-row-label">IPN Secret Key <span class="text-zinc-600 font-normal">(kosongkan jika tidak ingin mengubah)</span></div>
                <input type="password" name="ipnSecret" value="" class="hm-input font-mono text-xs" placeholder="<%= settings.nowpayments?.ipnSecret ? '••••••••••••••••' : 'masukkan IPN Secret Key' %>">
            </div>
            <div>
                <div class="setting-row-label">Koin Pembayaran <span class="text-zinc-600 font-normal">(kode koin NOWPayments)</span></div>
                <input type="text" name="payCurrency" value="<%= settings.nowpayments?.payCurrency || 'usdtt' %>" class="hm-input font-mono text-xs" placeholder="usdtt (USDT TRC20/Tron)">
            </div>
            <button type="button" onclick="testNowpayments()" class="w-full py-2 rounded-xl text-xs font-bold text-zinc-400 border border-white/10 bg-white/3 hover:bg-white/8 transition-all flex items-center justify-center gap-1.5">
