        if (!d.data.length) { wrap.innerHTML = `<div class="text-center py-6 text-zinc-600 text-xs">Belum ada partner. Klik "Tambah Partner Baru" untuk mulai.</div>`; return; }

        wrap.innerHTML = d.data.map(p => `
