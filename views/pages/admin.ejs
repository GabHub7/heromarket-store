async function debugResellerApi() {
    const el = document.getElementById('resellerApiDebugResult');
    el.className = 'text-[11px] p-2.5 rounded-lg mt-2 font-mono whitespace-pre-wrap bg-indigo-500/10 border border-indigo-500/20 text-indigo-300';
    el.textContent = 'Mengecek...';
    el.classList.remove('hidden');
    const d = await api('/admin/reseller-api/debug', {});
    if (!d.success) {
        el.className = 'text-[11px] p-2.5 rounded-lg mt-2 font-mono whitespace-pre-wrap bg-red-500/10 border border-red-500/20 text-red-400';
        el.textContent = '✗ ' + (d.message || 'Gagal cek');
        return;
    }
    const lines = [];
    lines.push(`Sumber kredensial aktif: ${d.activeSource}`);
    lines.push(`Ada di database (panel admin): ${d.dbConfigured ? 'YA' : 'tidak'}`);
    lines.push(`Ada di env var (RESELLER_API_KEY/SECRET): ${d.envConfigured ? 'YA' : 'tidak'}`);
    if (d.note) lines.push('\n⚠️  ' + d.note);
    if (d.debug?.response) {
        lines.push(`\nTes request ke provider: HTTP ${d.debug.response.statusCode}`);
        if (d.debug.response.parsed?.message) lines.push('Pesan: ' + d.debug.response.parsed.message);
    } else if (d.debug?.error) {
        lines.push(`\nError: ${d.debug.error}`);
    }
    const ok = d.debug?.response?.statusCode >= 200 && d.debug?.response?.statusCode < 300;
    el.className = `text-[11px] p-2.5 rounded-lg mt-2 font-mono whitespace-pre-wrap ${ok ? 'bg-emerald-500/10 border border-emerald-500/20 text-emerald-300' : 'bg-amber-500/10 border border-amber-500/20 text-amber-300'}`;
    el.textContent = lines.join('\n');
}

