<!-- Modal: Sync / Import Produk dari Provider -->
<div id="modal-sync-provider" class="modal-wrap">
    <div class="modal-bg" onclick="closeModal('modal-sync-provider')"></div>
    <div class="modal-box">
        <div class="modal-handle"></div>
        <div class="p-5">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-sm font-bold text-white flex items-center gap-2">
                    <iconify-icon icon="mdi:cloud-sync" class="text-purple-400"></iconify-icon> Sync Produk
                </h3>
                <button onclick="closeModal('modal-sync-provider')" class="w-7 h-7 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-zinc-400">
                    <iconify-icon icon="mdi:close"></iconify-icon>
                </button>
            </div>
            <div id="syncProviderStatus" class="text-[11px] text-zinc-500 mb-3">Mengambil daftar produk dari provider...</div>
