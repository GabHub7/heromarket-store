<script>
// ── TOAST ──
function toast(msg, type='info') {
    const styles = {
        success: 'border-green-500/40 text-green-300',
        error:   'border-red-500/40 text-red-300',
        info:    'border-indigo-500/40 text-indigo-300',
        warn:    'border-yellow-500/40 text-yellow-300'
    };
    const icons = { success:'mdi:check-circle', error:'mdi:alert-circle', info:'mdi:information', warn:'mdi:alert' };
    const el = document.createElement('div');
    el.className = `toast ${styles[type]||styles.info}`;
    el.innerHTML = `<iconify-icon icon="${icons[type]||icons.info}" class="text-base flex-shrink-0"></iconify-icon><span>${msg}</span>`;
    document.getElementById('toast-container').appendChild(el);
    setTimeout(() => { el.style.opacity='0'; el.style.transition='opacity .3s'; setTimeout(()=>el.remove(),300); }, 3000);
}

// ── LOGOUT ──
function clearAndLogout(e) {
    e.preventDefault();
    localStorage.removeItem('hm_cart');
    localStorage.removeItem('shownNotifs');
    window.location.href = '/logout';
}

// ── CEK STATUS DATABASE (SUPABASE) ──
(async function checkDbStatus() {
    try {
        const r = await fetch('/admin/db-status');
        const d = await r.json();
        const alertEl = document.getElementById('binid-alert');
        const msgEl   = document.getElementById('binid-msg');
        const content = document.getElementById('dbStatusContent');

        if (!d.tableExists && d.connected) {
            if (d.canAutoCreate) { /* akan auto-create via ensureTableExists */ }
            if (alertEl) { alertEl.classList.remove('hidden'); msgEl.innerHTML =`⚠️ SUPABASE_URL / SUPABASE_ANON_KEY belum di-set di Vercel! Data tidak akan tersimpan.`; }
            if (content) content.innerHTML = `<div class="flex items-start gap-2 text-red-400"><iconify-icon icon="mdi:alert-circle" class="text-base flex-shrink-0 mt-0.5"></iconify-icon><div><strong>Supabase belum dikonfigurasi!</strong><br>Set <code class="bg-black/30 px-1 rounded">SUPABASE_URL</code> dan <code class="bg-black/30 px-1 rounded">SUPABASE_ANON_KEY</code> di Vercel Environment Variables.</div></div>`;
        } else if (!d.connected) {
            if (alertEl) { alertEl.classList.remove('hidden'); msgEl.innerHTML = `⚠️ Gagal konek ke Supabase. Cek env vars di Vercel.`; }
            if (content) content.innerHTML = `<div class="text-red-400">Gagal terkoneksi ke Supabase. Periksa SUPABASE_URL dan SUPABASE_ANON_KEY.</div>`;
        } else {
            if (content) content.innerHTML = `<div class="flex items-center gap-2 text-emerald-400"><iconify-icon icon="mdi:check-circle" class="text-base"></iconify-icon><div>Database terhubung ke Supabase PostgreSQL.<br><span class="text-zinc-500">Project: <code class="text-zinc-400">${d.projectUrl || '—'}</code></span></div></div>`;
        }
    } catch(e) {}
})();

// ── TAB SWITCH ──
function switchTab(name) {
    document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));
    document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
    document.getElementById('pane-'+name).classList.add('active');
    const nb = document.getElementById('nav-'+name);
    if (nb) nb.classList.add('active');
    window.scrollTo({top:0,behavior:'smooth'});
    if (name === 'testimonials') loadTestimonials();
    if (name === 'keys') loadKeys();
    if (name === 'vouchers') loadVouchers();
    if (name === 'settings') loadPartners();
    history.replaceState(null, '', '/admin#' + name);
}

// ── HASH ROUTING: auto switch tab dari URL hash ──
document.addEventListener('DOMContentLoaded', () => {
    const validTabs = ['dashboard','products','transactions','users','testimonials','settings','keys','vouchers','reseller'];
    const hash = window.location.hash.replace('#', '');
    if (validTabs.includes(hash)) switchTab(hash);
});

// ── MODAL ──
function openModal(id) { document.getElementById(id).classList.add('open'); document.body.style.overflow='hidden'; }
function closeModal(id) { document.getElementById(id).classList.remove('open'); document.body.style.overflow=''; }
// (openAddProductModal, openEditProductModal, openAddKeysModal defined above)
document.addEventListener('keydown', e => {
    if (e.key === 'Escape') document.querySelectorAll('.modal-wrap.open').forEach(m => m.classList.remove('open'));
});

// ── API helper ──
async function api(url, data) {
    const r = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
    });
    return r.json();
}

// ── MULTI-PROVIDER RESELLER API ──
let providerAdapters = [];
let currentSyncProviderId = null;

async function loadProviders() {
    const wrap = document.getElementById('providersList');
    if (!wrap) return;
    try {
        const res = await fetch('/admin/providers');
        const d = await res.json();
        if (!d.success) { wrap.innerHTML = `<div class="text-center py-6 text-red-400 text-xs">${d.message || 'Gagal memuat provider'}</div>`; return; }
        if (!d.data.length) { wrap.innerHTML = `<div class="text-center py-6 text-zinc-600 text-xs">Belum ada provider. Klik "Tambah Provider Baru" untuk mulai.</div>`; return; }

        wrap.innerHTML = d.data.map(p => {
            const syncBadge = p.lastSyncStatus === 'success'
                ? `<span class="text-[10px] text-emerald-400">✓ Sync terakhir berhasil</span>`
                : p.lastSyncStatus === 'failed'
                ? `<span class="text-[10px] text-red-400">✕ Sync terakhir gagal</span>`
                : `<span class="text-[10px] text-zinc-600">Belum pernah sync</span>`;
            return `
            <div class="p-3.5 rounded-xl border ${p.active ? 'border-purple-500/25 bg-purple-500/5' : 'border-white/10 bg-white/3'}">
                <div class="flex items-center justify-between mb-1.5">
                    <div class="text-xs font-bold text-white flex items-center gap-1.5">
                        <iconify-icon icon="mdi:${p.active ? 'check-circle' : 'pause-circle'}" class="${p.active ? 'text-emerald-400' : 'text-zinc-500'}"></iconify-icon>
                        ${escapeHtml(p.name)}
                    </div>
                    <button onclick="toggleProviderActive('${p.id}', ${!p.active})" class="text-[10px] px-2 py-1 rounded-lg border border-white/10 text-zinc-400">${p.active ? 'Nonaktifkan' : 'Aktifkan'}</button>
                </div>
                <div class="text-[10px] text-zinc-500 mb-2">${escapeHtml(p.adapterId)} · ${syncBadge}</div>
                <div class="grid grid-cols-2 gap-1.5">
                    <button onclick="testProviderConnection('${p.id}')" class="text-[10px] py-1.5 rounded-lg border border-white/10 text-zinc-300 flex items-center justify-center gap-1"><iconify-icon icon="mdi:wifi-check"></iconify-icon> Test Koneksi</button>
                    <button onclick="openSyncProviderModal('${p.id}')" class="text-[10px] py-1.5 rounded-lg border border-purple-500/25 text-purple-300 flex items-center justify-center gap-1"><iconify-icon icon="mdi:cloud-sync"></iconify-icon> Manual Sync</button>
                    <button onclick="openProviderLogsModal('${p.id}')" class="text-[10px] py-1.5 rounded-lg border border-white/10 text-zinc-300 flex items-center justify-center gap-1"><iconify-icon icon="mdi:text-box-search-outline"></iconify-icon> Log API</button>
                    <button onclick="deleteProviderInstance('${p.id}', '${escapeHtml(p.name)}')" class="text-[10px] py-1.5 rounded-lg border border-red-500/25 text-red-400 flex items-center justify-center gap-1"><iconify-icon icon="mdi:trash-can-outline"></iconify-icon> Hapus</button>
                </div>
                <div id="providerTestResult-${p.id}" class="hidden text-[10px] p-2 rounded-lg mt-2"></div>
            </div>`;
        }).join('');
    } catch (e) {
        wrap.innerHTML = `<div class="text-center py-6 text-red-400 text-xs">Gagal memuat: ${e.message}</div>`;
    }
}

async function openAddProviderModal() {
    if (!providerAdapters.length) {
        const res = await fetch('/admin/providers/adapters');
        const d = await res.json();
        if (d.success) providerAdapters = d.data;
    }
    const select = document.getElementById('addProviderAdapterSelect');
    select.innerHTML = providerAdapters.map(a => `<option value="${a.id}">${escapeHtml(a.label)}</option>`).join('');
    document.getElementById('addProviderName').value = '';
    document.getElementById('addProviderResult').classList.add('hidden');
    renderAddProviderFields();
    openModal('modal-add-provider');
}

function renderAddProviderFields() {
    const adapterId = document.getElementById('addProviderAdapterSelect').value;
    const adapter = providerAdapters.find(a => a.id === adapterId);
    const wrap = document.getElementById('addProviderConfigFields');
    if (!adapter) { wrap.innerHTML = ''; return; }
    wrap.innerHTML = adapter.configFields.map(f => `
        <div>
            <div class="setting-row-label">${escapeHtml(f.label)}${f.required ? ' *' : ''}</div>
            <input type="${f.type === 'password' ? 'password' : 'text'}" id="addProviderField-${f.key}" class="hm-input text-xs font-mono" placeholder="${f.default ? escapeHtml(f.default) : ''}" value="${f.default || ''}">
        </div>
    `).join('');
}

async function submitAddProvider() {
    const adapterId = document.getElementById('addProviderAdapterSelect').value;
    const adapter = providerAdapters.find(a => a.id === adapterId);
    const name = document.getElementById('addProviderName').value.trim();
    const config = {};
    let missingRequired = false;
    adapter.configFields.forEach(f => {
        const val = document.getElementById(`addProviderField-${f.key}`).value.trim();
        if (f.required && !val) missingRequired = true;
        if (val) config[f.key] = val;
    });
    const el = document.getElementById('addProviderResult');
    if (missingRequired) {
        el.className = 'text-[11px] p-2.5 rounded-lg bg-red-500/10 border border-red-500/20 text-red-400';
        el.textContent = 'Lengkapi field yang wajib diisi (*)';
        el.classList.remove('hidden');
        return;
    }
    const d = await api('/admin/providers', { adapterId, name, config });
    if (d.success) {
        toast('Provider berhasil ditambahkan!', 'success');
        closeModal('modal-add-provider');
        loadProviders();
    } else {
        el.className = 'text-[11px] p-2.5 rounded-lg bg-red-500/10 border border-red-500/20 text-red-400';
        el.textContent = d.message || 'Gagal menambahkan provider';
        el.classList.remove('hidden');
    }
}

async function toggleProviderActive(id, active) {
    const r = await fetch(`/admin/providers/${id}`, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ active }) });
    const d = await r.json();
    if (d.success) { toast(active ? 'Provider diaktifkan' : 'Provider dinonaktifkan', 'success'); loadProviders(); }
    else toast(d.message || 'Gagal update provider', 'error');
}

async function deleteProviderInstance(id, name) {
    if (!confirm(`Hapus provider "${name}"? Produk yang sudah di-import tidak akan terhapus, tapi tidak akan bisa auto-sync lagi.`)) return;
    const r = await fetch(`/admin/providers/${id}`, { method: 'DELETE' });
    const d = await r.json();
    if (d.success) { toast('Provider dihapus', 'success'); loadProviders(); }
    else toast(d.message || 'Gagal menghapus provider', 'error');
}

async function testProviderConnection(id) {
    const el = document.getElementById(`providerTestResult-${id}`);
    el.className = 'text-[10px] p-2 rounded-lg mt-2 bg-indigo-500/10 border border-indigo-500/20 text-indigo-300';
    el.textContent = 'Menguji koneksi...';
    el.classList.remove('hidden');
    const d = await api(`/admin/providers/${id}/test`, {});
    el.className = `text-[10px] p-2 rounded-lg mt-2 ${d.success ? 'bg-emerald-500/10 border border-emerald-500/20 text-emerald-300' : 'bg-red-500/10 border border-red-500/20 text-red-400'}`;
    el.textContent = d.message || (d.success ? 'Koneksi berhasil!' : 'Koneksi gagal');
}

async function openSyncProviderModal(id) {
    currentSyncProviderId = id;
    const statusEl = document.getElementById('syncProviderStatus');
    const listEl = document.getElementById('syncProviderList');
    const importBtn = document.getElementById('syncProviderImportBtn');
    const controlsEl = document.getElementById('syncProviderControls');
    const searchEl = document.getElementById('syncProviderSearch');
    statusEl.textContent = 'Mengambil daftar produk dari provider...';
    listEl.innerHTML = '';
    importBtn.classList.add('hidden');
    controlsEl.classList.add('hidden');
    searchEl.value = '';
    openModal('modal-sync-provider');

    const d = await api(`/admin/providers/${id}/sync`, {});
    if (!d.success) {
        statusEl.innerHTML = `<span class="text-red-400">${d.message || 'Gagal mengambil produk dari provider'}</span>`;
        return;
    }
    if (!d.products || !d.products.length) {
        statusEl.innerHTML = `<span class="text-zinc-500">Provider tidak mengembalikan produk apapun.</span>`;
        return;
    }
    statusEl.innerHTML = `<span class="text-emerald-400">${d.products.length} produk ditemukan.</span> Nama produk dari CHEATGAME kadang cuma "KEY 3 DAY" tanpa nama game -- edit langsung nama tampilannya di sini biar gampang dicari & dikenali pembeli.`;
    listEl.innerHTML = d.products.map((p, i) => `
        <div class="sync-item-row flex items-start gap-2 p-2.5 rounded-lg border border-white/10 bg-white/3">
            <input type="checkbox" class="sync-item-check mt-1" data-idx="${i}" checked onchange="updateSyncCheckedCount()">
            <div class="flex-1 min-w-0">
                <input type="text" class="sync-item-name-input hm-input text-xs py-1.5 mb-1" data-idx="${i}" value="${escapeHtml(p.name)}" oninput="onSyncNameEdit(${i}, this.value)" placeholder="Nama produk...">
                <div class="text-[10px] text-zinc-500 px-0.5">${escapeHtml(p.category || 'Tanpa kategori')} · Modal: Rp${Number(p.costPrice||0).toLocaleString('id-ID')} · Stok: ${p.stock === null ? '∞' : p.stock}</div>
            </div>
        </div>
    `).join('');
    importBtn.classList.remove('hidden');
    importBtn.dataset.products = JSON.stringify(d.products);
    controlsEl.classList.remove('hidden');
    updateSyncCheckedCount();
}

// Filter baris produk di modal Sync berdasarkan nama (yang sedang tampil di
// input, termasuk hasil edit manual admin) + kategori asli dari provider.
function filterSyncProviderList(query) {
    const q = query.toLowerCase().trim();
    document.querySelectorAll('.sync-item-row').forEach(row => {
        const nameInput = row.querySelector('.sync-item-name-input');
        const currentName = (nameInput?.value || '').toLowerCase();
        const category = (row.querySelector('.text-zinc-500')?.textContent || '').toLowerCase();
        const match = !q || currentName.includes(q) || category.includes(q);
        row.style.display = match ? '' : 'none';
    });
}

// Admin edit nama produk manual (mis. "KEY 3 DAY" -> "Migul Freefire - 3 Hari")
// -- disimpan balik ke array products di memori supaya submitImportProvider
// pakai nama yang sudah diedit, bukan nama generic asli dari provider.
function onSyncNameEdit(idx, newName) {
    const importBtn = document.getElementById('syncProviderImportBtn');
    const products = JSON.parse(importBtn.dataset.products || '[]');
    if (products[idx]) {
        products[idx].name = newName;
        importBtn.dataset.products = JSON.stringify(products);
    }
}

// Centang/hapus centang SEMUA baris yang sedang TERLIHAT (menghormati hasil
// filter search -- kalau admin lagi nyari "migul" terus klik "Centang Semua",
// yang lain (tidak lagi kelihatan) tidak ikut ke-centang tanpa sadar).
function setAllSyncCheckboxes(checked) {
    document.querySelectorAll('.sync-item-row').forEach(row => {
        if (row.style.display === 'none') return; // skip yang lagi tersembunyi oleh filter
        const cb = row.querySelector('.sync-item-check');
        if (cb) cb.checked = checked;
    });
    updateSyncCheckedCount();
}

function updateSyncCheckedCount() {
    const count = document.querySelectorAll('.sync-item-check:checked').length;
    const el = document.getElementById('syncProviderCheckedCount');
    if (el) el.textContent = count;
}

async function submitImportProvider() {
    const importBtn = document.getElementById('syncProviderImportBtn');
    const products = JSON.parse(importBtn.dataset.products || '[]');
    const checked = Array.from(document.querySelectorAll('.sync-item-check:checked')).map(el => products[parseInt(el.dataset.idx)]);
    if (!checked.length) { toast('Pilih minimal 1 produk', 'error'); return; }

    const items = checked.map(p => ({
        providerProductId: p.providerProductId,
        name: p.name,
        category: p.category,
        costPrice: p.costPrice,
    }));
    importBtn.disabled = true;
    importBtn.innerHTML = '<iconify-icon icon="mdi:loading" class="animate-spin"></iconify-icon> Mengimport...';
    const d = await api(`/admin/providers/${currentSyncProviderId}/import`, { items });
    importBtn.disabled = false;
    importBtn.innerHTML = '<iconify-icon icon="mdi:download"></iconify-icon> Import Produk Terpilih';
    if (d.success) {
        toast(`Import selesai: ${d.created} baru, ${d.updated} diupdate`, 'success');
        closeModal('modal-sync-provider');
        loadProviders();
    } else toast(d.message || 'Gagal import', 'error');
}

async function openProviderLogsModal(providerId) {
    const listEl = document.getElementById('providerLogsList');
    listEl.innerHTML = '<div class="text-center py-6 text-zinc-600 text-xs">Memuat log...</div>';
    openModal('modal-provider-logs');
    const url = providerId ? `/admin/providers/${providerId}/logs` : '/admin/providers-logs';
    const res = await fetch(url);
    const d = await res.json();
    if (!d.success || !d.data.length) { listEl.innerHTML = '<div class="text-center py-6 text-zinc-600 text-xs">Belum ada log.</div>'; return; }
    listEl.innerHTML = d.data.map(l => `
        <div class="p-2.5 rounded-lg border ${l.success ? 'border-emerald-500/20 bg-emerald-500/5' : 'border-red-500/20 bg-red-500/5'}">
            <div class="flex items-center justify-between mb-1">
                <span class="text-[10px] font-bold ${l.success ? 'text-emerald-400' : 'text-red-400'}">${escapeHtml(l.action)}</span>
                <span class="text-[9px] text-zinc-600">${new Date(l.at).toLocaleString('id-ID')}</span>
            </div>
            <div class="text-[9px] text-zinc-500 mb-1">${escapeHtml(l.providerLabel || '')}${l.durationMs ? ` · ${l.durationMs}ms` : ''}</div>
            <pre class="text-[9px] text-zinc-400 whitespace-pre-wrap break-all">${escapeHtml(typeof l.response === 'string' ? l.response : JSON.stringify(l.response, null, 2).slice(0, 2000))}</pre>
            ${l.request !== undefined ? `<details class="mt-1"><summary class="text-[9px] text-zinc-600 cursor-pointer">Lihat request</summary><pre class="text-[9px] text-zinc-500 whitespace-pre-wrap break-all mt-1">${escapeHtml(JSON.stringify(l.request, null, 2).slice(0, 1000))}</pre></details>` : ''}
        </div>
    `).join('');
}

function escapeHtml(str) {
    return String(str ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

