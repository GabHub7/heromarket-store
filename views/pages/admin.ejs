                <div class="flex items-center justify-between mb-1.5">
                    <span class="text-sm font-bold text-white">${p.name}</span>
                    <span class="badge ${p.status === 'active' ? 'badge-done' : 'badge-inactive'}">${p.status === 'active' ? 'Aktif' : 'Suspended'}</span>
                </div>
                <div class="flex items-center gap-3 text-[10px] text-zinc-500 mb-2 flex-wrap">
                    <span><iconify-icon icon="mdi:wallet" class="align-middle"></iconify-icon> Rp ${(p.balance||0).toLocaleString('id-ID')}</span>
                    <span><iconify-icon icon="mdi:cart-check" class="align-middle"></iconify-icon> ${p.totalOrders||0} order</span>
                    <span>${p.lastUsedAt ? 'Terakhir dipakai: ' + new Date(p.lastUsedAt).toLocaleDateString('id-ID') : 'Belum pernah dipakai'}</span>
                </div>
                <div class="flex gap-1.5 flex-wrap">
                    <button onclick="openTopupPartnerModal('${p.id}','${(p.name||'').replace(/'/g,"\\'")}')" class="btn-success py-1 px-2 text-[10px]"><iconify-icon icon="mdi:cash-plus"></iconify-icon> Top Up</button>
                    <button onclick="togglePartnerStatus('${p.id}','${p.status}')" class="btn-warning py-1 px-2 text-[10px]"><iconify-icon icon="mdi:${p.status==='active'?'pause':'play'}"></iconify-icon> ${p.status==='active'?'Suspend':'Aktifkan'}</button>
                    <button onclick="regeneratePartnerSecret('${p.id}')" class="btn-warning py-1 px-2 text-[10px]"><iconify-icon icon="mdi:key-change"></iconify-icon> Regenerate Secret</button>
                    <button onclick="deletePartner('${p.id}','${(p.name||'').replace(/'/g,"\\'")}')" class="btn-danger py-1 px-2 text-[10px]"><iconify-icon icon="mdi:trash-can"></iconify-icon></button>
