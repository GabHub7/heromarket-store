    const originalHtml = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<iconify-icon icon="mdi:loading" class="animate-spin"></iconify-icon> Memproses...';
    try {
        const d = await api('/admin/product/bulk-set-auto', {});
