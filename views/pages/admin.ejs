// Set stockSource='auto' untuk SEMUA produk & varian sekaligus -- tidak
// perlu mapping Reseller Item ID manual, sistem otomatis mencocokkan nama
// produk & hari ke katalog provider setiap ada pembelian. Mapping manual
// yang sudah ada di produk manapun tidak disentuh/dihapus oleh aksi ini.
async function bulkSetAutoStock() {
    if (!confirm('Ubah SEMUA produk & varian ke sumber stok Auto (Reseller API)?\n\nPENTING: Auto-cocokkan by nama SUDAH DIMATIKAN. Tiap varian WAJIB di-mapping manual satu-satu ke produk provider (buka Edit Produk), kalau tidak checkout-nya akan GAGAL. Setelah ini selesai, klik "Cek Belum Mapping" untuk lihat varian mana saja yang masih perlu di-mapping.')) return;
