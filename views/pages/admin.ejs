})();

// ═══ KEY POOL MANAGEMENT ═══
let _allKeys = [];

async function loadKeys() {
    const r = await fetch('/admin/keyspool');
    const d = await r.json();
    if (!d.success) return;
    _allKeys = d.data || [];
    renderKeys(_allKeys);
}

function renderKeys(keys) {
    const list = document.getElementById('keysList');
    const total = document.getElementById('keyTotal');
    const stats = document.getElementById('keyStatsLabel');
    if (!list) return;
    const used = keys.filter(k => k.used).length;
    const avail = keys.length - used;
    if (total) total.textContent = keys.length;
    if (stats) stats.textContent = `${avail} tersedia · ${used} terpakai`;
    if (!keys.length) {
        list.innerHTML = '<div class="text-center py-8 text-zinc-600 text-xs"><iconify-icon icon="mdi:key-off" class="text-3xl block mx-auto mb-2 text-zinc-700"></iconify-icon>Belum ada key</div>';
        return;
    }
    list.innerHTML = keys.map(k => `
        <div class="neon-card p-3 flex items-center gap-3 ${k.used ? 'opacity-60' : ''}">
            <div class="w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0 ${k.used ? 'bg-zinc-800' : 'bg-indigo-500/15 border border-indigo-500/25'}">
                <iconify-icon icon="${k.used ? 'mdi:key-off' : 'mdi:key'}" class="text-base ${k.used ? 'text-zinc-600' : 'text-indigo-400'}"></iconify-icon>
            </div>
            <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                    <span class="font-mono text-sm font-black text-white">${k.code}</span>
                    <span class="text-[10px] font-bold px-2 py-0.5 rounded ${k.used ? 'bg-zinc-700 text-zinc-500' : 'bg-indigo-500/20 text-indigo-400 border border-indigo-500/30'}">
                        ${k.duration} Hari
                    </span>
                    ${k.used ? `<span class="text-[9px] bg-red-500/15 text-red-400 border border-red-500/25 px-1.5 py-0.5 rounded font-bold">TERPAKAI</span>` : '<span class="text-[9px] bg-emerald-500/15 text-emerald-400 border border-emerald-500/25 px-1.5 py-0.5 rounded font-bold">TERSEDIA</span>'}
                </div>
                <div class="text-[10px] text-zinc-500 mt-0.5">
                    ${k.label !== k.duration + ' Hari' ? k.label + ' · ' : ''}
                    ${k.used ? `Digunakan: <span class="text-zinc-400">${k.usedByUsername || '?'}</span>` : `Dibuat: ${new Date(k.createdAt).toLocaleDateString('id-ID')}`}
                </div>
            </div>
            <button onclick="deleteKey('${k.id}')" class="btn-danger py-1 px-2 text-[10px]" ${k.used ? 'disabled style="opacity:.4"' : ''}>
                <iconify-icon icon="mdi:trash-can"></iconify-icon>
            </button>
        </div>`).join('');
}

async function addKey() {
    const code = document.getElementById('newKeyCode').value.trim();
    const duration = document.getElementById('newKeyDuration').value.trim();
    const label = document.getElementById('newKeyLabel').value.trim();
    const note = document.getElementById('newKeyNote').value.trim();
    if (!code || !duration) { toast('Kode dan durasi wajib diisi', 'error'); return; }
    const d = await api('/admin/keyspool/add', { code, duration, label, note });
    if (d.success) {
        toast('Key berhasil ditambahkan!', 'success');
        document.getElementById('newKeyCode').value = '';
        document.getElementById('newKeyDuration').value = '';
        document.getElementById('newKeyLabel').value = '';
        document.getElementById('newKeyNote').value = '';
        _allKeys = d.data;
        renderKeys(_allKeys);
    } else toast(d.message, 'error');
}

async function generateKeys() {
    const count = document.getElementById('genCount').value;
    const duration = document.getElementById('genDuration').value;
    const prefix = document.getElementById('genPrefix').value;
    if (!duration || parseInt(duration) <= 0) { toast('Durasi tidak valid', 'error'); return; }
    const d = await api('/admin/keyspool/generate', { count, duration, prefix });
    if (d.success) {
        toast(`${d.generated} key berhasil dibuat!`, 'success');
        _allKeys = d.data;
        renderKeys(_allKeys);
        const res = document.getElementById('genResult');
        res.classList.remove('hidden');
        res.innerHTML = `<div class="p-3 rounded-xl text-xs font-mono text-indigo-300 break-all" style="background:rgba(99,102,241,.08);border:1px solid rgba(99,102,241,.2)">${d.codes.join('<br>')}</div>`;
    } else toast(d.message, 'error');
}

async function deleteKey(id) {
    if (!confirm('Hapus key ini?')) return;
    const d = await api('/admin/keyspool/delete/' + id, {});
    if (d.success) {
        toast('Key dihapus', 'success');
        _allKeys = _allKeys.filter(k => k.id !== id);
        renderKeys(_allKeys);
    } else toast(d.message, 'error');
}

// ═══ VOUCHER MANAGEMENT ═══
async function loadVouchers() {
    const r = await fetch('/admin/vouchers');
    const d = await r.json();
    if (!d.success) return;
    renderVouchers(d.data || []);
}

function renderVouchers(vouchers) {
    const list = document.getElementById('vouchersList');
    const stats = document.getElementById('voucherStatsLabel');
    if (!list) return;
    const active = vouchers.filter(v => v.active).length;
    if (stats) stats.textContent = `${vouchers.length} total · ${active} aktif`;
    if (!vouchers.length) {
        list.innerHTML = '<div class="text-center py-8 text-zinc-600 text-xs"><iconify-icon icon="mdi:ticket-outline" class="text-3xl block mx-auto mb-2 text-zinc-700"></iconify-icon>Belum ada voucher</div>';
        return;
    }
    list.innerHTML = vouchers.map(v => {
        const expired = v.expiresAt && new Date(v.expiresAt) < new Date();
        const exhausted = v.maxUses > 0 && v.usedCount >= v.maxUses;
        const isInactive = !v.active || expired || exhausted;
        const valDisplay = v.type === 'percent' ? v.value + '%' : 'Rp ' + v.value.toLocaleString('id-ID');
        const minDisplay = v.minPurchase > 0 ? 'Min Rp ' + v.minPurchase.toLocaleString('id-ID') : 'Tanpa min';
        return `<div class="neon-card p-3 flex items-center gap-3 ${isInactive ? 'opacity-50' : ''}">
            <div class="w-9 h-9 rounded-lg flex items-center justify-center flex-shrink-0 ${v.active ? 'bg-green-500/15 border border-green-500/25' : 'bg-zinc-800'}">
                <iconify-icon icon="${v.active ? 'mdi:ticket-percent' : 'mdi:ticket-off'}" class="text-lg ${v.active ? 'text-green-400' : 'text-zinc-600'}"></iconify-icon>
            </div>
            <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                    <span class="font-mono text-sm font-black text-white">${v.code}</span>
                    <span class="text-[10px] font-bold px-2 py-0.5 rounded ${v.active ? 'bg-green-500/20 text-green-400 border border-green-500/30' : 'bg-zinc-700 text-zinc-500'}">${valDisplay}</span>
                </div>
                <div class="flex items-center gap-3 text-[10px] mt-0.5 flex-wrap">
                    <span class="text-zinc-500">${v.description || '—'}</span>
                    <span class="text-zinc-600">${minDisplay}</span>
                    <span class="text-zinc-600">${v.usedCount}/${v.maxUses || '∞'} dipakai</span>
                </div>
                ${v.expiresAt ? `<div class="text-[9px] ${expired ? 'text-red-400' : 'text-zinc-500'}">Kadaluarsa: ${new Date(v.expiresAt).toLocaleDateString('id-ID')}</div>` : ''}
            </div>
            <div class="flex flex-col gap-1">
                <button onclick="toggleVoucher('${v.id}')" class="px-2 py-1 text-[10px] rounded-lg border transition-all font-semibold ${v.active ? 'bg-yellow-500/15 border-yellow-500/30 text-yellow-400 hover:bg-yellow-500/25' : 'bg-emerald-500/15 border-emerald-500/30 text-emerald-400 hover:bg-emerald-500/25'}">
                    <iconify-icon icon="${v.active ? 'mdi:pause' : 'mdi:play'}"></iconify-icon>
                    ${v.active ? 'Nonaktif' : 'Aktifkan'}
                </button>
                <button onclick="deleteVoucher('${v.id}')" class="btn-danger py-1 px-2 text-[10px]">
                    <iconify-icon icon="mdi:trash-can"></iconify-icon>
                </button>
            </div>
        </div>`;
    }).join('');
}

async function addVoucher() {
    const code = document.getElementById('newVoucherCode').value.trim();
    const type = document.getElementById('newVoucherType').value;
    const value = document.getElementById('newVoucherValue').value;
    const minPurchase = document.getElementById('newVoucherMin').value;
    const maxUses = document.getElementById('newVoucherMax').value;
    const perUserLimit = document.getElementById('newVoucherPerUser').value;
    const expiresAt = document.getElementById('newVoucherExpiry').value;
    const description = document.getElementById('newVoucherDesc').value.trim();
    if (!code || !value) { toast('Kode dan nilai wajib diisi', 'error'); return; }
    const d = await api('/admin/vouchers/add', { code, type, value, minPurchase, maxUses, perUserLimit, expiresAt, description });
    if (d.success) {
        toast('Voucher berhasil dibuat!', 'success');
        document.getElementById('newVoucherCode').value = '';
        document.getElementById('newVoucherValue').value = '';
        document.getElementById('newVoucherDesc').value = '';
        renderVouchers(d.data);
    } else toast(d.message, 'error');
}

async function toggleVoucher(id) {
    const d = await api('/admin/vouchers/toggle/' + id, {});
    if (d.success) loadVouchers();
    else toast(d.message, 'error');
}

async function deleteVoucher(id) {
    if (!confirm('Hapus voucher ini?')) return;
    const d = await api('/admin/vouchers/delete/' + id, {});
    if (d.success) {
        toast('Voucher dihapus', 'success');
        loadVouchers();
    } else toast(d.message, 'error');
}

// ═══ EXPORT / IMPORT DATABASE ═══
async function importDB(event) {
    const file = event.target.files[0];
    const statusEl = document.getElementById('importStatus');
    if (!file) return;
    statusEl.classList.remove('hidden');
    statusEl.innerHTML = '<div class="flex items-center gap-2 text-xs text-indigo-400"><iconify-icon icon="mdi:loading" class="animate-spin"></iconify-icon> Membaca file...</div>';
    try {
        const text = await file.text();
        const data = JSON.parse(text);
        const r = await fetch('/admin/import', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        const d = await r.json();
        if (d.success) {
            statusEl.innerHTML = `<div class="flex items-center gap-2 text-xs text-emerald-400"><iconify-icon icon="mdi:check-circle"></iconify-icon> ${d.message}. Reload...</div>`;
            setTimeout(() => location.reload(), 1000);
        } else {
            statusEl.innerHTML = `<div class="flex items-center gap-2 text-xs text-red-400"><iconify-icon icon="mdi:alert-circle"></iconify-icon> ${d.message}</div>`;
        }
    } catch(e) {
        statusEl.innerHTML = `<div class="flex items-center gap-2 text-xs text-red-400"><iconify-icon icon="mdi:alert-circle"></iconify-icon> File tidak valid: ${e.message}</div>`;
    }
    event.target.value = '';
}
</script>
