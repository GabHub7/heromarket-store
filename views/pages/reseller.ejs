<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#060a1f">
<title>Upgrade Reseller — <%= settings.siteName %></title>
<link rel="preconnect" href="https://api.iconify.design" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" onload="this.onload=null;this.rel='stylesheet'">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"></noscript>
<link rel="stylesheet" href="/css/hm-theme.css?v=<%= assetV('css/hm-theme.css') %>">
<link rel="stylesheet" href="/css/hm-reseller.css?v=<%= assetV('css/hm-reseller.css') %>">
<script src="https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js" defer></script>
</head>
<body>
<nav id="navbar" class="rs-nav">
    <a href="/" class="rs-brand"><%= settings.siteName || 'HERO MARKET' %></a>
    <div class="rs-nav-r">
        <% if (user) { %>
            <% if (pricing.current >= 1) { %><a href="/reseller/panel" class="rs-link">Panel</a><% } %>
            <a href="/" class="rs-link">Beranda</a>
        <% } else { %>
            <a href="/login?redirect=/reseller" class="rs-link">Masuk</a>
            <a href="/register" class="rs-cta">Daftar</a>
        <% } %>
    </div>
</nav>

<main class="rs-wrap">
    <h1 class="rs-title">Upgrade Reseller</h1>
    <p class="rs-sub">Beli akses harga spesial, langsung pakai di katalog.</p>

    <% if (need) { %>
    <div class="rs-note warn">API dan dokumentasi API khusus <b>Reseller Tier 2</b>. Upgrade dulu di bawah untuk membukanya.</div>
    <% } %>
    <% if (!enabled) { %>
    <div class="rs-note warn">Pendaftaran reseller sedang ditutup oleh admin.</div>
    <% } %>

    <% if (pricing.current >= 2) { %>
    <div class="rs-card">
        <div class="rs-label">Status kamu</div>
        <ul class="rs-list">
            <li><span class="rs-tick">✓</span><span><b>Reseller Tier 2 aktif</b> — harga khusus reseller, akses API, dan dokumentasi sudah terbuka. Berlaku selamanya.</span></li>
        </ul>
    </div>
    <div class="rs-row" style="margin-bottom:16px;">
        <a href="/reseller/panel" class="rs-ghost"><iconify-icon icon="mdi:storefront-outline"></iconify-icon> Panel &amp; Saldo</a>
        <a href="/reseller/api" class="rs-ghost"><iconify-icon icon="mdi:key-variant"></iconify-icon> API Key</a>
        <a href="/docs/api" class="rs-ghost"><iconify-icon icon="mdi:book-open-variant"></iconify-icon> Dokumentasi</a>
    </div>
    <% } else { %>

    <div class="rs-tiers" id="tiers">
        <button type="button" class="rs-tier <%= pricing.current >= 1 ? 'done' : '' %>" data-tier="1" onclick="pickTier(1)">
            <div class="rs-tier-name">Tier 1</div>
            <div class="rs-tier-tag">Harga murah</div>
            <div class="rs-tier-price">Rp <%= pricing.tier1.toLocaleString('id-ID') %></div>
            <div class="rs-tier-note">sekali bayar</div>
            <% if (pricing.current >= 1) { %><span class="rs-badge-on">Aktif</span><% } else { %><span class="rs-tier-check">✓</span><% } %>
        </button>
        <button type="button" class="rs-tier" data-tier="2" onclick="pickTier(2)">
            <div class="rs-tier-name">Tier 2</div>
            <div class="rs-tier-tag">Harga murah + API</div>
            <div class="rs-tier-price">Rp <%= (pricing.current === 1 ? pricing.upgrade2 : pricing.tier2).toLocaleString('id-ID') %></div>
            <div class="rs-tier-note"><%= pricing.current === 1 ? 'upgrade dari Tier 1 (selisih)' : 'sekali bayar' %></div>
            <span class="rs-tier-check">✓</span>
        </button>
    </div>

    <div class="rs-card">
        <div class="rs-label">Yang kamu dapat</div>
        <ul class="rs-list" id="benefits"></ul>
    </div>

    <div class="rs-card">
        <div class="rs-total">
            <div>
                <div class="rs-label muted">Total</div>
                <div class="rs-total-price" id="totalPrice">Rp 0</div>
            </div>
            <div class="rs-total-note" id="totalNote">Sekali bayar</div>
        </div>
    </div>

    <% if (user) { %>
    <button type="button" class="rs-pay" id="payBtn" onclick="handleJoin()" <%= enabled ? '' : 'disabled' %>>Bayar Sekarang</button>
    <% } else { %>
    <a href="/login?redirect=/reseller" class="rs-pay">Login untuk Daftar</a>
    <% } %>
    <p class="rs-sub" style="margin:14px 0 0;font-size:11px;text-align:center;">Pembayaran lewat QRIS. Status aktif otomatis setelah pembayaran terkonfirmasi.</p>
    <% } %>
</main>

<!-- MODAL PEMBAYARAN -->
<div class="rs-modal" id="payModal" onclick="if(event.target===this)closePayment()">
    <div class="rs-sheet">
        <h3 id="payTitle">Pembayaran Reseller</h3>
        <div id="qrWrap" style="margin-bottom:6px;"></div>
        <div class="rs-code"><small>Kode Pesanan</small><b id="orderCodeShow">—</b></div>
        <div style="font-size:13px;font-weight:700;color:#c4ccff;" id="payAmountShow"></div>
        <div class="rs-status" id="payStatusRow">Menunggu pembayaran…</div>
        <button type="button" class="rs-ghost" style="margin:16px auto 0;width:100%;" onclick="closePayment()">Tutup</button>
    </div>
</div>
<div class="rs-toast" id="toast"></div>

<script>
const P = <%- JSON.stringify({ tier1: pricing.tier1, tier2: pricing.tier2, upgrade2: pricing.upgrade2, current: pricing.current, discount: pricing.discount }) %>;
let tier = P.current === 1 ? 2 : (P.current === 0 ? 1 : 2);
let payInterval = null;

const BENEFITS = {
  1: [
    ['Harga key lebih murah', 'Setiap produk punya harga khusus reseller (hemat sekitar ' + P.discount + '% atau harga khusus per produk), langsung dipotong saat checkout.', true],
    ['Beli pakai saldo', 'Top up saldo sekali, lalu belanja key kapan saja tanpa scan QRIS tiap order.', true],
    ['Panel reseller', 'Riwayat key, mutasi saldo, dan ringkasan pembelian dalam satu tempat.', true],
    ['Sekali bayar', 'Aktif selamanya, tanpa langganan bulanan.', true],
    ['Belum bisa disambungkan ke web lain', 'Tier 1 hanya untuk belanja di web ini. Butuh integrasi otomatis? Pilih Tier 2.', false]
  ],
  2: [
    ['Semua benefit Tier 1', 'Harga key lebih murah, beli pakai saldo, dan panel reseller.', true],
    ['API Reseller', 'Buat API key sendiri lalu ambil katalog, stok, dan order key otomatis lewat API.', true],
    ['Auto-restock ke web lain', 'Sambungkan ke web toko kamu: Hero Market jadi provider auto-restock, key terkirim langsung saat ada pembelian.', true],
    ['Dokumentasi API', 'Dokumentasi lengkap (khusus Tier 2) berikut contoh curl dan Node.js.', true],
    ['Sekali bayar', 'Aktif selamanya, tanpa langganan bulanan.', true]
  ]
};

function esc(s){return String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));}
function render() {
  document.querySelectorAll('.rs-tier').forEach(el => el.classList.toggle('on', Number(el.dataset.tier) === tier && !(P.current >= Number(el.dataset.tier))));
  const ul = document.getElementById('benefits'); if (!ul) return;
  ul.innerHTML = BENEFITS[tier].map(b => '<li class="' + (b[2] ? '' : 'off') + '"><span class="rs-tick ' + (b[2] ? '' : 'no') + '">' + (b[2] ? '✓' : '–') + '</span><span><b>' + esc(b[0]) + '</b> — ' + esc(b[1]) + '</span></li>').join('');
  const price = tier === 1 ? P.tier1 : P.upgrade2;
  document.getElementById('totalPrice').textContent = 'Rp ' + price.toLocaleString('id-ID');
  document.getElementById('totalNote').textContent = (tier === 2 && P.current === 1) ? 'Selisih upgrade' : 'Sekali bayar';
  const btn = document.getElementById('payBtn');
  if (btn) {
    const already = P.current >= tier;
    btn.disabled = already || btn.hasAttribute('data-closed');
    btn.textContent = already ? 'Sudah Aktif' : (tier === 2 && P.current === 1 ? 'Upgrade ke Tier 2' : 'Bayar Sekarang');
  }
}
function pickTier(t) { if (P.current >= t) return; tier = t; render(); }

function toast(msg, type) {
  const w = document.getElementById('toast'), el = document.createElement('div');
  el.className = type || ''; el.textContent = msg; w.appendChild(el);
  setTimeout(() => el.remove(), 3800);
}

async function handleJoin() {
  const btn = document.getElementById('payBtn'); if (!btn || btn.disabled) return;
  const label = btn.textContent; btn.disabled = true; btn.textContent = 'Membuat pesanan…';
  try {
    const res = await fetch('/reseller/join', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ tier }) });
    const d = await res.json();
    if (d.success) showPayment(d);
    else { toast(d.message || 'Gagal membuat pesanan', 'err'); }
  } catch (e) { toast('Koneksi error, coba lagi.', 'err'); }
  btn.disabled = false; btn.textContent = label; render();
}

function showPayment(d) {
  document.getElementById('payModal').classList.add('open');
  document.body.style.overflow = 'hidden';
  document.getElementById('payTitle').textContent = d.tier === 2 ? 'Pembayaran Reseller Tier 2' : 'Pembayaran Reseller Tier 1';
  document.getElementById('orderCodeShow').textContent = d.orderCode || '—';
  document.getElementById('payAmountShow').textContent = 'Total: Rp ' + (d.totalPayment || 0).toLocaleString('id-ID');
  const wrap = document.getElementById('qrWrap'), st = document.getElementById('payStatusRow');
  if (d.isStatic && d.qrisStaticImage) {
    wrap.innerHTML = '<div class="rs-qr"><img alt="QRIS" src="' + encodeURI(d.qrisStaticImage) + '"></div>';
    st.textContent = 'Setelah membayar, konfirmasi ke admin via WA/Telegram. Aktif setelah dikonfirmasi.';
  } else if (d.qrString) {
    const isImg = /^(https?:\/\/|data:image)/i.test(d.qrString);
    wrap.innerHTML = '<div class="rs-qr"><img alt="QRIS" src="' + (isImg ? d.qrString : 'https://api.qrserver.com/v1/create-qr-code/?size=210x210&data=' + encodeURIComponent(d.qrString)) + '"></div>';
    st.textContent = 'Menunggu pembayaran…';
    if (payInterval) clearInterval(payInterval);
    payInterval = setInterval(() => checkPay(d.refId), 6000);
  } else {
    wrap.innerHTML = '<div class="rs-note warn">QRIS belum dikonfigurasi. Hubungi admin.</div>';
  }
}

async function checkPay(refId) {
  try {
    const r = await fetch('/check-payment/' + refId); const d = await r.json();
    if (d.success && d.status === 'done') {
      clearInterval(payInterval);
      document.getElementById('payStatusRow').innerHTML = '<b style="color:#34d399">Pembayaran berhasil! Reseller aktif.</b>';
      toast('Selamat, akun reseller kamu aktif!', 'ok');
      setTimeout(() => location.href = '/reseller', 1800);
    }
  } catch (e) {}
}
function closePayment() {
  if (payInterval) clearInterval(payInterval);
  document.getElementById('payModal').classList.remove('open');
  document.body.style.overflow = '';
}
render();
</script>
</body>
</html>
