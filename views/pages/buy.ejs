<%
const pageTitle = 'Beli ' + product.name;
%>

<style>
    .pkg-option-label { display:block; cursor:pointer; }
    .pkg-option input[type=radio] { display:none !important; appearance:none !important; -webkit-appearance:none !important; width:0;height:0;position:absolute;opacity:0; }
    .pkg-option input[type=radio]:checked + .pkg-card {
        border-color: rgba(139,92,246,0.6) !important;
        background: rgba(139,92,246,0.1) !important;
    }
    #payMethodQris, #payMethodBalance, #payMethodUsdtManual {
        background: rgba(255,255,255,0.04); border-color: rgba(255,255,255,0.1); color: rgba(255,255,255,0.5);
    }
    #payMethodQris.active, #payMethodBalance.active, #payMethodUsdtManual.active {
        background: rgba(139,92,246,0.15); border-color: rgba(139,92,246,0.5); color: #fff;
    }
    .pkg-card {
        background:rgba(255,255,255,0.03);
        border:1px solid rgba(255,255,255,0.08);
        border-radius:16px;
        padding:12px 14px;
        transition:all .2s;
    }
    .pkg-card:hover { border-color:rgba(139,92,246,0.4); }
    @keyframes countUp { from { opacity:0;transform:translateY(8px); } to { opacity:1;transform:translateY(0); } }
    .count-up { animation:countUp .4s ease-out both; }
</style>

<!-- NAVBAR -->
<nav id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300" style="background:rgba(6,5,15,0.92);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border-bottom:1px solid rgba(255,255,255,0.05);">
    <div class="max-w-3xl mx-auto px-4">
        <div class="flex items-center justify-between h-14">
            <a href="/" class="flex items-center gap-2.5">
                <img src="https://z-cdn-media.chatglm.cn/files/87e4e759-3898-4bd9-93f3-42078956a794.png?auth_key=1878848442-1a65b6a56ce44d8188d26c370725de81-0-3e86df522848abe81fc556fd03a5fe98"
                     alt="Logo" class="hm-logo-img h-9 w-auto">
                <span class="brand-wordmark brand-wordmark-sm shimmer-text"><%= settings.siteName %></span>
            </a>
            <a href="/" class="flex items-center gap-1.5 text-xs text-zinc-400 hover:text-white transition-colors px-3 py-1.5 rounded-lg border border-white/10 hover:bg-white/5">
                <iconify-icon icon="mdi:arrow-left" class="text-sm"></iconify-icon> Kembali
            </a>
        </div>
    </div>
</nav>

<div class="min-h-screen pt-16 pb-8 px-4">
<div class="max-w-3xl mx-auto space-y-4">

    <!-- ── PRODUCT HEADER ── -->
    <div class="glass-strong rounded-2xl overflow-hidden mt-4 fade-in-up">
        <div class="h-1 w-full" style="background:linear-gradient(90deg,#7c3aed,#a855f7,#f472b6,#7c3aed);background-size:200% 100%;animation:shimmer 2s linear infinite;"></div>
        <div class="flex items-center gap-3 p-4">
            <div class="w-16 h-16 rounded-xl overflow-hidden flex-shrink-0 border border-white/10">
                <% if (product.image) { %>
                    <img src="<%= product.image %>" alt="<%= product.name %>" class="w-full h-full object-cover"
                         onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
                    <div class="w-full h-full items-center justify-center bg-violet-500/10" style="display:none">
                        <iconify-icon icon="solar:gamepad-bold" class="text-2xl text-violet-400"></iconify-icon>
                    </div>
                <% } else { %>
                    <div class="w-full h-full flex items-center justify-center bg-violet-500/10">
                        <iconify-icon icon="solar:gamepad-bold" class="text-2xl text-violet-400"></iconify-icon>
                    </div>
                <% } %>
            </div>
            <div class="flex-1 min-w-0">
                <div class="flex items-center gap-1.5 mb-0.5 flex-wrap">
                    <% if (product.badge || product.category) { %>
                    <span class="badge-tag bg-yellow-500/80 text-black"><%= product.badge || product.category.toUpperCase() %></span>
                    <% } %>
                    <% if ((product.platforms||[]).includes('android') && (product.platforms||[]).includes('ios')) { %>
                        <span class="platform-label">ANDROID</span>
                        <span class="platform-label">IOS</span>
                    <% } else if ((product.platforms||[]).includes('android')) { %>
                        <span class="platform-label">ANDROID</span>
                    <% } else if ((product.platforms||[]).includes('ios')) { %>
                        <span class="platform-label">IOS</span>
                    <% } else if ((product.platforms||[]).includes('pc')) { %>
                        <span class="platform-label">PC</span>
                    <% } %>
                </div>
                <h1 class="text-sm font-black text-white font-display leading-tight"><%= product.name %></h1>
            </div>
        </div>
    </div>

    <!-- ── DESKRIPSI PRODUK ── -->
    <% if (product.description && product.description.trim()) { %>
    <div class="glass-strong rounded-2xl p-4 fade-in-up">
        <p class="text-[10px] font-bold uppercase tracking-[0.15em] text-white/40 mb-1.5">Deskripsi Produk</p>
        <p class="text-xs text-white/70 leading-relaxed whitespace-pre-line"><%= product.description %></p>
    </div>
    <% } %>

    <!-- ── SHOWCASE / INFORMATION TABS ── -->
    <% var ytList = (product.youtubeUrls || []).map(function(u){
         var m = String(u||'').match(/(?:youtube\.com\/(?:watch\?v=|shorts\/|embed\/)|youtu\.be\/)([a-zA-Z0-9_-]{11})/);
         return m ? m[1] : null;
       }).filter(Boolean); %>
    <% var compatList = (product.compatibility || []).filter(function(s){ return s && String(s).trim(); }); %>
    <% var featureList = (product.features || []).filter(function(s){ return s && String(s).trim(); }); %>
    <% var hasShowcase = ytList.length > 0; %>
    <% var hasInfo = compatList.length > 0 || featureList.length > 0; %>
    <% if (hasShowcase || hasInfo) { %>
    <div class="fade-in-up">
        <!-- Tab pills -->
        <div class="flex gap-2 mb-3">
            <% if (hasShowcase) { %>
            <button type="button" id="tab-btn-showcase" onclick="hmSwitchTab('showcase')"
                class="hm-tab-btn flex-1 flex items-center justify-center gap-1.5 py-2.5 rounded-xl text-xs font-black border transition-all">
                <iconify-icon icon="mdi:play-circle"></iconify-icon> SHOWCASE
            </button>
            <% } %>
            <% if (hasInfo) { %>
            <button type="button" id="tab-btn-info" onclick="hmSwitchTab('info')"
                class="hm-tab-btn flex-1 flex items-center justify-center gap-1.5 py-2.5 rounded-xl text-xs font-black border transition-all">
                <iconify-icon icon="mdi:information"></iconify-icon> INFORMATION
            </button>
            <% } %>
        </div>

        <!-- SHOWCASE panel -->
        <% if (hasShowcase) { %>
        <div id="tab-panel-showcase" class="glass-strong rounded-2xl overflow-hidden">
            <div class="px-4 pt-4">
                <div class="rounded-xl overflow-hidden bg-black" style="aspect-ratio:16/9;">
                    <iframe id="ytPlayer" class="w-full h-full" src="https://www.youtube-nocookie.com/embed/<%= ytList[0] %>?rel=0"
                        title="<%= product.name %> showcase" frameborder="0"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        allowfullscreen></iframe>
                </div>
            </div>
            <% if (ytList.length > 1) { %>
            <div class="flex gap-2 overflow-x-auto p-4" style="scrollbar-width:none;">
                <% ytList.forEach(function(vid, i) { %>
                <button type="button" onclick="hmSwitchYtVideo('<%= vid %>', this)"
                    class="hm-yt-thumb relative flex-shrink-0 w-24 h-14 rounded-lg overflow-hidden border-2 <%= i===0 ? 'border-violet-500' : 'border-white/10' %> transition-all">
                    <img src="https://i.ytimg.com/vi/<%= vid %>/mqdefault.jpg" alt="Video <%= i+1 %>" class="w-full h-full object-cover">
                    <span class="absolute bottom-1 left-1 text-[9px] font-bold bg-black/70 text-white px-1.5 py-0.5 rounded">#<%= i+1 %></span>
                </button>
                <% }) %>
            </div>
            <% } else { %>
            <div class="pb-4"></div>
            <% } %>
        </div>
        <% } %>

        <!-- INFORMATION panel -->
        <% if (hasInfo) { %>
        <div id="tab-panel-info" class="glass-strong rounded-2xl p-4 space-y-4 <%= hasShowcase ? 'hidden' : '' %>">
            <% if (compatList.length) { %>
            <div>
                <p class="text-xs font-black text-yellow-400 mb-2">System Compatibility:</p>
                <ul class="space-y-1.5">
                    <% compatList.forEach(function(item) { %>
                    <li class="flex items-start gap-2 text-xs text-white/75 leading-relaxed">
                        <span class="mt-1.5 w-1 h-1 rounded-full bg-white/50 flex-shrink-0"></span>
                        <span><%= item %></span>
                    </li>
                    <% }) %>
                </ul>
            </div>
            <% } %>
            <% if (featureList.length) { %>
            <div>
                <p class="text-xs font-black text-yellow-400 mb-2">Feature List:</p>
                <ul class="space-y-1.5">
                    <% featureList.forEach(function(item) { %>
                    <li class="flex items-start gap-2 text-xs text-white/75 leading-relaxed">
                        <span class="mt-1.5 w-1 h-1 rounded-full bg-white/50 flex-shrink-0"></span>
                        <span><%= item %></span>
                    </li>
                    <% }) %>
                </ul>
            </div>
            <% } %>
        </div>
        <% } %>
    </div>
    <style>
    .hm-tab-btn{background:rgba(255,255,255,.04);border-color:rgba(255,255,255,.1);color:rgba(255,255,255,.5);}
    .hm-tab-btn.active{background:rgba(124,58,237,.15);border-color:rgba(124,58,237,.5);color:#fff;}
    </style>
    <script>
    function hmSwitchTab(tab) {
        var showcaseBtn = document.getElementById('tab-btn-showcase');
        var infoBtn = document.getElementById('tab-btn-info');
        var showcasePanel = document.getElementById('tab-panel-showcase');
        var infoPanel = document.getElementById('tab-panel-info');
        if (showcaseBtn) showcaseBtn.classList.toggle('active', tab === 'showcase');
        if (infoBtn) infoBtn.classList.toggle('active', tab === 'info');
        if (showcasePanel) showcasePanel.classList.toggle('hidden', tab !== 'showcase');
        if (infoPanel) infoPanel.classList.toggle('hidden', tab !== 'info');
    }
    function hmSwitchYtVideo(id, btn) {
        var player = document.getElementById('ytPlayer');
        if (player) player.src = 'https://www.youtube-nocookie.com/embed/' + id + '?rel=0&autoplay=1';
        document.querySelectorAll('.hm-yt-thumb').forEach(function(el){ el.classList.remove('border-violet-500'); el.classList.add('border-white/10'); });
        if (btn) { btn.classList.remove('border-white/10'); btn.classList.add('border-violet-500'); }
    }
    document.addEventListener('DOMContentLoaded', function(){
        hmSwitchTab('<%= hasShowcase ? "showcase" : "info" %>');
    });
    </script>
    <% } %>

    <!-- ── PILIH DURASI ── -->
    <div class="fade-in-up">
        <div class="mb-3">
            <p class="text-[10px] font-bold uppercase tracking-[0.15em] text-white/40">PILIH DURASI</p>
        </div>
        <div class="grid grid-cols-2 gap-2" id="pkg-grid">
            <% if (product.items && product.items.length > 0) { %>
                <% product.items.forEach((item, idx) => { %>
                <% const itemStock = (item.stok || 0); %>
                <% const isUnlimitedStock = itemStock === Infinity; %>
                <% const isOutOfStock = !isUnlimitedStock && itemStock === 0; %>
                <% const displayPrice = (isReseller && item.reseller_price) ? item.reseller_price : item.p; %>
                <!-- BUG FIX: itemStock bisa Infinity untuk varian stockSource
                     'auto' (Reseller API) -- jangan tulis literal "Infinity"
                     ke atribut onchange/label, tampilkan sebagai angka besar
                     aman (999999) untuk JS dan label "Tersedia" untuk user. -->
                <label class="pkg-option pkg-option-label" style="<%= isOutOfStock ? 'opacity:0.5;cursor:not-allowed;' : '' %>">
                    <input type="radio" name="pkg" value="<%= idx %>"
                           onchange="selectPkg('<%= item.l %>', <%= displayPrice %>, <%= isUnlimitedStock ? 999999 : itemStock %>)"
                           <%= idx===0 && !isOutOfStock ? 'checked' : '' %>
                           <%= isOutOfStock ? 'disabled' : '' %>>
                    <div class="pkg-card rounded-2xl p-3">
                        <div class="text-xs font-semibold text-white/70 mb-0.5">
                            <%= item.l %> <span class="text-white/25 font-normal text-[10px]">(<%= isUnlimitedStock ? 'Tersedia' : `Stok: ${itemStock}` %>)</span>
                        </div>
                        <div class="text-sm font-black <%= isReseller && item.reseller_price ? 'text-yellow-400' : 'text-white' %>">
                            Rp <%= displayPrice.toLocaleString('id-ID') %>
                        </div>
                        <% if (isReseller && item.reseller_price) { %>
                            <div class="text-[9px] text-zinc-500 line-through">Rp <%= item.p.toLocaleString('id-ID') %></div>
                        <% } %>
                    </div>
                </label>
                <% }) %>
            <% } %>
        </div>
    </div>

    <!-- ── ORDER FORM ── -->
    <div class="glass-strong rounded-2xl p-5 space-y-4 fade-in-up">
        <!-- WHATSAPP -->
        <div>
            <label class="text-[10px] font-bold uppercase tracking-[0.15em] text-white/40 mb-1.5 block">WHATSAPP</label>
            <input type="tel" id="waInput" required
                class="w-full px-4 py-3 rounded-xl text-sm text-white placeholder-white/25 outline-none transition-all"
                style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08);"
                onfocus="this.style.borderColor='rgba(139,92,246,0.6)'" onblur="this.style.borderColor='rgba(255,255,255,0.08)'"
                placeholder="08xxxxxxxxxx"
                value="<%= user?.wa || '' %>" maxlength="15">
        </div>

        <!-- EMAIL / NAMA -->
        <div>
            <label class="text-[10px] font-bold uppercase tracking-[0.15em] text-white/40 mb-1.5 block">EMAIL</label>
            <input type="email" id="customerName" required
                class="w-full px-4 py-3 rounded-xl text-sm text-white placeholder-white/25 outline-none transition-all"
                style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08);"
                onfocus="this.style.borderColor='rgba(139,92,246,0.6)'" onblur="this.style.borderColor='rgba(255,255,255,0.08)'"
                placeholder="email@example.com"
                value="<%= user?.email || '' %>" maxlength="60">
        </div>

        <!-- VOUCHER -->
        <div>
            <label class="text-[10px] font-bold uppercase tracking-[0.15em] text-white/40 mb-1.5 block">KODE VOUCHER (opsional)</label>
            <div class="flex gap-2">
                <input type="text" id="voucherInput" placeholder="Masukkan kode voucher"
                    class="flex-1 px-4 py-3 rounded-xl text-sm text-white placeholder-white/25 outline-none uppercase font-mono transition-all"
                    style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08);"
                    onfocus="this.style.borderColor='rgba(139,92,246,0.6)'" onblur="this.style.borderColor='rgba(255,255,255,0.08)'"
                    maxlength="30" oninput="this.value=this.value.toUpperCase(); clearVoucher()">
                <button onclick="applyVoucher()" id="voucherBtn"
                    class="px-4 py-3 rounded-xl text-xs font-bold transition-all flex-shrink-0"
                    style="background:rgba(234,179,8,.15);border:1px solid rgba(234,179,8,.3);color:#fbbf24;">
                    Pakai
                </button>
            </div>
            <div id="voucherStatus" class="mt-1.5 hidden"></div>
        </div>

        <!-- METODE PEMBAYARAN -->
        <div>
            <label class="text-[10px] font-bold uppercase tracking-[0.15em] text-white/40 mb-1.5 block">METODE PEMBAYARAN</label>
            <div class="grid grid-cols-2 gap-2">
                <button type="button" id="payMethodQris" onclick="selectPaymentMethod('qris')"
                    class="flex items-center justify-center gap-2 py-3 rounded-xl text-xs font-bold transition-all border">
                    <iconify-icon icon="mdi:qrcode-scan" class="text-base"></iconify-icon> QRIS
                </button>
                <button type="button" id="payMethodUsdtManual" onclick="selectPaymentMethod('usdt_manual')"
                    class="flex items-center justify-center gap-2 py-3 rounded-xl text-xs font-bold transition-all border">
                    <iconify-icon icon="ph:coin-fill" class="text-base" style="color:#F0B90B"></iconify-icon> USDT (Binance)
                </button>
                <% if (isReseller) { %>
                <button type="button" id="payMethodBalance" onclick="selectPaymentMethod('balance')"
                    class="flex items-center justify-center gap-2 py-3 rounded-xl text-xs font-bold transition-all border col-span-2">
                    <iconify-icon icon="mdi:wallet" class="text-base"></iconify-icon> Saldo
                </button>
                <% } %>
            </div>
            <p class="text-[10px] text-zinc-600 mt-1.5">USDT (TRC20) via Binance cocok untuk pembayaran dari luar negeri.</p>
            <% if (isReseller) { %>
            <p class="text-[10px] mt-1 flex items-center gap-1" style="color:#fbbf24">
                <iconify-icon icon="mdi:wallet-outline"></iconify-icon> Saldo kamu: Rp <span id="myBalanceLabel"><%= (userBalance||0).toLocaleString('id-ID') %></span>
            </p>
            <% } %>
        </div>


        <!-- ORDER SUMMARY TABLE -->
        <div class="rounded-xl p-4 space-y-2 text-xs" style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.06);">
            <div class="flex justify-between text-white/40">
                <span>Produk</span>
                <span class="text-white font-semibold"><%= product.name %></span>
            </div>
            <div class="flex justify-between text-white/40">
                <span>Durasi</span>
                <span class="text-white font-semibold" id="selectedLabel"><%= product.items?.[0]?.l || '-' %></span>
            </div>
            <div class="flex justify-between text-white/40">
                <span>Stok Durasi</span>
                <span class="text-emerald-400 font-semibold" id="stockLabel">
                    <%= (product.items?.[0]?.stok === Infinity || (product.items?.[0]?.stok || 0) >= 999999) ? 'Tersedia' : ((product.items?.[0]?.stok || 0) + ' tersedia') %>
                </span>
            </div>
            <div id="voucherRow" class="hidden flex justify-between text-white/40">
                <span>Diskon</span>
                <span class="text-emerald-400 font-semibold" id="discountShow">-</span>
            </div>
            <div class="h-px" style="background:rgba(255,255,255,0.06)"></div>
            <div class="flex justify-between items-center">
                <span class="text-white/50 text-sm font-semibold">Total</span>
                <span class="text-2xl font-display font-black text-violet-300" id="totalPrice">
                    Rp <%= ((isReseller && product.items?.[0]?.reseller_price) ? product.items[0].reseller_price : (product.items?.[0]?.p||0)).toLocaleString('id-ID') %>
                </span>
            </div>
            <div id="originalPriceShow" class="hidden text-right text-[10px] text-zinc-500 line-through"></div>
        </div>

        <!-- DOWNLOAD APK BUTTON -->
        <% if (product.downloadLink) { %>
        <a href="<%= product.downloadLink %>"
           target="_blank" rel="noopener"
           class="btn-ghost w-full py-3 rounded-xl text-white/70 text-sm font-medium flex items-center justify-center gap-2">
            <iconify-icon icon="solar:download-minimalistic-bold" class="text-base text-blue-400"></iconify-icon>Download APK
        </a>
        <% } %>

        <!-- KONFIRMASI / ORDER BUTTON -->
        <% if ((product.stock||0) > 0) { %>
            <button id="submitBtn" onclick="handleOrder()"
                class="btn-primary w-full py-4 rounded-2xl text-sm font-black text-white flex items-center justify-center gap-2">
                <iconify-icon icon="solar:bag-check-bold" class="text-lg"></iconify-icon>Konfirmasi
            </button>
            <button onclick="addProductToCart()"
                class="btn-ghost w-full py-3 rounded-xl text-sm font-medium text-white/60 flex items-center justify-center gap-2">
                <iconify-icon icon="solar:cart-plus-bold" class="text-base text-violet-400"></iconify-icon>Simpan ke Keranjang
            </button>
        <% } else { %>
            <button disabled class="w-full py-4 rounded-2xl text-sm font-bold flex items-center justify-center gap-2 cursor-not-allowed"
                style="background:rgba(255,255,255,0.04);color:rgba(255,255,255,0.2);border:1px solid rgba(255,255,255,0.06);">
                <iconify-icon icon="solar:close-circle-bold"></iconify-icon>Stok Habis
            </button>
        <% } %>

        <!-- WA CS + TELEGRAM CS -->
        <div class="flex gap-2">
            <a href="https://wa.me/<%= settings.contact?.whatsapp || '6281234567890' %>" target="_blank" rel="noopener"
               class="flex-1 btn-ghost py-3 rounded-xl text-white/60 text-xs font-medium flex items-center justify-center gap-1.5">
                <iconify-icon icon="solar:chat-round-bold" class="text-sm text-green-400"></iconify-icon>WA CS
            </a>
            <a href="<%= settings.contact?.telegram ? (settings.contact.telegram.startsWith('http') ? settings.contact.telegram : 'https://t.me/' + settings.contact.telegram) : 'https://t.me/' %>"
               target="_blank" rel="noopener"
               class="flex-1 btn-ghost py-3 rounded-xl text-white/60 text-xs font-medium flex items-center justify-center gap-1.5">
                <iconify-icon icon="solar:plain-bold" class="text-sm text-blue-400"></iconify-icon>Telegram CS
            </a>
        </div>
    </div>

    <!-- ── ULASAN & RATING ── -->
    <div class="glass-strong rounded-2xl p-5 fade-in-up">
        <div class="flex items-center justify-between mb-4">
            <h2 class="text-sm font-bold text-white flex items-center gap-2">
                <iconify-icon icon="solar:star-bold" class="text-yellow-400 text-base"></iconify-icon>
                Ulasan & Rating
            </h2>
            <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl" style="background:rgba(234,179,8,.1);border:1px solid rgba(234,179,8,.2);">
                <iconify-icon icon="solar:star-bold" class="text-yellow-400 text-xs"></iconify-icon>
                <span class="text-xs font-black text-yellow-400" id="avgRatingDisplay">—</span>
                <span class="text-[10px] text-white/30" id="reviewCountDisplay"></span>
            </div>
        </div>

        <!-- Rating bars -->
        <div class="space-y-1.5 mb-5">
            <% for(let s=5;s>=1;s--) { %>
            <div class="flex items-center gap-2">
                <span class="text-[10px] text-white/30 w-3"><%= s %></span>
                <iconify-icon icon="solar:star-bold" class="text-yellow-400 text-[10px] flex-shrink-0"></iconify-icon>
                <div class="flex-1 h-1.5 rounded-full overflow-hidden" style="background:rgba(255,255,255,0.06)">
                    <div class="h-full rounded-full bg-gradient-to-r from-yellow-500 to-yellow-400 transition-all duration-700"
                         id="bar-<%= s %>" style="width:0%"></div>
                </div>
                <span class="text-[10px] text-white/25 w-4 text-right" id="rcount-<%= s %>">0</span>
            </div>
            <% } %>
        </div>

        <!-- Review list -->
        <div id="reviewsList">
            <div class="text-center py-6 text-white/20">
                <iconify-icon icon="mdi:loading" class="text-2xl text-violet-400 animate-spin block mx-auto mb-2"></iconify-icon>
                <p class="text-xs">Memuat ulasan...</p>
            </div>
        </div>

        <!-- Write review — hanya tampil kalau sudah beli -->
        <div id="reviewFormWrap">
            <!-- Placeholder sementara cek status -->
            <div id="reviewFormLoading" class="text-center py-4">
                <iconify-icon icon="mdi:loading" class="text-lg text-violet-400 animate-spin block mx-auto mb-1"></iconify-icon>
                <p class="text-[10px] text-white/20">Memuat...</p>
            </div>

            <!-- Form ulasan (muncul kalau sudah beli) -->
            <div id="reviewFormContent" class="hidden">
                <div class="h-px my-4" style="background:linear-gradient(to right,transparent,rgba(139,92,246,0.3),transparent)"></div>
                <h3 class="text-xs font-bold text-white mb-3 flex items-center gap-2">
                    <iconify-icon icon="solar:pen-new-square-bold" class="text-violet-400"></iconify-icon>
                    Tulis Ulasan Kamu
                </h3>
                <div class="flex gap-1 mb-3">
                    <% for(let i=1;i<=5;i++) { %>
                        <button type="button" onclick="setRating(<%= i %>)" id="rstar-<%= i %>"
                            class="text-2xl text-white/15 transition-colors hover:text-yellow-400">
                            <iconify-icon icon="solar:star-bold"></iconify-icon>
                        </button>
                    <% } %>
                </div>
                <textarea id="reviewText"
                    class="w-full px-4 py-3 rounded-xl text-sm text-white placeholder-white/25 outline-none resize-none mb-2 transition-all"
                    style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08);"
                    onfocus="this.style.borderColor='rgba(139,92,246,0.6)'" onblur="this.style.borderColor='rgba(255,255,255,0.08)'"
                    rows="3" placeholder="Bagikan pengalaman kamu dengan produk ini..."></textarea>
                <button onclick="submitReview()"
                    class="btn-ghost w-full py-2.5 rounded-xl text-xs font-bold text-violet-400 flex items-center justify-center gap-2">
                    <iconify-icon icon="solar:plain-bold" class="text-sm"></iconify-icon>Kirim Ulasan
                </button>
            </div>

            <!-- Pesan kalau belum beli -->
            <div id="reviewFormLocked" class="hidden">
                <div class="h-px my-4" style="background:linear-gradient(to right,transparent,rgba(255,255,255,0.06),transparent)"></div>
                <div class="flex items-center gap-3 px-4 py-3 rounded-xl" style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.07);">
                    <iconify-icon icon="solar:lock-bold" class="text-white/20 text-xl flex-shrink-0"></iconify-icon>
                    <p class="text-[11px] text-white/30 leading-relaxed">Kamu perlu membeli produk ini terlebih dahulu untuk bisa memberikan ulasan.</p>
                </div>
            </div>
        </div>
    </div>

</div><!-- max-w -->
</div>

<!-- PAYMENT MODAL -->
<div id="paymentModal" class="inset-0 hidden" style="position:fixed!important;z-index:99999;top:0;left:0;right:0;bottom:0;">
    <div class="absolute inset-0 bg-black/85 backdrop-blur-sm" onclick="closePayment()"></div>
    <div class="absolute inset-0 flex flex-col justify-end pointer-events-none">
        <div class="pointer-events-auto bg-[#0f0f1e] rounded-t-3xl border-t border-x border-indigo-500/25 shadow-2xl w-full"
             style="max-height:95dvh;overflow-y:auto;padding-bottom:calc(20px + env(safe-area-inset-bottom));">
            <!-- top bar gradient -->
            <div class="h-1 w-full rounded-t-3xl" style="background:linear-gradient(90deg,#6366f1,#a78bfa,#f472b6,#6366f1);background-size:200%;animation:shimmer 2s linear infinite;"></div>
            <!-- drag handle -->
            <div class="flex justify-center pt-3 pb-1"><div class="w-10 h-1 rounded-full bg-white/15"></div></div>
            <!-- header -->
            <div class="flex items-center justify-between px-5 py-3 border-b border-white/5">
                <h3 class="text-sm font-bold text-white flex items-center gap-2" id="paymentModalTitle">
                    <iconify-icon icon="mdi:qrcode-scan" class="text-indigo-400"></iconify-icon>
                    Pembayaran QRIS
                </h3>
                <button onclick="closePayment()" class="w-8 h-8 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-zinc-400 hover:text-white transition-colors">
                    <iconify-icon icon="mdi:close"></iconify-icon>
                </button>
            </div>

            <div class="p-5 space-y-4">
                <!-- KEY RESULT (shown after successful payment, replaces QR/payment sections) -->
                <div id="keyResultSection" class="hidden flex-col items-center text-center space-y-4">
                    <div class="w-14 h-14 rounded-full flex items-center justify-center" style="background:rgba(16,185,129,.15);border:1px solid rgba(16,185,129,.35);">
                        <iconify-icon icon="mdi:check-bold" class="text-2xl text-emerald-400"></iconify-icon>
                    </div>
                    <p class="text-sm font-bold text-white">Pembayaran berhasil! Ini key kamu:</p>
                    <div class="w-full p-3 rounded-xl bg-black/30 border border-emerald-500/30">
                        <div class="flex items-center gap-2">
                            <code id="keyResultText" class="text-sm text-emerald-400 font-mono break-all font-black flex-1 text-left">—</code>
                            <button onclick="copyResultKey()"
                                style="flex-shrink:0;padding:6px 10px;border-radius:8px;background:rgba(16,185,129,.15);border:1px solid rgba(16,185,129,.35);color:#34d399;font-size:10px;font-weight:700;cursor:pointer;white-space:nowrap;">
                                <span id="keyResultCopyLabel">📋 Salin</span>
                            </button>
                        </div>
                    </div>
                    <p class="text-[10px] text-zinc-500">Kode pesanan: <span id="keyResultCode" class="font-mono text-zinc-300">—</span>. Simpan key ini baik-baik — kamu juga bisa melihatnya lagi di Dashboard.</p>
                    <button onclick="copyOrderLink()"
                        style="width:100%;padding:8px 10px;border-radius:8px;background:rgba(99,102,241,.12);border:1px solid rgba(99,102,241,.3);color:#a5b4fc;font-size:11px;font-weight:700;cursor:pointer;">
                        <span id="orderLinkCopyLabel">🔗 Salin Link Pesanan (buat dikirim ke pembeli)</span>
                    </button>
                    <button onclick="closePayment()" class="btn-gaming w-full py-3 text-sm font-bold">Selesai</button>
                </div>

                <!-- QR CODE (QRIS) -->
                <div id="paymentFormSection">
                <div id="qrisSection" class="flex flex-col items-center">
                    <div id="qrCodeWrap" class="flex items-center justify-center" style="min-height:80px;">
                        <iconify-icon icon="mdi:loading" class="text-4xl text-indigo-400 animate-spin"></iconify-icon>
                    </div>
                    <p class="text-[10px] text-zinc-500 mt-2">Scan dengan aplikasi mobile banking / e-wallet</p>
                </div>

                <!-- USDT MANUAL (Binance Spot Read-Only) -->
                <div id="usdtManualSection" class="hidden flex flex-col items-center w-full">
                    <div id="usdtManualWrap" class="flex items-center justify-center w-full" style="min-height:80px;">
                        <iconify-icon icon="mdi:loading" class="text-4xl text-indigo-400 animate-spin"></iconify-icon>
                    </div>
                    <div id="usdtManualUnavailable" class="hidden text-center py-4">
                        <iconify-icon icon="mdi:currency-usd-off" class="text-4xl text-zinc-700 block mb-2"></iconify-icon>
                        <p class="text-xs text-zinc-500">Pembayaran USDT belum dikonfigurasi.<br>Hubungi admin.</p>
                    </div>
                </div>

                <!-- INFO BARIS -->
                <div class="grid grid-cols-2 gap-2">
                    <div class="rounded-xl p-3 text-center" style="background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.07)">
                        <div class="text-[10px] text-zinc-500 mb-0.5">Kode Pesanan</div>
                        <div class="text-sm font-mono font-black text-indigo-400 tracking-wider" id="orderCodeShow">—</div>
                    </div>
                    <div class="rounded-xl p-3 text-center" style="background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.07)">
                        <div class="text-[10px] text-zinc-500 mb-0.5">Total Bayar</div>
                        <div class="text-sm font-black text-emerald-400" id="payAmountShow">—</div>
                    </div>
                </div>

                <!-- TIMER -->
                <div id="timerWrap" class="hidden rounded-xl p-3 text-center" style="background:rgba(251,191,36,.06);border:1px solid rgba(251,191,36,.2)">
                    <div class="text-[10px] text-zinc-500 mb-0.5 flex items-center justify-center gap-1">
                        <iconify-icon icon="mdi:clock-outline" class="text-yellow-400 text-xs"></iconify-icon>
                        Batas Waktu Pembayaran
                    </div>
                    <div class="text-xl font-black font-orbitron text-yellow-400" id="timerDisplay">--:--</div>
                </div>

                <!-- STATUS -->
                <div id="payStatusRow" class="flex items-center justify-center gap-2 py-2">
                    <div class="w-2 h-2 rounded-full bg-yellow-400 animate-pulse"></div>
                    <span class="text-xs text-zinc-400">Menunggu pembayaran...</span>
                </div>

                <!-- TOMBOL KONFIRMASI MANUAL (static) -->
                <div id="staticNote" class="hidden text-center rounded-xl p-3" style="background:rgba(99,102,241,.07);border:1px solid rgba(99,102,241,.2)">
                    <p class="text-xs text-indigo-300">Setelah transfer, kirim bukti ke admin via WhatsApp / Telegram</p>
                    <div class="flex gap-2 mt-2 justify-center">
                        <a id="waConfirmBtn" href="#" target="_blank"
                           class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-bold text-white"
                           style="background:rgba(34,197,94,.2);border:1px solid rgba(34,197,94,.35)">
                            <iconify-icon icon="mdi:whatsapp" class="text-green-400 text-sm"></iconify-icon> WhatsApp
                        </a>
                    </div>
                </div>

                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const USDT_MANUAL_CONFIGURED = <%= usdtManualConfigured ? 'true' : 'false' %>;
    let selPkg = { label:'<%= (product.items?.[0]?.l||"") %>', price:<%= (isReseller && product.items?.[0]?.reseller_price) ? product.items[0].reseller_price : (product.items?.[0]?.p||0) %> };
    let myRating = 0;
    let payInterval = null;
    let currentRefId = null;
    let appliedVoucher = null;   // { code, discount, finalPrice }
    let selectedPaymentMethod = 'qris';
    const PID   = '<%= product.id %>';
    const PNAME = '<%= product.name %>';

    let myBalance = <%= isReseller ? (userBalance||0) : 0 %>;

    function selectPaymentMethod(method) {
        selectedPaymentMethod = method;
        document.getElementById('payMethodQris').classList.toggle('active', method === 'qris');
        document.getElementById('payMethodUsdtManual').classList.toggle('active', method === 'usdt_manual');
        const balBtn = document.getElementById('payMethodBalance');
        if (balBtn) balBtn.classList.toggle('active', method === 'balance');
    }
    // Default: QRIS aktif saat halaman dibuka
    document.addEventListener('DOMContentLoaded', () => selectPaymentMethod('qris'));

    function selectPkg(label, price, stock) {
        selPkg = { label, price, stock };
        document.getElementById('selectedLabel').textContent = label;
        const stockEl = document.getElementById('stockLabel');
        if (stockEl) {
            stockEl.textContent = (stock > 0 ? stock + ' tersedia' : 'Habis');
            stockEl.className = stock > 0 ? 'text-emerald-400 font-semibold' : 'text-red-400 font-semibold';
        }
        clearVoucher();
        updateTotalDisplay(price);
    }

    function updateTotalDisplay(basePrice) {
        const origEl    = document.getElementById('originalPriceShow');
        const priceEl   = document.getElementById('totalPrice');
        const vRow      = document.getElementById('voucherRow');
        const discShow  = document.getElementById('discountShow');
        if (appliedVoucher) {
            const fp = Math.max(basePrice - appliedVoucher.discount, 0);
            origEl.textContent = 'Rp ' + basePrice.toLocaleString('id-ID');
            origEl.classList.remove('hidden');
            priceEl.textContent = 'Rp ' + fp.toLocaleString('id-ID');
            if (vRow) { vRow.classList.remove('hidden'); vRow.classList.add('flex'); }
            if (discShow) discShow.textContent = '- Rp ' + appliedVoucher.discount.toLocaleString('id-ID');
        } else {
            origEl.classList.add('hidden');
            priceEl.textContent = 'Rp ' + basePrice.toLocaleString('id-ID');
            if (vRow) { vRow.classList.add('hidden'); vRow.classList.remove('flex'); }
        }
    }

    async function applyVoucher() {
        const code = document.getElementById('voucherInput').value.trim();
        const statusEl = document.getElementById('voucherStatus');
        if (!code) { showToast('Masukkan kode voucher', 'error'); return; }
        const btn = document.getElementById('voucherBtn');
        btn.disabled = true;
        btn.textContent = '...';
        try {
            const res = await fetch('/api/voucher/check', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ code, price: selPkg.price })
            });
            const d = await res.json();
            if (d.valid) {
                appliedVoucher = { code: d.code, discount: d.discount, finalPrice: d.finalPrice };
                statusEl.innerHTML = `<div class="flex items-center gap-2 text-xs text-emerald-400"><iconify-icon icon="mdi:check-circle" class="text-sm"></iconify-icon> Voucher <strong>${d.code}</strong> berhasil! Hemat Rp ${d.discount.toLocaleString('id-ID')}</div>`;
                statusEl.classList.remove('hidden');
                updateTotalDisplay(selPkg.price);
                showToast('Voucher berhasil dipakai!', 'success');
            } else {
                appliedVoucher = null;
                statusEl.innerHTML = `<div class="flex items-center gap-2 text-xs text-red-400"><iconify-icon icon="mdi:alert-circle" class="text-sm"></iconify-icon> ${d.error}</div>`;
                statusEl.classList.remove('hidden');
                updateTotalDisplay(selPkg.price);
            }
        } catch(e) { showToast('Gagal memeriksa voucher', 'error'); }
        finally { btn.disabled = false; btn.textContent = 'Pakai'; }
    }

    function clearVoucher() {
        appliedVoucher = null;
        const statusEl = document.getElementById('voucherStatus');
        statusEl.classList.add('hidden');
        updateTotalDisplay(selPkg.price);
    }

    function addProductToCart() {
        if (!selPkg.price) { showToast('Pilih paket dulu!','error'); return; }
        addToCart({ productId:PID, name:PNAME, duration:selPkg.label, price:selPkg.price, image:'<%= product.image||"" %>' });
    }

    async function handleOrder() {
        const email = document.getElementById('customerName').value.trim();
        const wa    = document.getElementById('waInput').value.trim().replace(/[\s\-()]/g,'');
        if (!wa)    { showToast('Masukkan nomor WhatsApp!','error'); document.getElementById('waInput').focus(); return; }
        if (!/^(\+62|62|0)[0-9]{8,13}$/.test(wa)) { showToast('Format WhatsApp tidak valid!','error'); return; }
        if (!email) { showToast('Masukkan email!','error'); document.getElementById('customerName').focus(); return; }
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { showToast('Format email tidak valid!','error'); return; }
        const name = email;

        if (selectedPaymentMethod === 'balance' && (!selPkg.price || selPkg.price > myBalance)) {
            showToast('Saldo tidak cukup untuk paket ini','error');
            return;
        }

        const btn = document.getElementById('submitBtn');
        btn.disabled = true;
        btn.innerHTML = '<iconify-icon icon="mdi:loading" class="text-lg animate-spin"></iconify-icon> Memproses...';

        try {
            const res  = await fetch('/create-order',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({
                productId: PID,
                duration: selPkg.label,
                customerName: name,
                wa,
                voucherCode: appliedVoucher ? appliedVoucher.code : undefined,
                paymentMethod: selectedPaymentMethod
            })});
            const data = await res.json();
            if (data.success && data.paidWithBalance) {
                myBalance = data.balance;
                const lbl = document.getElementById('myBalanceLabel');
                if (lbl) lbl.textContent = myBalance.toLocaleString('id-ID');
                showPaymentModal(data);
                handlePaymentSuccess(data);
            } else if (data.success) {
                showPaymentModal(data);
                showToast('Pesanan dibuat! Segera bayar via QRIS','success');
            } else if (data.redirect) {
                showToast('Silakan login terlebih dahulu','error');
                setTimeout(() => window.location.href = data.redirect, 1000);
            } else {
                showToast(data.message||'Gagal membuat pesanan','error');
            }
        } catch(e) { showToast('Koneksi error: ' + e.message,'error'); }
        finally {
            btn.disabled = false;
            btn.innerHTML = '<iconify-icon icon="solar:bag-check-bold" class="text-lg"></iconify-icon> Konfirmasi';
        }
    }

    function showPaymentModal(data) {
        const { qrString, orderCode, refId, isStatic, qrisStaticImage, totalPayment, expiredAt } = data;
        currentRefId = refId;

        // Tampilkan modal
        document.getElementById('paymentModal').classList.remove('hidden');
        document.body.style.overflow = 'hidden';

        // Reset tampilan (jaga-jaga modal dibuka ulang setelah sukses sebelumnya)
        document.getElementById('paymentFormSection').classList.remove('hidden');
        const keySection = document.getElementById('keyResultSection');
        keySection.classList.add('hidden');
        keySection.classList.remove('flex');

        // Isi info
        document.getElementById('orderCodeShow').textContent = orderCode || '—';
        document.getElementById('payAmountShow').textContent = totalPayment
            ? 'Rp ' + Number(totalPayment).toLocaleString('id-ID') : '—';

        // Reset status
        document.getElementById('payStatusRow').innerHTML =
            '<div class="w-2 h-2 rounded-full bg-yellow-400 animate-pulse"></div>' +
            '<span class="text-xs text-zinc-400">Menunggu pembayaran...</span>';

        // Reset semua section metode pembayaran ke hidden dulu -- supaya kalau
        // modal ini sebelumnya dipakai buat metode lain, section lama itu
        // tidak nyangkut kelihatan di belakang section yang baru aktif.
        document.getElementById('qrisSection').classList.add('hidden');
        document.getElementById('usdtManualSection').classList.add('hidden');

        if (selectedPaymentMethod === 'usdt_manual') {
            showUsdtManualSection(refId, totalPayment);
            return;
        }

        if (data.paidWithBalance) {
            document.getElementById('qrisSection').classList.remove('hidden');
            document.getElementById('paymentModalTitle').innerHTML = '<iconify-icon icon="mdi:wallet" class="text-yellow-400"></iconify-icon> Bayar via Saldo';
            document.getElementById('qrCodeWrap').innerHTML = `
                <div class="text-center py-4">
                    <iconify-icon icon="mdi:wallet-outline" class="text-5xl text-yellow-400 block mb-2"></iconify-icon>
                    <p class="text-xs text-zinc-400">Memproses pembayaran dari saldo...</p>
                </div>`;
            return;
        }

        // --- QR Code (QRIS) ---
        document.getElementById('qrisSection').classList.remove('hidden');
        document.getElementById('paymentModalTitle').innerHTML = '<iconify-icon icon="mdi:qrcode-scan" class="text-indigo-400"></iconify-icon> Pembayaran QRIS';
        const wrap = document.getElementById('qrCodeWrap');

        if (isStatic && qrisStaticImage) {
            // QRIS static dari admin
            wrap.innerHTML = `
                <div style="background:#fff;padding:12px;border-radius:16px;display:inline-block;">
                    <img src="${qrisStaticImage}" style="display:block;width:210px;height:210px;object-fit:contain;border-radius:6px;"
                         onerror="this.style.display='none';this.parentNode.innerHTML='<p style=color:#666;font-size:11px;padding:20px>Gambar QRIS tidak ditemukan</p>'">
                </div>`;
            document.getElementById('staticNote').classList.remove('hidden');
            const waNum = '<%= settings.contact?.whatsapp || "6281235690535" %>';
            document.getElementById('waConfirmBtn').href =
                `https://wa.me/${waNum}?text=${encodeURIComponent('Konfirmasi pembayaran kode: ' + orderCode)}`;
        } else if (qrString) {
            // QRIS dari PakKasir API — render pakai img dari qrserver.com (putih bersih)
            wrap.innerHTML = `
                <div style="background:#fff;padding:12px;border-radius:16px;display:inline-block;">
                    <img id="qrImg"
                         src="https://api.qrserver.com/v1/create-qr-code/?size=210x210&color=000000&bgcolor=ffffff&qzone=1&data=${encodeURIComponent(qrString)}"
                         style="display:block;width:210px;height:210px;border-radius:4px;"
                         onerror="qrFallback('${encodeURIComponent(qrString)}')">
                </div>`;
        } else {
            wrap.innerHTML = `
                <div class="text-center py-4">
                    <iconify-icon icon="mdi:qrcode-remove" class="text-5xl text-zinc-700 block mb-2"></iconify-icon>
                    <p class="text-xs text-zinc-500">QRIS belum dikonfigurasi.<br>Hubungi admin.</p>
                </div>`;
        }

        // --- Timer countdown ---
        if (expiredAt) {
            document.getElementById('timerWrap').classList.remove('hidden');
            startTimer(expiredAt);
        }

        // --- Auto polling status ---
        // FIX (anti-spam GensPay, pemberitahuan resmi Agustus 2026): dulu
        // 4000ms. Dinaikkan ke 6000ms sebagai lapisan pertahanan tambahan
        // di atas cache 3 detik di server (checkPaymentStatusCached) --
        // dua-duanya sama-sama menjaga supaya total request AKTUAL ke
        // GensPay tetap jauh di bawah ambang batas mereka, bahkan kalau
        // banyak pembeli checkout bersamaan.
        if (refId && !isStatic) {
            payInterval = setInterval(() => checkPay(refId), 6000);
        }
    }

    // ── USDT Manual (Binance Spot Read-Only): tampilkan wallet statis + nominal unik ──
    let usdtManualInterval = null;
    async function showUsdtManualSection(refId, totalPaymentIdr) {
        document.getElementById('usdtManualSection').classList.remove('hidden');
        document.getElementById('paymentModalTitle').innerHTML = '<iconify-icon icon="ph:coin-fill" style="color:#F0B90B"></iconify-icon> Pembayaran USDT (TRC20)';
        document.getElementById('timerWrap').classList.add('hidden');

        const wrap = document.getElementById('usdtManualWrap');
        wrap.innerHTML = '<iconify-icon icon="mdi:loading" class="text-3xl text-indigo-400 animate-spin"></iconify-icon>';

        if (!USDT_MANUAL_CONFIGURED) {
            wrap.innerHTML = '';
            document.getElementById('usdtManualUnavailable').classList.remove('hidden');
            return;
        }
        document.getElementById('usdtManualUnavailable').classList.add('hidden');

        if (usdtManualInterval) { clearInterval(usdtManualInterval); usdtManualInterval = null; }

        try {
            const res = await fetch('/binance-spot/create-payment', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ refId })
            });
            const data = await res.json();
            if (!data.success) {
                wrap.innerHTML = `<p class="text-xs text-red-400 text-center py-4">${data.message || 'Gagal menyiapkan pembayaran USDT'}</p>`;
                return;
            }

            document.getElementById('payAmountShow').textContent = data.uniqueAmount + ' ' + (data.coin || 'USDT');

            wrap.innerHTML = `
                <div class="w-full flex flex-col items-center gap-3">
                    ${data.qrCodeUrl ? `
                    <div style="background:#fff;padding:12px;border-radius:16px;display:inline-block;">
                        <img src="${data.qrCodeUrl}" style="display:block;width:190px;height:190px;object-fit:contain;border-radius:4px;">
                    </div>
                    <p class="text-[10px] text-zinc-500 text-center">Scan pakai app wallet crypto kamu (Trust Wallet, Binance App, dll) — alamat & jumlah otomatis terisi, tinggal konfirmasi kirim.</p>
                    ` : ''}
                    <div class="w-full space-y-2">
                        <p class="text-[10px] text-zinc-600 text-center">Atau kirim manual ke alamat ini (jaringan ${data.network || 'TRC20'}):</p>
                        <div class="flex items-center gap-2 bg-black/30 rounded-xl p-2.5">
                            <code id="usdtManualAddress" class="text-[11px] text-emerald-400 font-mono break-all flex-1">${data.walletAddress || '—'}</code>
                            <button type="button" onclick="copyUsdtManualAddress()" style="flex-shrink:0;padding:6px 10px;border-radius:8px;background:rgba(16,185,129,.15);border:1px solid rgba(16,185,129,.35);color:#34d399;font-size:10px;font-weight:700;cursor:pointer;">
                                <span id="usdtManualCopyLabel">📋 Salin</span>
                            </button>
                        </div>
                        <p class="text-center text-lg font-bold text-emerald-400">${data.uniqueAmount} ${data.coin || 'USDT'}</p>
                        <p class="text-[10px] text-amber-400 text-center font-semibold">⚠️ Wajib transfer PERSIS sampai 3 digit desimal terakhir, atau sistem tidak bisa mendeteksi pembayaranmu secara otomatis.</p>
                        <p class="text-[10px] text-zinc-600 text-center">Verifikasi otomatis berjalan setiap beberapa detik. Deposit baru terdeteksi 1-5 menit setelah transfer terkonfirmasi di blockchain.</p>
                    </div>
                </div>`;

            if (refId) {
                usdtManualInterval = setInterval(() => checkPay(refId), 8000);
            }
        } catch (e) {
            wrap.innerHTML = `<p class="text-xs text-red-400 text-center py-4">Gagal memuat pembayaran USDT: ${e.message}</p>`;
        }
    }

    function copyUsdtManualAddress() {
        const addr = document.getElementById('usdtManualAddress')?.textContent;
        if (!addr) return;
        navigator.clipboard.writeText(addr).then(() => {
            const lbl = document.getElementById('usdtManualCopyLabel');
            if (lbl) { lbl.textContent = '✅ Tersalin'; setTimeout(() => lbl.textContent = '📋 Salin', 1500); }
        });
    }

    // Fallback QR jika qrserver.com gagal
    window.qrFallback = function(encoded) {
        const wrap = document.getElementById('qrCodeWrap');
        wrap.innerHTML = `
            <div style="background:#fff;padding:12px;border-radius:16px;display:inline-block;">
                <img src="https://quickchart.io/qr?text=${encoded}&size=210&margin=1&ecLevel=M"
                     style="display:block;width:210px;height:210px;border-radius:4px;"
                     onerror="this.parentNode.parentNode.innerHTML='<p style=color:#999;font-size:11px;padding:16px>Gagal load QR. Cek koneksi internet.</p>'">
            </div>`;
    };

    let timerInterval = null;
    function startTimer(expiredAt) {
        const el = document.getElementById('timerDisplay');
        const end = new Date(expiredAt).getTime();
        if (timerInterval) clearInterval(timerInterval);
        timerInterval = setInterval(() => {
            const diff = end - Date.now();
            if (diff <= 0) {
                clearInterval(timerInterval);
                el.textContent = '00:00';
                el.style.color = '#f87171';
                document.getElementById('payStatusRow').innerHTML =
                    '<iconify-icon icon="mdi:clock-alert" class="text-red-400"></iconify-icon>' +
                    '<span class="text-xs text-red-400">Waktu pembayaran habis</span>';
                return;
            }
            const m = Math.floor(diff / 60000);
            const s = Math.floor((diff % 60000) / 1000);
            el.textContent = String(m).padStart(2,'0') + ':' + String(s).padStart(2,'0');
            // Warna merah kalau < 2 menit
            el.style.color = diff < 120000 ? '#f87171' : '#fbbf24';
        }, 1000);
    }

    function handlePaymentSuccess(d) {
        clearInterval(payInterval);
        clearInterval(usdtManualInterval);
        clearInterval(timerInterval);
        document.getElementById('payStatusRow').innerHTML =
            '<iconify-icon icon="mdi:check-circle" class="text-emerald-400 text-xl"></iconify-icon>' +
            '<span class="text-sm font-bold text-emerald-400">Pembayaran berhasil!</span>';
        showToast('Pembayaran berhasil! Key sudah dikirim!','success');
        setTimeout(() => {
            document.getElementById('paymentFormSection').classList.add('hidden');
            const keySection = document.getElementById('keyResultSection');
            keySection.classList.remove('hidden');
            keySection.classList.add('flex');
            document.getElementById('keyResultText').textContent = d.key ? (d.key + (d.selectedDays ? ' — ' + d.selectedDays + ' Hari' : '')) : 'Hubungi admin untuk key kamu';
            document.getElementById('keyResultCode').textContent = d.code || '—';
        }, 1200);
    }
    function copyResultKey() {
        const el = document.getElementById('keyResultText');
        const label = document.getElementById('keyResultCopyLabel');
        const text = el.textContent.trim();
        const done = () => { label.textContent = '✓ Tersalin!'; setTimeout(() => { label.textContent = '📋 Salin'; }, 2000); };
        if (navigator.clipboard) {
            navigator.clipboard.writeText(text).then(done).catch(() => {
                const ta = document.createElement('textarea');
                ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
                document.body.appendChild(ta); ta.select();
                try { document.execCommand('copy'); done(); } catch(e) {}
                document.body.removeChild(ta);
            });
        }
    }

    function copyOrderLink() {
        const code = document.getElementById('keyResultCode').textContent.trim();
        const label = document.getElementById('orderLinkCopyLabel');
        if (!code || code === '—') return;
        // Link publik /order/:code -- tidak perlu login, jadi aman dikirim
        // ke pembeli via WA/Telegram dan preview link-nya tidak kosong.
        const url = window.location.origin + '/order/' + encodeURIComponent(code);
        const done = () => { label.textContent = '✓ Link tersalin!'; setTimeout(() => { label.textContent = '🔗 Salin Link Pesanan (buat dikirim ke pembeli)'; }, 2000); };
        if (navigator.clipboard) {
            navigator.clipboard.writeText(url).then(done).catch(() => {
                const ta = document.createElement('textarea');
                ta.value = url; ta.style.position = 'fixed'; ta.style.opacity = '0';
                document.body.appendChild(ta); ta.select();
                try { document.execCommand('copy'); done(); } catch(e) {}
                document.body.removeChild(ta);
            });
        }
    }

    async function checkPay(refId) {
        try {
            const r = await fetch(`/check-payment/${refId}`);
            const d = await r.json();
            if (d.success && d.status === 'done') {
                handlePaymentSuccess(d);
            } else if (d.status === 'expired') {
                clearInterval(payInterval);
                clearInterval(usdtManualInterval);
                document.getElementById('payStatusRow').innerHTML =
                    '<iconify-icon icon="mdi:clock-alert" class="text-red-400"></iconify-icon>' +
                    '<span class="text-xs text-red-400">Pembayaran expired</span>';
            }
        } catch(e) {}
    }

    function closePayment() {
        if (payInterval) { clearInterval(payInterval); payInterval = null; }
        if (usdtManualInterval) { clearInterval(usdtManualInterval); usdtManualInterval = null; }
        if (timerInterval) { clearInterval(timerInterval); timerInterval = null; }
        document.getElementById('paymentModal').classList.add('hidden');
        document.getElementById('timerWrap').classList.add('hidden');
        document.getElementById('staticNote').classList.add('hidden');
        document.body.style.overflow = '';
    }

    function setRating(val) {
        myRating = val;
        for (let i=1;i<=5;i++) {
            const el = document.getElementById(`rstar-${i}`);
            if (el) el.style.color = i <= val ? '#fbbf24' : 'rgba(255,255,255,0.15)';
        }
    }

    async function submitReview() {
        if (!myRating) { showToast('Pilih rating bintang dulu!','error'); return; }
        const text = document.getElementById('reviewText').value.trim();
        if (!text) { showToast('Tulis ulasan terlebih dahulu!','error'); return; }
        try {
            const res = await fetch('/api/testimonials', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ productId: PID, productName: PNAME, rating: myRating, text })
            });
            const data = await res.json();
            if (data.success) {
                showToast('Ulasan berhasil dikirim! ','success');
                document.getElementById('reviewText').value = '';
                setRating(0);
                loadReviews();
            } else {
                showToast(data.message || 'Gagal mengirim ulasan','error');
            }
        } catch(e) {
            showToast('Koneksi error','error');
        }
    }

    async function loadReviews() {
        const el = document.getElementById('reviewsList');
        try {
            const res = await fetch(`/api/testimonials?product=${encodeURIComponent(PID)}`);
            let reviews = await res.json();

            const total = reviews.length;
            const avg   = total ? (reviews.reduce((s,r)=>s+r.rating,0)/total).toFixed(1) : '—';
            document.getElementById('avgRatingDisplay').textContent = avg;
            document.getElementById('reviewCountDisplay').textContent = total ? `(${total})` : '';

            for (let s=1;s<=5;s++) {
                const cnt = reviews.filter(r=>r.rating===s).length;
                const pct = total ? (cnt/total*100).toFixed(0) : 0;
                const b = document.getElementById(`bar-${s}`);
                const c = document.getElementById(`rcount-${s}`);
                if (b) setTimeout(()=>b.style.width=pct+'%', 200);
                if (c) c.textContent = cnt||'';
            }

            if (!total) {
                el.innerHTML = `<div class="text-center py-8"><iconify-icon icon="mdi:comment-outline" class="text-4xl text-zinc-700 mb-2 block mx-auto"></iconify-icon><p class="text-xs text-zinc-600">Belum ada ulasan. Jadilah yang pertama!</p></div>`;
                return;
            }

            const avatarGrads = ['from-violet-500 to-purple-600','from-blue-500 to-cyan-500','from-red-500 to-orange-500','from-green-500 to-emerald-500','from-pink-500 to-fuchsia-500'];
            el.innerHTML = reviews.slice(0,8).map((r,i) => {
                const date  = new Date(r.date).toLocaleDateString('id-ID',{day:'numeric',month:'short',year:'numeric'});
                const name  = r.name||r.username||'Anonymous';
                const starsHtml = Array.from({length:5},(_,si) =>
                    `<iconify-icon icon="solar:star-bold" style="font-size:10px;color:${si<r.rating?'#fbbf24':'rgba(255,255,255,0.1)'};"></iconify-icon>`
                ).join('');
                return `<div class="glass rounded-xl p-3 mb-2 hover:border-violet-500/20 transition-colors count-up">
                    <div class="flex items-start justify-between gap-2 mb-2">
                        <div class="flex items-center gap-2">
                            <div class="w-8 h-8 rounded-xl bg-gradient-to-br ${avatarGrads[i%5]} flex items-center justify-center text-white text-xs font-bold flex-shrink-0">${name.charAt(0).toUpperCase()}</div>
                            <div>
                                <div class="text-xs font-semibold text-white leading-tight">${name}</div>
                                <div class="flex items-center gap-0.5 mt-0.5">${starsHtml}${r.verified ? '<iconify-icon icon="solar:verified-check-bold" style="font-size:10px;color:#34d399;margin-left:3px;"></iconify-icon>' : ''}</div>
                            </div>
                        </div>
                        <span class="text-[9px] text-white/25 flex-shrink-0">${date}</span>
                    </div>
                    <p class="text-[11px] text-white/50 leading-relaxed">"${r.text}"</p>
                </div>`;
            }).join('')
            + (reviews.length>8 ? `<button onclick="loadAllReviews()" class="btn-ghost w-full py-2.5 rounded-xl text-xs text-white/40 flex items-center justify-center gap-1 mt-1">Lihat semua ${reviews.length} ulasan <iconify-icon icon="solar:alt-arrow-down-linear" style="font-size:12px;"></iconify-icon></button>` : '');
        } catch(e) {
            el.innerHTML = '<div class="text-center py-6 text-xs text-zinc-600">Gagal memuat ulasan</div>';
        }
    }

    async function loadAllReviews() {
        const res = await fetch(`/api/testimonials?product=${encodeURIComponent(PID)}`);
        let reviews = await res.json();
        const el = document.getElementById('reviewsList');
        const avatarGrads2 = ['from-violet-500 to-purple-600','from-blue-500 to-cyan-500','from-red-500 to-orange-500','from-green-500 to-emerald-500','from-pink-500 to-fuchsia-500'];
        el.innerHTML = reviews.map((r,i) => {
            const date  = new Date(r.date).toLocaleDateString('id-ID',{day:'numeric',month:'short',year:'numeric'});
            const name  = r.name||r.username||'Anonymous';
            const starsHtml = Array.from({length:5},(_,si) =>
                `<iconify-icon icon="solar:star-bold" style="font-size:10px;color:${si<r.rating?'#fbbf24':'rgba(255,255,255,0.1)'};"></iconify-icon>`
            ).join('');
            return `<div class="glass rounded-xl p-3 mb-2 hover:border-violet-500/20 transition-colors count-up">
                <div class="flex items-start justify-between gap-2 mb-2">
                    <div class="flex items-center gap-2">
                        <div class="w-8 h-8 rounded-xl bg-gradient-to-br ${avatarGrads2[i%5]} flex items-center justify-center text-white text-xs font-bold flex-shrink-0">${name.charAt(0).toUpperCase()}</div>
                        <div>
                            <div class="text-xs font-semibold text-white leading-tight">${name}</div>
                            <div class="flex items-center gap-0.5 mt-0.5">${starsHtml}${r.verified ? '<iconify-icon icon="solar:verified-check-bold" style="font-size:10px;color:#34d399;margin-left:3px;"></iconify-icon>' : ''}</div>
                        </div>
                    </div>
                    <span class="text-[9px] text-white/25 flex-shrink-0">${date}</span>
                </div>
                <p class="text-[11px] text-white/50 leading-relaxed">"${r.text}"</p>
            </div>`;
        }).join('');
    }

    async function checkPurchaseStatus() {
        const loading = document.getElementById('reviewFormLoading');
        const content = document.getElementById('reviewFormContent');
        const locked  = document.getElementById('reviewFormLocked');
        try {
            const res = await fetch(`/api/has-purchased/${encodeURIComponent(PID)}`);
            const data = await res.json();
            if (loading) loading.classList.add('hidden');
            if (data.hasPurchased) {
                if (content) content.classList.remove('hidden');
            } else {
                if (locked) locked.classList.remove('hidden');
            }
        } catch(e) {
            // Kalau tidak login / error, tampilkan pesan terkunci
            if (loading) loading.classList.add('hidden');
            if (locked) locked.classList.remove('hidden');
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        loadReviews();
        checkPurchaseStatus();
    });
</script>
